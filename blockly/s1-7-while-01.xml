<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_t">t</variable>
    <variable id="var_step">step</variable>
    <variable id="var_sum">sum</variable>
    <variable id="var_count">count</variable>
  </variables>
  <block type="variables_set" id="init_t" x="20" y="20">
    <field name="VAR" id="var_t">t</field>
    <value name="VALUE">
      <block type="text_prompt_ext" id="prompt_t">
        <mutation type="NUMBER"></mutation>
        <field name="TYPE">NUMBER</field>
      </block>
    </value>
    <next>
      <block type="variables_set" id="init_step">
        <field name="VAR" id="var_step">step</field>
        <value name="VALUE">
          <block type="text_prompt_ext" id="prompt_step">
            <mutation type="NUMBER"></mutation>
            <field name="TYPE">NUMBER</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="init_sum">
            <field name="VAR" id="var_sum">sum</field>
            <value name="VALUE">
              <block type="math_number" id="num0_1"><field name="NUM">0</field></block>
            </value>
            <next>
              <block type="variables_set" id="init_count">
                <field name="VAR" id="var_count">count</field>
                <value name="VALUE">
                  <block type="math_number" id="num0_2"><field name="NUM">0</field></block>
                </value>
                <next>
                  <block type="controls_whileUntil" id="loop_thresh">
                    <field name="MODE">WHILE</field>
                    <value name="BOOL">
                      <block type="logic_compare" id="cmp_sum">
                        <field name="OP">LTE</field>
                        <value name="A">
                          <block type="variables_get" id="gsum"><field name="VAR" id="var_sum">sum</field></block>
                        </value>
                        <value name="B">
                          <block type="variables_get" id="gt"><field name="VAR" id="var_t">t</field></block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO">
                      <block type="math_change" id="add_step">
                        <field name="VAR" id="var_sum">sum</field>
                        <value name="DELTA">
                          <block type="variables_get" id="gstep"><field name="VAR" id="var_step">step</field></block>
                        </value>
                        <next>
                          <block type="math_change" id="inc_cnt">
                            <field name="VAR" id="var_count">count</field>
                            <value name="DELTA">
                              <shadow type="math_number" id="num1"><field name="NUM">1</field></shadow>
                            </value>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <block type="text_print" id="print">
                        <value name="TEXT">
                          <block type="variables_get" id="gcnt"><field name="VAR" id="var_count">count</field></block>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>