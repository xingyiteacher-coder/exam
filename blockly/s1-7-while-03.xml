<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_n">N</variable>
    <variable id="var_ans">ans</variable>
  </variables>
  <block type="variables_set" id="init_n" x="20" y="20">
    <field name="VAR" id="var_n">N</field>
    <value name="VALUE">
      <block type="text_prompt_ext" id="prompt_n">
        <mutation type="NUMBER"></mutation>
        <field name="TYPE">NUMBER</field>
      </block>
    </value>
    <next>
      <block type="variables_set" id="init_ans">
        <field name="VAR" id="var_ans">ans</field>
        <value name="VALUE">
          <block type="math_number" id="num1"><field name="NUM">1</field></block>
        </value>
        <next>
          <block type="controls_whileUntil" id="loop_sqr">
            <field name="MODE">WHILE</field>
            <value name="BOOL">
              <block type="logic_compare" id="cmp_sqr">
                <field name="OP">LTE</field>
                <value name="A">
                  <block type="math_arithmetic" id="sqr">
                    <field name="OP">MULTIPLY</field>
                    <value name="A">
                      <block type="variables_get" id="ga1"><field name="VAR" id="var_ans">ans</field></block>
                    </value>
                    <value name="B">
                      <block type="variables_get" id="ga2"><field name="VAR" id="var_ans">ans</field></block>
                    </value>
                  </block>
                </value>
                <value name="B">
                  <block type="variables_get" id="gn1"><field name="VAR" id="var_n">N</field></block>
                </value>
              </block>
            </value>
            <statement name="DO">
              <block type="math_change" id="inc_ans">
                <field name="VAR" id="var_ans">ans</field>
                <value name="DELTA">
                  <shadow type="math_number" id="step1"><field name="NUM">1</field></shadow>
                </value>
              </block>
            </statement>
            <next>
              <block type="text_print" id="print">
                <value name="TEXT">
                  <block type="variables_get" id="ga3"><field name="VAR" id="var_ans">ans</field></block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>