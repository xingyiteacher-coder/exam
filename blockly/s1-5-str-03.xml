<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_s">s</variable>
    <variable id="var_n">n</variable>
    <variable id="var_res">result</variable>
    <variable id="var_i">i</variable>
  </variables>
  <block type="variables_set" id="init_s" x="20" y="20">
    <field name="VAR" id="var_s">s</field>
    <value name="VALUE">
      <block type="text_prompt_ext" id="prompt_s">
        <mutation type="TEXT"></mutation>
        <field name="TYPE">TEXT</field>
      </block>
    </value>
    <next>
      <block type="variables_set" id="init_n">
        <field name="VAR" id="var_n">n</field>
        <value name="VALUE">
          <block type="text_prompt_ext" id="prompt_n">
            <mutation type="NUMBER"></mutation>
            <field name="TYPE">NUMBER</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="init_res">
            <field name="VAR" id="var_res">result</field>
            <value name="VALUE">
              <shadow type="text" id="empty_str"><field name="TEXT"></field></shadow>
            </value>
            <next>
              <block type="controls_for" id="loop_repeat">
                <field name="VAR" id="var_i">i</field>
                <value name="FROM">
                  <shadow type="math_number" id="num1"><field name="NUM">1</field></shadow>
                </value>
                <value name="TO">
                  <block type="variables_get" id="gn"><field name="VAR" id="var_n">n</field></block>
                </value>
                <value name="BY">
                  <shadow type="math_number" id="step1"><field name="NUM">1</field></shadow>
                </value>
                <statement name="DO">
                  <block type="variables_set" id="append_s">
                    <field name="VAR" id="var_res">result</field>
                    <value name="VALUE">
                      <block type="text_join" id="join">
                        <mutation items="2"></mutation>
                        <value name="ADD0">
                          <block type="variables_get" id="gres"><field name="VAR" id="var_res">result</field></block>
                        </value>
                        <value name="ADD1">
                          <block type="variables_get" id="gs"><field name="VAR" id="var_s">s</field></block>
                        </value>
                      </block>
                    </value>
                  </block>
                </statement>
                <next>
                  <block type="text_print" id="print">
                    <value name="TEXT">
                      <block type="variables_get" id="print_res"><field name="VAR" id="var_res">result</field></block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>