<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_s">s</variable>
    <variable id="var_a">a</variable>
    <variable id="var_b">b</variable>
  </variables>
  <block type="variables_set" id="init_s" x="20" y="20">
    <field name="VAR" id="var_s">s</field>
    <value name="VALUE">
      <block type="text_prompt_ext" id="prompt_s">
        <mutation type="TEXT"></mutation>
        <field name="TYPE">TEXT</field>
      </block>
    </value>
    <next>
      <block type="variables_set" id="init_a">
        <field name="VAR" id="var_a">a</field>
        <value name="VALUE">
          <block type="text_prompt_ext" id="prompt_a">
            <mutation type="NUMBER"></mutation>
            <field name="TYPE">NUMBER</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="init_b">
            <field name="VAR" id="var_b">b</field>
            <value name="VALUE">
              <block type="text_prompt_ext" id="prompt_b">
                <mutation type="NUMBER"></mutation>
                <field name="TYPE">NUMBER</field>
              </block>
            </value>
            <next>
              <block type="controls_if" id="check_empty">
                <mutation else="1"></mutation>
                <value name="IF0">
                  <block type="logic_compare" id="cmp_eq">
                    <field name="OP">EQ</field>
                    <value name="A">
                      <block type="variables_get" id="ga1"><field name="VAR" id="var_a">a</field></block>
                    </value>
                    <value name="B">
                      <block type="variables_get" id="gb1"><field name="VAR" id="var_b">b</field></block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="text_print" id="print_empty">
                    <value name="TEXT">
                      <block type="text" id="str_empty"><field name="TEXT"></field></block>
                    </value>
                  </block>
                </statement>
                <statement name="ELSE">
                  <block type="text_print" id="print_sub">
                    <value name="TEXT">
                      <block type="text_getSubstring" id="sub">
                        <mutation at1="true" at2="true" is_player="false"></mutation>
                        <field name="WHERE1">FROM_START</field>
                        <field name="WHERE2">FROM_START</field>
                        <value name="STRING">
                          <block type="variables_get" id="gs1"><field name="VAR" id="var_s">s</field></block>
                        </value>
                        <value name="AT1">
                          <block type="math_arithmetic" id="a_plus1">
                            <field name="OP">ADD</field>
                            <value name="A">
                              <block type="variables_get" id="ga2"><field name="VAR" id="var_a">a</field></block>
                            </value>
                            <value name="B">
                              <shadow type="math_number" id="num1"><field name="NUM">1</field></shadow>
                            </value>
                          </block>
                        </value>
                        <value name="AT2">
                          <block type="variables_get" id="gb2"><field name="VAR" id="var_b">b</field></block>
                        </value>
                      </block>
                    </value>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>