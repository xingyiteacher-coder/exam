<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_s">s</variable>
    <variable id="var_cnt">count</variable>
    <variable id="var_i">i</variable>
    <variable id="var_char">char</variable>
  </variables>
  <block type="variables_set" id="init_s" x="20" y="20">
    <field name="VAR" id="var_s">s</field>
    <value name="VALUE">
      <block type="text_prompt_ext" id="prompt_s">
        <mutation type="TEXT"></mutation>
        <field name="TYPE">TEXT</field>
      </block>
    </value>
    <next>
      <block type="variables_set" id="init_cnt">
        <field name="VAR" id="var_cnt">count</field>
        <value name="VALUE">
          <block type="math_number" id="num0"><field name="NUM">0</field></block>
        </value>
        <next>
          <block type="controls_for" id="loop_str">
            <field name="VAR" id="var_i">i</field>
            <value name="FROM">
              <shadow type="math_number" id="num1"><field name="NUM">1</field></shadow>
            </value>
            <value name="TO">
              <block type="text_length" id="len">
                <value name="VALUE">
                  <block type="variables_get" id="gs1"><field name="VAR" id="var_s">s</field></block>
                </value>
              </block>
            </value>
            <value name="BY">
              <shadow type="math_number" id="step1"><field name="NUM">1</field></shadow>
            </value>
            <statement name="DO">
              <block type="controls_if" id="check_a">
                <value name="IF0">
                  <block type="logic_compare" id="cmp_a">
                    <field name="OP">EQ</field>
                    <value name="A">
                      <block type="text_charAt" id="get_char">
                        <mutation at="true"></mutation>
                        <field name="WHERE">FROM_START</field>
                        <value name="VALUE">
                          <block type="variables_get" id="gs2"><field name="VAR" id="var_s">s</field></block>
                        </value>
                        <value name="AT">
                          <block type="variables_get" id="gi"><field name="VAR" id="var_i">i</field></block>
                        </value>
                      </block>
                    </value>
                    <value name="B">
                      <shadow type="text" id="txt_a"><field name="TEXT">a</field></shadow>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="math_change" id="inc_cnt">
                    <field name="VAR" id="var_cnt">count</field>
                    <value name="DELTA">
                      <shadow type="math_number" id="inc1"><field name="NUM">1</field></shadow>
                    </value>
                  </block>
                </statement>
              </block>
            </statement>
            <next>
              <block type="text_print" id="print">
                <value name="TEXT">
                  <block type="variables_get" id="gcnt"><field name="VAR" id="var_cnt">count</field></block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>