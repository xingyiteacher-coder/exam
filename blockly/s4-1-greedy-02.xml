<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_n">N</variable>
    <variable id="var_starts">starts</variable>
    <variable id="var_ends">ends</variable>
    <variable id="var_i">i</variable>
    <variable id="var_j">j</variable>
    <variable id="var_line">line</variable>
    <variable id="var_parts">parts</variable>
    <variable id="var_temp">temp</variable>
    <variable id="var_count">count</variable>
    <variable id="var_last_end">last_end</variable>
  </variables>

  <!-- 1. 讀入 N 並初始化陣列 -->
  <block type="variables_set" id="init_n" x="20" y="20">
    <field name="VAR" id="var_n">N</field>
    <value name="VALUE">
      <block type="math_single">
        <field name="OP">ABS</field>
        <value name="NUM">
          <block type="text_prompt_ext">
            <mutation type="NUMBER"></mutation>
            <field name="TYPE">NUMBER</field>
          </block>
        </value>
      </block>
    </value>
    <next>
      <block type="variables_set" id="init_starts">
        <field name="VAR" id="var_starts">starts</field>
        <value name="VALUE">
          <block type="lists_create_with">
            <mutation items="0"></mutation>
          </block>
        </value>
        <next>
          <block type="variables_set" id="init_ends">
            <field name="VAR" id="var_ends">ends</field>
            <value name="VALUE">
              <block type="lists_create_with">
                <mutation items="0"></mutation>
              </block>
            </value>
            <next>
              <!-- 讀入 N 行 (開始時間 s 與結束時間 e) -->
              <block type="controls_repeat_ext" id="read_loop">
                <value name="TIMES">
                  <block type="variables_get">
                    <field name="VAR" id="var_n">N</field>
                  </block>
                </value>
                <statement name="DO">
                  <block type="variables_set" id="read_line">
                    <field name="VAR" id="var_line">line</field>
                    <value name="VALUE">
                      <block type="text_prompt_ext">
                        <mutation type="TEXT"></mutation>
                        <field name="TYPE">TEXT</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="split_line">
                        <field name="VAR" id="var_parts">parts</field>
                        <value name="VALUE">
                          <block type="lists_split">
                            <mutation mode="SPLIT"></mutation>
                            <field name="MODE">SPLIT</field>
                            <value name="INPUT">
                              <block type="variables_get">
                                <field name="VAR" id="var_line">line</field>
                              </block>
                            </value>
                            <value name="DELIM">
                              <shadow type="text">
                                <field name="TEXT"> </field>
                              </shadow>
                            </value>
                          </block>
                        </value>
                        <next>
                          <!-- 強制轉數字存入 starts -->
                          <block type="lists_setIndex" id="add_start">
                            <mutation at="false"></mutation>
                            <field name="MODE">INSERT</field>
                            <field name="WHERE">LAST</field>
                            <value name="LIST">
                              <block type="variables_get">
                                <field name="VAR" id="var_starts">starts</field>
                              </block>
                            </value>
                            <value name="TO">
                              <block type="math_single">
                                <field name="OP">ABS</field>
                                <value name="NUM">
                                  <block type="lists_getIndex">
                                    <mutation statement="false" at="true"></mutation>
                                    <field name="MODE">GET</field>
                                    <field name="WHERE">FROM_START</field>
                                    <value name="VALUE">
                                      <block type="variables_get">
                                        <field name="VAR" id="var_parts">parts</field>
                                      </block>
                                    </value>
                                    <value name="AT">
                                      <block type="math_number">
                                        <field name="NUM">1</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <next>
                              <!-- 強制轉數字存入 ends -->
                              <block type="lists_setIndex" id="add_end">
                                <mutation at="false"></mutation>
                                <field name="MODE">INSERT</field>
                                <field name="WHERE">LAST</field>
                                <value name="LIST">
                                  <block type="variables_get">
                                    <field name="VAR" id="var_ends">ends</field>
                                  </block>
                                </value>
                                <value name="TO">
                                  <block type="math_single">
                                    <field name="OP">ABS</field>
                                    <value name="NUM">
                                      <block type="lists_getIndex">
                                        <mutation statement="false" at="true"></mutation>
                                        <field name="MODE">GET</field>
                                        <field name="WHERE">FROM_START</field>
                                        <value name="VALUE">
                                          <block type="variables_get">
                                            <field name="VAR" id="var_parts">parts</field>
                                          </block>
                                        </value>
                                        <value name="AT">
                                          <block type="math_number">
                                            <field name="NUM">2</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </statement>
                <next>
                  <!-- 2. 泡沫排序法 -->
                  <block type="controls_for" id="outer_sort_loop">
                    <field name="VAR" id="var_i">i</field>
                    <value name="FROM">
                      <block type="math_number">
                        <field name="NUM">1</field>
                      </block>
                    </value>
                    <value name="TO">
                      <block type="variables_get">
                        <field name="VAR" id="var_n">N</field>
                      </block>
                    </value>
                    <value name="BY">
                      <block type="math_number">
                        <field name="NUM">1</field>
                      </block>
                    </value>
                    <statement name="DO">
                      <block type="controls_for" id="inner_sort_loop">
                        <field name="VAR" id="var_j">j</field>
                        <value name="FROM">
                          <block type="math_number">
                            <field name="NUM">1</field>
                          </block>
                        </value>
                        <value name="TO">
                          <block type="math_arithmetic">
                            <field name="OP">MINUS</field>
                            <value name="A">
                              <block type="variables_get">
                                <field name="VAR" id="var_n">N</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_number">
                                <field name="NUM">1</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <value name="BY">
                          <block type="math_number">
                            <field name="NUM">1</field>
                          </block>
                        </value>
                        <statement name="DO">
                          <block type="controls_if" id="check_swap">
                            <value name="IF0">
                              <block type="logic_compare">
                                <field name="OP">GT</field>
                                <value name="A">
                                  <block type="lists_getIndex">
                                    <mutation statement="false" at="true"></mutation>
                                    <field name="MODE">GET</field>
                                    <field name="WHERE">FROM_START</field>
                                    <value name="VALUE">
                                      <block type="variables_get">
                                        <field name="VAR" id="var_ends">ends</field>
                                      </block>
                                    </value>
                                    <value name="AT">
                                      <block type="variables_get">
                                        <field name="VAR" id="var_j">j</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="lists_getIndex">
                                    <mutation statement="false" at="true"></mutation>
                                    <field name="MODE">GET</field>
                                    <field name="WHERE">FROM_START</field>
                                    <value name="VALUE">
                                      <block type="variables_get">
                                        <field name="VAR" id="var_ends">ends</field>
                                      </block>
                                    </value>
                                    <value name="AT">
                                      <block type="math_arithmetic">
                                        <field name="OP">ADD</field>
                                        <value name="A">
                                          <block type="variables_get">
                                            <field name="VAR" id="var_j">j</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="math_number">
                                            <field name="NUM">1</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO0">
                              <block type="variables_set" id="swap_ends_1">
                                <field name="VAR" id="var_temp">temp</field>
                                <value name="VALUE">
                                  <block type="lists_getIndex">
                                    <mutation statement="false" at="true"></mutation>
                                    <field name="MODE">GET</field>
                                    <field name="WHERE">FROM_START</field>
                                    <value name="VALUE">
                                      <block type="variables_get">
                                        <field name="VAR" id="var_ends">ends</field>
                                      </block>
                                    </value>
                                    <value name="AT">
                                      <block type="variables_get">
                                        <field name="VAR" id="var_j">j</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <next>
                                  <block type="lists_setIndex" id="swap_ends_2">
                                    <mutation at="true"></mutation>
                                    <field name="MODE">SET</field>
                                    <field name="WHERE">FROM_START</field>
                                    <value name="LIST">
                                      <block type="variables_get">
                                        <field name="VAR" id="var_ends">ends</field>
                                      </block>
                                    </value>
                                    <value name="AT">
                                      <block type="variables_get">
                                        <field name="VAR" id="var_j">j</field>
                                      </block>
                                    </value>
                                    <value name="TO">
                                      <block type="lists_getIndex">
                                        <mutation statement="false" at="true"></mutation>
                                        <field name="MODE">GET</field>
                                        <field name="WHERE">FROM_START</field>
                                        <value name="VALUE">
                                          <block type="variables_get">
                                            <field name="VAR" id="var_ends">ends</field>
                                          </block>
                                        </value>
                                        <value name="AT">
                                          <block type="math_arithmetic">
                                            <field name="OP">ADD</field>
                                            <value name="A">
                                              <block type="variables_get">
                                                <field name="VAR" id="var_j">j</field>
                                              </block>
                                            </value>
                                            <value name="B">
                                              <block type="math_number">
                                                <field name="NUM">1</field>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="lists_setIndex" id="swap_ends_3">
                                        <mutation at="true"></mutation>
                                        <field name="MODE">SET</field>
                                        <field name="WHERE">FROM_START</field>
                                        <value name="LIST">
                                          <block type="variables_get">
                                            <field name="VAR" id="var_ends">ends</field>
                                          </block>
                                        </value>
                                        <value name="AT">
                                          <block type="math_arithmetic">
                                            <field name="OP">ADD</field>
                                            <value name="A">
                                              <block type="variables_get">
                                                <field name="VAR" id="var_j">j</field>
                                              </block>
                                            </value>
                                            <value name="B">
                                              <block type="math_number">
                                                <field name="NUM">1</field>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                        <value name="TO">
                                          <block type="variables_get">
                                            <field name="VAR" id="var_temp">temp</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="variables_set" id="swap_starts_1">
                                            <field name="VAR" id="var_temp">temp</field>
                                            <value name="VALUE">
                                              <block type="lists_getIndex">
                                                <mutation statement="false" at="true"></mutation>
                                                <field name="MODE">GET</field>
                                                <field name="WHERE">FROM_START</field>
                                                <value name="VALUE">
                                                  <block type="variables_get">
                                                    <field name="VAR" id="var_starts">starts</field>
                                                  </block>
                                                </value>
                                                <value name="AT">
                                                  <block type="variables_get">
                                                    <field name="VAR" id="var_j">j</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <next>
                                              <block type="lists_setIndex" id="swap_starts_2">
                                                <mutation at="true"></mutation>
                                                <field name="MODE">SET</field>
                                                <field name="WHERE">FROM_START</field>
                                                <value name="LIST">
                                                  <block type="variables_get">
                                                    <field name="VAR" id="var_starts">starts</field>
                                                  </block>
                                                </value>
                                                <value name="AT">
                                                  <block type="variables_get">
                                                    <field name="VAR" id="var_j">j</field>
                                                  </block>
                                                </value>
                                                <value name="TO">
                                                  <block type="lists_getIndex">
                                                    <mutation statement="false" at="true"></mutation>
                                                    <field name="MODE">GET</field>
                                                    <field name="WHERE">FROM_START</field>
                                                    <value name="VALUE">
                                                      <block type="variables_get">
                                                        <field name="VAR" id="var_starts">starts</field>
                                                      </block>
                                                    </value>
                                                    <value name="AT">
                                                      <block type="math_arithmetic">
                                                        <field name="OP">ADD</field>
                                                        <value name="A">
                                                          <block type="variables_get">
                                                            <field name="VAR" id="var_j">j</field>
                                                          </block>
                                                        </value>
                                                        <value name="B">
                                                          <block type="math_number">
                                                            <field name="NUM">1</field>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                                <next>
                                                  <block type="lists_setIndex" id="swap_starts_3">
                                                    <mutation at="true"></mutation>
                                                    <field name="MODE">SET</field>
                                                    <field name="WHERE">FROM_START</field>
                                                    <value name="LIST">
                                                      <block type="variables_get">
                                                        <field name="VAR" id="var_starts">starts</field>
                                                      </block>
                                                    </value>
                                                    <value name="AT">
                                                      <block type="math_arithmetic">
                                                        <field name="OP">ADD</field>
                                                        <value name="A">
                                                          <block type="variables_get">
                                                            <field name="VAR" id="var_j">j</field>
                                                          </block>
                                                        </value>
                                                        <value name="B">
                                                          <block type="math_number">
                                                            <field name="NUM">1</field>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </value>
                                                    <value name="TO">
                                                      <block type="variables_get">
                                                        <field name="VAR" id="var_temp">temp</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </statement>
                          </block>
                        </statement>
                      </block>
                    </statement>
                    <next>
                      <!-- 3. 貪婪選擇 -->
                      <block type="variables_set" id="init_count">
                        <field name="VAR" id="var_count">count</field>
                        <value name="VALUE">
                          <block type="math_number">
                            <field name="NUM">0</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="init_last_end">
                            <field name="VAR" id="var_last_end">last_end</field>
                            <value name="VALUE">
                              <block type="math_number">
                                <field name="NUM">-1</field>
                              </block>
                            </value>
                            <next>
                              <block type="controls_for" id="greedy_loop">
                                <field name="VAR" id="var_i">i</field>
                                <value name="FROM">
                                  <block type="math_number">
                                    <field name="NUM">1</field>
                                  </block>
                                </value>
                                <value name="TO">
                                  <block type="variables_get">
                                    <field name="VAR" id="var_n">N</field>
                                  </block>
                                </value>
                                <value name="BY">
                                  <block type="math_number">
                                    <field name="NUM">1</field>
                                  </block>
                                </value>
                                <statement name="DO">
                                  <block type="controls_if" id="check_overlap">
                                    <value name="IF0">
                                      <block type="logic_compare">
                                        <field name="OP">GTE</field>
                                        <value name="A">
                                          <block type="lists_getIndex">
                                            <mutation statement="false" at="true"></mutation>
                                            <field name="MODE">GET</field>
                                            <field name="WHERE">FROM_START</field>
                                            <value name="VALUE">
                                              <block type="variables_get">
                                                <field name="VAR" id="var_starts">starts</field>
                                              </block>
                                            </value>
                                            <value name="AT">
                                              <block type="variables_get">
                                                <field name="VAR" id="var_i">i</field>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="variables_get">
                                            <field name="VAR" id="var_last_end">last_end</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <statement name="DO0">
                                      <block type="variables_set" id="add_count">
                                        <field name="VAR" id="var_count">count</field>
                                        <value name="VALUE">
                                          <block type="math_arithmetic">
                                            <field name="OP">ADD</field>
                                            <value name="A">
                                              <block type="variables_get">
                                                <field name="VAR" id="var_count">count</field>
                                              </block>
                                            </value>
                                            <value name="B">
                                              <block type="math_number">
                                                <field name="NUM">1</field>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="variables_set" id="update_last_end">
                                            <field name="VAR" id="var_last_end">last_end</field>
                                            <value name="VALUE">
                                              <block type="lists_getIndex">
                                                <mutation statement="false" at="true"></mutation>
                                                <field name="MODE">GET</field>
                                                <field name="WHERE">FROM_START</field>
                                                <value name="VALUE">
                                                  <block type="variables_get">
                                                    <field name="VAR" id="var_ends">ends</field>
                                                  </block>
                                                </value>
                                                <value name="AT">
                                                  <block type="variables_get">
                                                    <field name="VAR" id="var_i">i</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                          </block>
                                        </next>
                                      </block>
                                    </statement>
                                  </block>
                                </statement>
                                <next>
                                  <!-- 4. 輸出結果 -->
                                  <block type="text_print" id="print_ans">
                                    <value name="TEXT">
                                      <block type="variables_get">
                                        <field name="VAR" id="var_count">count</field>
                                      </block>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>