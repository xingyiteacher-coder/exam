<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_num_N">num_N</variable>
    <variable id="var_line">line</variable>
    <variable id="var_parts">parts</variable>
    <variable id="var_list_a">list_a</variable>
    <variable id="var_idx_i">idx_i</variable>
    <variable id="var_idx_j">idx_j</variable>
    <variable id="var_temp">temp</variable>
    <variable id="var_max_sum">max_sum</variable>
    <variable id="var_pair_sum">pair_sum</variable>
  </variables>

  <!-- 1. 讀取 N 與數字列表 -->
  <block type="variables_set" id="read_N" x="20" y="20">
    <field name="VAR" id="var_num_N">num_N</field>
    <value name="VALUE">
      <block type="math_single">
        <field name="OP">ABS</field>
        <value name="NUM">
          <block type="text_prompt_ext">
            <mutation type="NUMBER"></mutation>
            <field name="TYPE">NUMBER</field>
          </block>
        </value>
      </block>
    </value>
    <next>
      <block type="variables_set" id="read_line">
        <field name="VAR" id="var_line">line</field>
        <value name="VALUE">
          <block type="text_prompt_ext">
            <mutation type="TEXT"></mutation>
            <field name="TYPE">TEXT</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="split_line">
            <field name="VAR" id="var_parts">parts</field>
            <value name="VALUE">
              <block type="lists_split">
                <mutation mode="SPLIT"></mutation>
                <field name="MODE">SPLIT</field>
                <value name="INPUT">
                  <block type="variables_get">
                    <field name="VAR" id="var_line">line</field>
                  </block>
                </value>
                <value name="DELIM">
                  <shadow type="text">
                    <field name="TEXT"> </field>
                  </shadow>
                </value>
              </block>
            </value>
            <next>
              <block type="variables_set" id="init_a_list">
                <field name="VAR" id="var_list_a">list_a</field>
                <value name="VALUE">
                  <block type="lists_create_with">
                    <mutation items="0"></mutation>
                  </block>
                </value>
                <next>
                  <!-- 將字串轉換為數字放入 list_a -->
                  <block type="controls_for" id="convert_a">
                    <field name="VAR" id="var_idx_i">idx_i</field>
                    <value name="FROM"><block type="math_number"><field name="NUM">1</field></block></value>
                    <value name="TO"><block type="variables_get"><field name="VAR" id="var_num_N">num_N</field></block></value>
                    <value name="BY"><block type="math_number"><field name="NUM">1</field></block></value>
                    <statement name="DO">
                      <block type="lists_setIndex" id="add_a">
                        <mutation at="false"></mutation>
                        <field name="MODE">INSERT</field>
                        <field name="WHERE">LAST</field>
                        <value name="LIST">
                          <block type="variables_get"><field name="VAR" id="var_list_a">list_a</field></block>
                        </value>
                        <value name="TO">
                          <block type="math_single">
                            <field name="OP">ABS</field>
                            <value name="NUM">
                              <block type="lists_getIndex">
                                <mutation statement="false" at="true"></mutation>
                                <field name="MODE">GET</field>
                                <field name="WHERE">FROM_START</field>
                                <value name="VALUE"><block type="variables_get"><field name="VAR" id="var_parts">parts</field></block></value>
                                <value name="AT"><block type="variables_get"><field name="VAR" id="var_idx_i">idx_i</field></block></value>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </statement>
                    <next>
                      <!-- 2. 對 list_a 進行升冪排序（氣泡排序） -->
                      <block type="controls_for" id="sort_1">
                        <field name="VAR" id="var_idx_i">idx_i</field>
                        <value name="FROM"><block type="math_number"><field name="NUM">1</field></block></value>
                        <value name="TO"><block type="variables_get"><field name="VAR" id="var_num_N">num_N</field></block></value>
                        <value name="BY"><block type="math_number"><field name="NUM">1</field></block></value>
                        <statement name="DO">
                          <block type="controls_for" id="sort_2">
                            <field name="VAR" id="var_idx_j">idx_j</field>
                            <value name="FROM"><block type="math_number"><field name="NUM">1</field></block></value>
                            <value name="TO">
                              <block type="math_arithmetic">
                                <field name="OP">MINUS</field>
                                <value name="A"><block type="variables_get"><field name="VAR" id="var_num_N">num_N</field></block></value>
                                <value name="B"><block type="math_number"><field name="NUM">1</field></block></value>
                              </block>
                            </value>
                            <value name="BY"><block type="math_number"><field name="NUM">1</field></block></value>
                            <statement name="DO">
                              <block type="controls_if" id="check_swap">
                                <value name="IF0">
                                  <block type="logic_compare">
                                    <field name="OP">GT</field>
                                    <value name="A">
                                      <block type="lists_getIndex">
                                        <mutation statement="false" at="true"></mutation>
                                        <field name="MODE">GET</field>
                                        <field name="WHERE">FROM_START</field>
                                        <value name="VALUE"><block type="variables_get"><field name="VAR" id="var_list_a">list_a</field></block></value>
                                        <value name="AT"><block type="variables_get"><field name="VAR" id="var_idx_j">idx_j</field></block></value>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="lists_getIndex">
                                        <mutation statement="false" at="true"></mutation>
                                        <field name="MODE">GET</field>
                                        <field name="WHERE">FROM_START</field>
                                        <value name="VALUE"><block type="variables_get"><field name="VAR" id="var_list_a">list_a</field></block></value>
                                        <value name="AT">
                                          <block type="math_arithmetic">
                                            <field name="OP">ADD</field>
                                            <value name="A"><block type="variables_get"><field name="VAR" id="var_idx_j">idx_j</field></block></value>
                                            <value name="B"><block type="math_number"><field name="NUM">1</field></block></value>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="DO0">
                                  <block type="variables_set" id="swap_temp">
                                    <field name="VAR" id="var_temp">temp</field>
                                    <value name="VALUE">
                                      <block type="lists_getIndex">
                                        <mutation statement="false" at="true"></mutation>
                                        <field name="MODE">GET</field>
                                        <field name="WHERE">FROM_START</field>
                                        <value name="VALUE"><block type="variables_get"><field name="VAR" id="var_list_a">list_a</field></block></value>
                                        <value name="AT"><block type="variables_get"><field name="VAR" id="var_idx_j">idx_j</field></block></value>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="lists_setIndex" id="swap_1">
                                        <mutation at="true"></mutation>
                                        <field name="MODE">SET</field>
                                        <field name="WHERE">FROM_START</field>
                                        <value name="LIST"><block type="variables_get"><field name="VAR" id="var_list_a">list_a</field></block></value>
                                        <value name="AT"><block type="variables_get"><field name="VAR" id="var_idx_j">idx_j</field></block></value>
                                        <value name="TO">
                                          <block type="lists_getIndex">
                                            <mutation statement="false" at="true"></mutation>
                                            <field name="MODE">GET</field>
                                            <field name="WHERE">FROM_START</field>
                                            <value name="VALUE"><block type="variables_get"><field name="VAR" id="var_list_a">list_a</field></block></value>
                                            <value name="AT">
                                              <block type="math_arithmetic">
                                                <field name="OP">ADD</field>
                                                <value name="A"><block type="variables_get"><field name="VAR" id="var_idx_j">idx_j</field></block></value>
                                                <value name="B"><block type="math_number"><field name="NUM">1</field></block></value>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="lists_setIndex" id="swap_2">
                                            <mutation at="true"></mutation>
                                            <field name="MODE">SET</field>
                                            <field name="WHERE">FROM_START</field>
                                            <value name="LIST"><block type="variables_get"><field name="VAR" id="var_list_a">list_a</field></block></value>
                                            <value name="AT">
                                              <block type="math_arithmetic">
                                                <field name="OP">ADD</field>
                                                <value name="A"><block type="variables_get"><field name="VAR" id="var_idx_j">idx_j</field></block></value>
                                                <value name="B"><block type="math_number"><field name="NUM">1</field></block></value>
                                              </block>
                                            </value>
                                            <value name="TO"><block type="variables_get"><field name="VAR" id="var_temp">temp</field></block></value>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </statement>
                              </block>
                            </statement>
                          </block>
                        </statement>
                        <next>
                          <!-- 3. 首尾配對求和，維護最大和 -->
                          <block type="variables_set" id="init_max">
                            <field name="VAR" id="var_max_sum">max_sum</field>
                            <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
                            <next>
                              <block type="controls_for" id="pair_loop">
                                <field name="VAR" id="var_idx_i">idx_i</field>
                                <value name="FROM"><block type="math_number"><field name="NUM">1</field></block></value>
                                <value name="TO">
                                  <block type="math_arithmetic">
                                    <field name="OP">DIVIDE</field>
                                    <value name="A"><block type="variables_get"><field name="VAR" id="var_num_N">num_N</field></block></value>
                                    <value name="B"><block type="math_number"><field name="NUM">2</field></block></value>
                                  </block>
                                </value>
                                <value name="BY"><block type="math_number"><field name="NUM">1</field></block></value>
                                <statement name="DO">
                                  <!-- pair_sum = list_a[i] + list_a[N - i + 1] -->
                                  <block type="variables_set" id="calc_pair">
                                    <field name="VAR" id="var_pair_sum">pair_sum</field>
                                    <value name="VALUE">
                                      <block type="math_arithmetic">
                                        <field name="OP">ADD</field>
                                        <value name="A">
                                          <block type="lists_getIndex">
                                            <mutation statement="false" at="true"></mutation>
                                            <field name="MODE">GET</field>
                                            <field name="WHERE">FROM_START</field>
                                            <value name="VALUE"><block type="variables_get"><field name="VAR" id="var_list_a">list_a</field></block></value>
                                            <value name="AT"><block type="variables_get"><field name="VAR" id="var_idx_i">idx_i</field></block></value>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="lists_getIndex">
                                            <mutation statement="false" at="true"></mutation>
                                            <field name="MODE">GET</field>
                                            <field name="WHERE">FROM_START</field>
                                            <value name="VALUE"><block type="variables_get"><field name="VAR" id="var_list_a">list_a</field></block></value>
                                            <value name="AT">
                                              <block type="math_arithmetic">
                                                <field name="OP">ADD</field>
                                                <value name="A">
                                                  <block type="math_arithmetic">
                                                    <field name="OP">MINUS</field>
                                                    <value name="A"><block type="variables_get"><field name="VAR" id="var_num_N">num_N</field></block></value>
                                                    <value name="B"><block type="variables_get"><field name="VAR" id="var_idx_i">idx_i</field></block></value>
                                                  </block>
                                                </value>
                                                <value name="B"><block type="math_number"><field name="NUM">1</field></block></value>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <next>
                                      <!-- if pair_sum > max_sum then max_sum = pair_sum -->
                                      <block type="controls_if" id="check_max">
                                        <value name="IF0">
                                          <block type="logic_compare">
                                            <field name="OP">GT</field>
                                            <value name="A"><block type="variables_get"><field name="VAR" id="var_pair_sum">pair_sum</field></block></value>
                                            <value name="B"><block type="variables_get"><field name="VAR" id="var_max_sum">max_sum</field></block></value>
                                          </block>
                                        </value>
                                        <statement name="DO0">
                                          <block type="variables_set" id="update_max">
                                            <field name="VAR" id="var_max_sum">max_sum</field>
                                            <value name="VALUE"><block type="variables_get"><field name="VAR" id="var_pair_sum">pair_sum</field></block></value>
                                          </block>
                                        </statement>
                                      </block>
                                    </next>
                                  </block>
                                </statement>
                                <next>
                                  <!-- 4. 輸出結果 -->
                                  <block type="text_print" id="print_result">
                                    <value name="TEXT">
                                      <block type="variables_get"><field name="VAR" id="var_max_sum">max_sum</field></block>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>