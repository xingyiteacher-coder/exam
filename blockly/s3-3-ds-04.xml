<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="n">n</variable>
    <variable id="total_sum">total_sum</variable>
    <variable id="i">i</variable>
    <variable id="raw_line">raw_line</variable>
    <variable id="row_list">row_list</variable>
    <variable id="val">val</variable>
  </variables>
  <block type="variables_set" x="20" y="20">
    <field name="VAR" id="n">n</field>
    <value name="VALUE">
      <block type="math_arithmetic">
        <field name="OP">MINUS</field>
        <value name="A"><block type="text_prompt_ext"><mutation type="NUMBER"></mutation><field name="TYPE">NUMBER</field></block></value>
        <value name="B"><block type="math_number"><field name="NUM">0</field></block></value>
      </block>
    </value>
    <next>
      <block type="variables_set">
        <field name="VAR" id="total_sum">total_sum</field>
        <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
        <next>
          <block type="controls_for">
            <field name="VAR" id="i">i</field>
            <value name="FROM"><block type="math_number"><field name="NUM">1</field></block></value>
            <value name="TO"><block type="variables_get"><field name="VAR" id="n">n</field></block></value>
            <value name="BY"><block type="math_number"><field name="NUM">1</field></block></value>
            <statement name="DO">
              <block type="variables_set">
                <field name="VAR" id="raw_line">raw_line</field>
                <value name="VALUE"><block type="text_prompt_ext"><mutation type="TEXT"></mutation><field name="TYPE">TEXT</field></block></value>
                <next>
                  <block type="variables_set">
                    <field name="VAR" id="row_list">row_list</field>
                    <value name="VALUE">
                      <block type="lists_split">
                        <mutation mode="SPLIT"></mutation>
                        <field name="MODE">SPLIT</field>
                        <value name="INPUT"><block type="variables_get"><field name="VAR" id="raw_line">raw_line</field></block></value>
                        <value name="DELIM"><block type="text"><field name="TEXT"> </field></block></value>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set">
                        <field name="VAR" id="val">val</field>
                        <value name="VALUE">
                          <block type="math_arithmetic">
                            <field name="OP">MINUS</field>
                            <value name="A">
                              <block type="lists_getIndex">
                                <mutation statement="false" at="true"></mutation>
                                <field name="MODE">GET</field>
                                <field name="WHERE">FROM_START</field>
                                <value name="VALUE"><block type="variables_get"><field name="VAR" id="row_list">row_list</field></block></value>
                                <value name="AT"><block type="variables_get"><field name="VAR" id="i">i</field></block></value>
                              </block>
                            </value>
                            <value name="B"><block type="math_number"><field name="NUM">0</field></block></value>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set">
                            <field name="VAR" id="total_sum">total_sum</field>
                            <value name="VALUE">
                              <block type="math_arithmetic">
                                <field name="OP">ADD</field>
                                <value name="A"><block type="variables_get"><field name="VAR" id="total_sum">total_sum</field></block></value>
                                <value name="B"><block type="variables_get"><field name="VAR" id="val">val</field></block></value>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </statement>
            <next>
              <block type="text_print">
                <value name="TEXT"><block type="variables_get"><field name="VAR" id="total_sum">total_sum</field></block></value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>