<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="controls_if" id="if_coprime" x="20" y="20">
    <mutation else="1"></mutation>
    <value name="IF0">
      <block type="logic_compare" id="cmp">
        <field name="OP">EQ</field>
        <value name="A">
          <block type="math_modulo" id="gcd">
            <field name="OP">GCD</field>
            <value name="A">
              <shadow type="math_number"><field name="NUM">1</field></shadow>
              <block type="text_prompt_ext" id="prompt_a">
                <mutation type="NUMBER"></mutation>
                <field name="TYPE">NUMBER</field>
              </block>
            </value>
            <value name="B">
              <shadow type="math_number"><field name="NUM">1</field></shadow>
              <block type="text_prompt_ext" id="prompt_b">
                <mutation type="NUMBER"></mutation>
                <field name="TYPE">NUMBER</field>
              </block>
            </value>
          </block>
        </value>
        <value name="B">
          <shadow type="math_number" id="num1">
            <field name="NUM">1</field>
          </shadow>
        </value>
      </block>
    </value>
    <statement name="DO0">
      <block type="text_print" id="print_yes">
        <value name="TEXT">
          <shadow type="text" id="str_yes">
            <field name="TEXT">yes</field>
          </shadow>
        </value>
      </block>
    </statement>
    <statement name="ELSE">
      <block type="text_print" id="print_no">
        <value name="TEXT">
          <shadow type="text" id="str_no">
            <field name="TEXT">no</field>
          </shadow>
        </value>
      </block>
    </statement>
  </block>
</xml>