<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="N">N</variable>
    <variable id="M">M</variable>
    <variable id="adj">adj</variable>
    <variable id="color">color</variable>
    <variable id="queue">queue</variable>
    <variable id="is_bipartite">is_bipartite</variable>
    <variable id="i">i</variable>
    <variable id="k">k</variable>
    <variable id="u">u</variable>
    <variable id="v">v</variable>
    <variable id="curr">curr</variable>
    <variable id="neighbor">neighbor</variable>
  </variables>

  <!-- 1. 讀取 N -->
  <block type="variables_set" x="20" y="20">
    <field name="VAR" id="N">N</field>
    <value name="VALUE">
      <block type="text_prompt_ext">
        <mutation type="NUMBER"></mutation>
        <field name="TYPE">NUMBER</field>
      </block>
    </value>
    <next>
      <!-- 2. 讀取 M -->
      <block type="variables_set">
        <field name="VAR" id="M">M</field>
        <value name="VALUE">
          <block type="text_prompt_ext">
            <mutation type="NUMBER"></mutation>
            <field name="TYPE">NUMBER</field>
          </block>
        </value>
        <next>
          <!-- 3. 初始化 is_bipartite = true -->
          <block type="variables_set">
            <field name="VAR" id="is_bipartite">is_bipartite</field>
            <value name="VALUE">
              <block type="logic_boolean">
                <field name="BOOL">TRUE</field>
              </block>
            </value>
            <next>
              <!-- 4. 初始化 adj = [] -->
              <block type="variables_set">
                <field name="VAR" id="adj">adj</field>
                <value name="VALUE">
                  <block type="lists_create_with">
                    <mutation items="0"></mutation>
                  </block>
                </value>
                <next>
                  <!-- 5. 建立 N 個空清單放入 adj -->
                  <block type="controls_for">
                    <field name="VAR" id="i">i</field>
                    <value name="FROM">
                      <block type="math_number"><field name="NUM">1</field></block>
                    </value>
                    <value name="TO">
                      <block type="variables_get"><field name="VAR" id="N">N</field></block>
                    </value>
                    <value name="BY">
                      <block type="math_number"><field name="NUM">1</field></block>
                    </value>
                    <statement name="DO">
                      <block type="lists_setIndex">
                        <mutation at="false"></mutation>
                        <field name="MODE">INSERT</field>
                        <field name="WHERE">LAST</field>
                        <value name="LIST">
                          <block type="variables_get"><field name="VAR" id="adj">adj</field></block>
                        </value>
                        <value name="TO">
                          <block type="lists_create_with">
                            <mutation items="0"></mutation>
                          </block>
                        </value>
                      </block>
                    </statement>
                    <next>
                      <!-- 6. 讀取 M 條邊 (u, v) 並建圖 -->
                      <block type="controls_for">
                        <field name="VAR" id="k">k</field>
                        <value name="FROM">
                          <block type="math_number"><field name="NUM">1</field></block>
                        </value>
                        <value name="TO">
                          <block type="variables_get"><field name="VAR" id="M">M</field></block>
                        </value>
                        <value name="BY">
                          <block type="math_number"><field name="NUM">1</field></block>
                        </value>
                        <statement name="DO">
                          <block type="variables_set">
                            <field name="VAR" id="u">u</field>
                            <value name="VALUE">
                              <block type="text_prompt_ext">
                                <mutation type="NUMBER"></mutation>
                                <field name="TYPE">NUMBER</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set">
                                <field name="VAR" id="v">v</field>
                                <value name="VALUE">
                                  <block type="text_prompt_ext">
                                    <mutation type="NUMBER"></mutation>
                                    <field name="TYPE">NUMBER</field>
                                  </block>
                                </value>
                                <next>
                                  <!-- adj[u].append(v) -->
                                  <block type="lists_setIndex">
                                    <mutation at="false"></mutation>
                                    <field name="MODE">INSERT</field>
                                    <field name="WHERE">LAST</field>
                                    <value name="LIST">
                                      <block type="lists_getIndex">
                                        <mutation statement="false" at="true"></mutation>
                                        <field name="MODE">GET</field>
                                        <field name="WHERE">FROM_START</field>
                                        <value name="VALUE">
                                          <block type="variables_get"><field name="VAR" id="adj">adj</field></block>
                                        </value>
                                        <value name="AT">
                                          <block type="variables_get"><field name="VAR" id="u">u</field></block>
                                        </value>
                                      </block>
                                    </value>
                                    <value name="TO">
                                      <block type="variables_get"><field name="VAR" id="v">v</field></block>
                                    </value>
                                    <next>
                                      <!-- adj[v].append(u) -->
                                      <block type="lists_setIndex">
                                        <mutation at="false"></mutation>
                                        <field name="MODE">INSERT</field>
                                        <field name="WHERE">LAST</field>
                                        <value name="LIST">
                                          <block type="lists_getIndex">
                                            <mutation statement="false" at="true"></mutation>
                                            <field name="MODE">GET</field>
                                            <field name="WHERE">FROM_START</field>
                                            <value name="VALUE">
                                              <block type="variables_get"><field name="VAR" id="adj">adj</field></block>
                                            </value>
                                            <value name="AT">
                                              <block type="variables_get"><field name="VAR" id="v">v</field></block>
                                            </value>
                                          </block>
                                        </value>
                                        <value name="TO">
                                          <block type="variables_get"><field name="VAR" id="u">u</field></block>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </statement>
                        <next>
                          <!-- 7. 初始化 color 清單 (長度 N，全為 0) -->
                          <block type="variables_set">
                            <field name="VAR" id="color">color</field>
                            <value name="VALUE">
                              <block type="lists_repeat">
                                <value name="ITEM">
                                  <block type="math_number"><field name="NUM">0</field></block>
                                </value>
                                <value name="NUM">
                                  <block type="variables_get"><field name="VAR" id="N">N</field></block>
                                </value>
                              </block>
                            </value>
                            <next>
                              <!-- 8. BFS 染色過程 (走訪 1 到 N 節點) -->
                              <block type="controls_for">
                                <field name="VAR" id="i">i</field>
                                <value name="FROM">
                                  <block type="math_number"><field name="NUM">1</field></block>
                                </value>
                                <value name="TO">
                                  <block type="variables_get"><field name="VAR" id="N">N</field></block>
                                </value>
                                <value name="BY">
                                  <block type="math_number"><field name="NUM">1</field></block>
                                </value>
                                <statement name="DO">
                                  <block type="controls_if">
                                    <value name="IF0">
                                      <block type="logic_operation">
                                        <field name="OP">AND</field>
                                        <value name="A">
                                          <block type="logic_compare">
                                            <field name="OP">EQ</field>
                                            <value name="A">
                                              <block type="lists_getIndex">
                                                <mutation statement="false" at="true"></mutation>
                                                <field name="MODE">GET</field>
                                                <field name="WHERE">FROM_START</field>
                                                <value name="VALUE">
                                                  <block type="variables_get"><field name="VAR" id="color">color</field></block>
                                                </value>
                                                <value name="AT">
                                                  <block type="variables_get"><field name="VAR" id="i">i</field></block>
                                                </value>
                                              </block>
                                            </value>
                                            <value name="B">
                                              <block type="math_number"><field name="NUM">0</field></block>
                                            </value>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="variables_get"><field name="VAR" id="is_bipartite">is_bipartite</field></block>
                                        </value>
                                      </block>
                                    </value>
                                    <statement name="DO0">
                                      <!-- color[i] = 1 -->
                                      <block type="lists_setIndex">
                                        <mutation at="true"></mutation>
                                        <field name="MODE">SET</field>
                                        <field name="WHERE">FROM_START</field>
                                        <value name="LIST">
                                          <block type="variables_get"><field name="VAR" id="color">color</field></block>
                                        </value>
                                        <value name="AT">
                                          <block type="variables_get"><field name="VAR" id="i">i</field></block>
                                        </value>
                                        <value name="TO">
                                          <block type="math_number"><field name="NUM">1</field></block>
                                        </value>
                                        <next>
                                          <!-- queue = [i] -->
                                          <block type="variables_set">
                                            <field name="VAR" id="queue">queue</field>
                                            <value name="VALUE">
                                              <block type="lists_create_with">
                                                <mutation items="1"></mutation>
                                                <value name="ADD0">
                                                  <block type="variables_get"><field name="VAR" id="i">i</field></block>
                                                </value>
                                              </block>
                                            </value>
                                            <next>
                                              <!-- 當 queue 長度 > 0 且 is_bipartite 為真時執行 BFS -->
                                              <block type="controls_whileUntil">
                                                <field name="MODE">WHILE</field>
                                                <value name="BOOL">
                                                  <block type="logic_operation">
                                                    <field name="OP">AND</field>
                                                    <value name="A">
                                                      <block type="logic_compare">
                                                        <field name="OP">GT</field>
                                                        <value name="A">
                                                          <block type="lists_length">
                                                            <value name="VALUE">
                                                              <block type="variables_get"><field name="VAR" id="queue">queue</field></block>
                                                            </value>
                                                          </block>
                                                        </value>
                                                        <value name="B">
                                                          <block type="math_number"><field name="NUM">0</field></block>
                                                        </value>
                                                      </block>
                                                    </value>
                                                    <value name="B">
                                                      <block type="variables_get"><field name="VAR" id="is_bipartite">is_bipartite</field></block>
                                                    </value>
                                                  </block>
                                                </value>
                                                <statement name="DO">
                                                  <!-- curr = queue.pop(0) -->
                                                  <block type="variables_set">
                                                    <field name="VAR" id="curr">curr</field>
                                                    <value name="VALUE">
                                                      <block type="lists_getIndex">
                                                        <mutation statement="false" at="true"></mutation>
                                                        <field name="MODE">GET_REMOVE</field>
                                                        <field name="WHERE">FIRST</field>
                                                        <value name="VALUE">
                                                          <block type="variables_get"><field name="VAR" id="queue">queue</field></block>
                                                        </value>
                                                      </block>
                                                    </value>
                                                    <next>
                                                      <!-- 對相鄰節點 neighbor 進行檢查與染色 -->
                                                      <block type="controls_forEach">
                                                        <field name="VAR" id="neighbor">neighbor</field>
                                                        <value name="LIST">
                                                          <block type="lists_getIndex">
                                                            <mutation statement="false" at="true"></mutation>
                                                            <field name="MODE">GET</field>
                                                            <field name="WHERE">FROM_START</field>
                                                            <value name="VALUE">
                                                              <block type="variables_get"><field name="VAR" id="adj">adj</field></block>
                                                            </value>
                                                            <value name="AT">
                                                              <block type="variables_get"><field name="VAR" id="curr">curr</field></block>
                                                            </value>
                                                          </block>
                                                        </value>
                                                        <statement name="DO">
                                                          <block type="controls_if">
                                                            <mutation elseif="1"></mutation>
                                                            <value name="IF0">
                                                              <block type="logic_compare">
                                                                <field name="OP">EQ</field>
                                                                <value name="A">
                                                                  <block type="lists_getIndex">
                                                                    <mutation statement="false" at="true"></mutation>
                                                                    <field name="MODE">GET</field>
                                                                    <field name="WHERE">FROM_START</field>
                                                                    <value name="VALUE">
                                                                      <block type="variables_get"><field name="VAR" id="color">color</field></block>
                                                                    </value>
                                                                    <value name="AT">
                                                                      <block type="variables_get"><field name="VAR" id="neighbor">neighbor</field></block>
                                                                    </value>
                                                                  </block>
                                                                </value>
                                                                <value name="B">
                                                                  <block type="math_number"><field name="NUM">0</field></block>
                                                                </value>
                                                              </block>
                                                            </value>
                                                            <statement name="DO0">
                                                              <!-- color[neighbor] = 3 - color[curr] -->
                                                              <block type="lists_setIndex">
                                                                <mutation at="true"></mutation>
                                                                <field name="MODE">SET</field>
                                                                <field name="WHERE">FROM_START</field>
                                                                <value name="LIST">
                                                                  <block type="variables_get"><field name="VAR" id="color">color</field></block>
                                                                </value>
                                                                <value name="AT">
                                                                  <block type="variables_get"><field name="VAR" id="neighbor">neighbor</field></block>
                                                                </value>
                                                                <value name="TO">
                                                                  <block type="math_arithmetic">
                                                                    <field name="OP">MINUS</field>
                                                                    <value name="A">
                                                                      <block type="math_number"><field name="NUM">3</field></block>
                                                                    </value>
                                                                    <value name="B">
                                                                      <block type="lists_getIndex">
                                                                        <mutation statement="false" at="true"></mutation>
                                                                        <field name="MODE">GET</field>
                                                                        <field name="WHERE">FROM_START</field>
                                                                        <value name="VALUE">
                                                                          <block type="variables_get"><field name="VAR" id="color">color</field></block>
                                                                        </value>
                                                                        <value name="AT">
                                                                          <block type="variables_get"><field name="VAR" id="curr">curr</field></block>
                                                                        </value>
                                                                      </block>
                                                                    </value>
                                                                  </block>
                                                                </value>
                                                                <next>
                                                                  <!-- 將 neighbor 加入 queue -->
                                                                  <block type="lists_setIndex">
                                                                    <mutation at="false"></mutation>
                                                                    <field name="MODE">INSERT</field>
                                                                    <field name="WHERE">LAST</field>
                                                                    <value name="LIST">
                                                                      <block type="variables_get"><field name="VAR" id="queue">queue</field></block>
                                                                    </value>
                                                                    <value name="TO">
                                                                      <block type="variables_get"><field name="VAR" id="neighbor">neighbor</field></block>
                                                                    </value>
                                                                  </block>
                                                                </next>
                                                              </block>
                                                            </statement>
                                                            <!-- 發現顏色相同 -> 衝突，設定為非二分圖 -->
                                                            <value name="IF1">
                                                              <block type="logic_compare">
                                                                <field name="OP">EQ</field>
                                                                <value name="A">
                                                                  <block type="lists_getIndex">
                                                                    <mutation statement="false" at="true"></mutation>
                                                                    <field name="MODE">GET</field>
                                                                    <field name="WHERE">FROM_START</field>
                                                                    <value name="VALUE">
                                                                      <block type="variables_get"><field name="VAR" id="color">color</field></block>
                                                                    </value>
                                                                    <value name="AT">
                                                                      <block type="variables_get"><field name="VAR" id="neighbor">neighbor</field></block>
                                                                    </value>
                                                                  </block>
                                                                </value>
                                                                <value name="B">
                                                                  <block type="lists_getIndex">
                                                                    <mutation statement="false" at="true"></mutation>
                                                                    <field name="MODE">GET</field>
                                                                    <field name="WHERE">FROM_START</field>
                                                                    <value name="VALUE">
                                                                      <block type="variables_get"><field name="VAR" id="color">color</field></block>
                                                                    </value>
                                                                    <value name="AT">
                                                                      <block type="variables_get"><field name="VAR" id="curr">curr</field></block>
                                                                    </value>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </value>
                                                            <statement name="DO1">
                                                              <block type="variables_set">
                                                                <field name="VAR" id="is_bipartite">is_bipartite</field>
                                                                <value name="VALUE">
                                                                  <block type="logic_boolean">
                                                                    <field name="BOOL">FALSE</field>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </statement>
                                                          </block>
                                                        </statement>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </statement>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </statement>
                                  </block>
                                </statement>
                                <next>
                                  <!-- 9. 最終判斷輸出 yes 或 no -->
                                  <block type="controls_if">
                                    <mutation else="1"></mutation>
                                    <value name="IF0">
                                      <block type="variables_get"><field name="VAR" id="is_bipartite">is_bipartite</field></block>
                                    </value>
                                    <statement name="DO0">
                                      <block type="text_print">
                                        <value name="TEXT">
                                          <block type="text"><field name="TEXT">yes</field></block>
                                        </value>
                                      </block>
                                    </statement>
                                    <statement name="ELSE">
                                      <block type="text_print">
                                        <value name="TEXT">
                                          <block type="text"><field name="TEXT">no</field></block>
                                        </value>
                                      </block>
                                    </statement>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>