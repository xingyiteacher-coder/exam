<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_N">N</variable>
    <variable id="var_ans">ans</variable>
    <variable id="var_i">i</variable>
  </variables>
  <block type="variables_set" id="init_N" x="20" y="20">
    <field name="VAR" id="var_N">N</field>
    <value name="VALUE">
      <block type="math_arithmetic" id="cast_N">
        <field name="OP">MULTIPLY</field>
        <value name="A">
          <block type="text_prompt_ext" id="prompt_N">
            <mutation type="NUMBER"></mutation>
            <field name="TYPE">NUMBER</field>
          </block>
        </value>
        <value name="B">
          <shadow type="math_number" id="num1"><field name="NUM">1</field></shadow>
        </value>
      </block>
    </value>
    <next>
      <block type="variables_set" id="init_ans">
        <field name="VAR" id="var_ans">ans</field>
        <value name="VALUE">
          <block type="text" id="txt_empty"><field name="TEXT"></field></block>
        </value>
        <next>
          <block type="controls_for" id="loop_star">
            <field name="VAR" id="var_i">i</field>
            <value name="FROM"><shadow type="math_number" id="f1"><field name="NUM">1</field></shadow></value>
            <value name="TO"><block type="variables_get" id="gN1"><field name="VAR" id="var_N">N</field></block></value>
            <value name="BY"><shadow type="math_number" id="b1"><field name="NUM">1</field></shadow></value>
            <statement name="DO">
              <block type="variables_set" id="append_star">
                <field name="VAR" id="var_ans">ans</field>
                <value name="VALUE">
                  <block type="text_join" id="join_star">
                    <mutation items="2"></mutation>
                    <value name="ADD0"><block type="variables_get" id="gans1"><field name="VAR" id="var_ans">ans</field></block></value>
                    <value name="ADD1"><block type="text" id="star_str"><field name="TEXT">*</field></block></value>
                  </block>
                </value>
              </block>
            </statement>
            <next>
              <block type="text_print" id="print">
                <value name="TEXT">
                  <block type="variables_get" id="gans2"><field name="VAR" id="var_ans">ans</field></block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>