<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_y">year</variable>
  </variables>
  <block type="variables_set" id="init_y" x="20" y="20">
    <field name="VAR" id="var_y">year</field>
    <value name="VALUE">
      <block type="text_prompt_ext" id="prompt_y">
        <mutation type="NUMBER"></mutation>
        <field name="TYPE">NUMBER</field>
      </block>
    </value>
    <next>
      <block type="controls_if" id="if_leap">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="logic_operation" id="or_op">
            <field name="OP">OR</field>
            <value name="A">
              <block type="logic_operation" id="and_op">
                <field name="OP">AND</field>
                <value name="A">
                  <block type="logic_compare" id="cmp_mod4">
                    <field name="OP">EQ</field>
                    <value name="A">
                      <block type="math_modulo" id="mod4">
                        <field name="OP">MOD</field>
                        <value name="DIVIDEND">
                          <block type="variables_get" id="gy1"><field name="VAR" id="var_y">year</field></block>
                        </value>
                        <value name="DIVISOR">
                          <shadow type="math_number" id="num4"><field name="NUM">4</field></shadow>
                        </value>
                      </block>
                    </value>
                    <value name="B">
                      <shadow type="math_number" id="num0_1"><field name="NUM">0</field></shadow>
                    </value>
                  </block>
                </value>
                <value name="B">
                  <block type="logic_compare" id="cmp_mod100">
                    <field name="OP">NEQ</field>
                    <value name="A">
                      <block type="math_modulo" id="mod100">
                        <field name="OP">MOD</field>
                        <value name="DIVIDEND">
                          <block type="variables_get" id="gy2"><field name="VAR" id="var_y">year</field></block>
                        </value>
                        <value name="DIVISOR">
                          <shadow type="math_number" id="num100"><field name="NUM">100</field></shadow>
                        </value>
                      </block>
                    </value>
                    <value name="B">
                      <shadow type="math_number" id="num0_2"><field name="NUM">0</field></shadow>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <value name="B">
              <block type="logic_compare" id="cmp_mod400">
                <field name="OP">EQ</field>
                <value name="A">
                  <block type="math_modulo" id="mod400">
                    <field name="OP">MOD</field>
                    <value name="DIVIDEND">
                      <block type="variables_get" id="gy3"><field name="VAR" id="var_y">year</field></block>
                    </value>
                    <value name="DIVISOR">
                      <shadow type="math_number" id="num400"><field name="NUM">400</field></shadow>
                    </value>
                  </block>
                </value>
                <value name="B">
                  <shadow type="math_number" id="num0_3"><field name="NUM">0</field></shadow>
                </value>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="text_print" id="print_yes">
            <value name="TEXT">
              <shadow type="text" id="txt_yes"><field name="TEXT">yes</field></shadow>
            </value>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="text_print" id="print_no">
            <value name="TEXT">
              <shadow type="text" id="txt_no"><field name="TEXT">no</field></shadow>
            </value>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>