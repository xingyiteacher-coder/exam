<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_n">N</variable>
    <variable id="var_line">line</variable>
    <variable id="var_pos">pos</variable>
    <variable id="var_val">val</variable>
    <variable id="var_lst">list</variable>
  </variables>
  <block type="variables_set" id="init_n" x="20" y="20">
    <field name="VAR" id="var_n">N</field>
    <value name="VALUE">
      <block type="text_prompt_ext" id="prompt_n">
        <mutation type="NUMBER"></mutation>
        <field name="TYPE">NUMBER</field>
      </block>
    </value>
    <next>
      <block type="variables_set" id="init_line">
        <field name="VAR" id="var_line">line</field>
        <value name="VALUE">
          <block type="text_prompt_ext" id="prompt_line">
            <mutation type="TEXT"></mutation>
            <field name="TYPE">TEXT</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="init_pos">
            <field name="VAR" id="var_pos">pos</field>
            <value name="VALUE">
              <block type="text_prompt_ext" id="prompt_pos">
                <mutation type="NUMBER"></mutation>
                <field name="TYPE">NUMBER</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="init_val">
                <field name="VAR" id="var_val">val</field>
                <value name="VALUE">
                  <block type="text_prompt_ext" id="prompt_val">
                    <mutation type="TEXT"></mutation>
                    <field name="TYPE">TEXT</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="split_lst">
                    <field name="VAR" id="var_lst">list</field>
                    <value name="VALUE">
                      <block type="lists_split" id="split_space">
                        <mutation mode="SPLIT"></mutation>
                        <field name="MODE">SPLIT</field>
                        <value name="INPUT">
                          <block type="variables_get" id="gline"><field name="VAR" id="var_line">line</field></block>
                        </value>
                        <value name="DELIM">
                          <shadow type="text" id="delim_sp"><field name="TEXT"> </field></shadow>
                        </value>
                      </block>
                    </value>
                    <next>
                      <block type="lists_setIndex" id="insert_val">
                        <mutation at="true" statement="true"></mutation>
                        <field name="MODE">INSERT</field>
                        <field name="WHERE">FROM_START</field>
                        <value name="LIST">
                          <block type="variables_get" id="glst1"><field name="VAR" id="var_lst">list</field></block>
                        </value>
                        <value name="AT">
                          <block type="math_arithmetic" id="pos_plus1">
                            <field name="OP">ADD</field>
                            <value name="A">
                              <block type="variables_get" id="gpos"><field name="VAR" id="var_pos">pos</field></block>
                            </value>
                            <value name="B">
                              <shadow type="math_number" id="num1"><field name="NUM">1</field></shadow>
                            </value>
                          </block>
                        </value>
                        <value name="TO">
                          <block type="variables_get" id="gval"><field name="VAR" id="var_val">val</field></block>
                        </value>
                        <next>
                          <block type="text_print" id="print">
                            <value name="TEXT">
                              <block type="lists_split" id="join_space">
                                <mutation mode="JOIN"></mutation>
                                <field name="MODE">JOIN</field>
                                <value name="INPUT">
                                  <block type="variables_get" id="glst2"><field name="VAR" id="var_lst">list</field></block>
                                </value>
                                <value name="DELIM">
                                  <shadow type="text" id="delim_sp2"><field name="TEXT"> </field></shadow>
                                </value>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>