<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_N">N</variable>
    <variable id="var_sum">sum</variable>
    <variable id="var_x">x</variable>
    <variable id="var_i">i</variable>
  </variables>
  <block type="variables_set" id="init_N" x="20" y="20">
    <field name="VAR" id="var_N">N</field>
    <value name="VALUE">
      <block type="math_arithmetic" id="cast_N">
        <field name="OP">MULTIPLY</field>
        <value name="A">
          <block type="text_prompt_ext" id="prompt_N">
            <mutation type="NUMBER"></mutation>
            <field name="TYPE">NUMBER</field>
          </block>
        </value>
        <value name="B"><shadow type="math_number" id="num1_1"><field name="NUM">1</field></shadow></value>
      </block>
    </value>
    <next>
      <block type="variables_set" id="init_sum">
        <field name="VAR" id="var_sum">sum</field>
        <value name="VALUE"><shadow type="math_number" id="num0_1"><field name="NUM">0</field></shadow></value>
        <next>
          <block type="controls_for" id="loop_input">
            <field name="VAR" id="var_i">i</field>
            <value name="FROM"><shadow type="math_number" id="f1"><field name="NUM">1</field></shadow></value>
            <value name="TO"><block type="variables_get" id="gN1"><field name="VAR" id="var_N">N</field></block></value>
            <value name="BY"><shadow type="math_number" id="b1"><field name="NUM">1</field></shadow></value>
            <statement name="DO">
              <block type="variables_set" id="read_x">
                <field name="VAR" id="var_x">x</field>
                <value name="VALUE">
                  <block type="math_arithmetic" id="cast_x">
                    <field name="OP">MULTIPLY</field>
                    <value name="A">
                      <block type="text_prompt_ext" id="prompt_x">
                        <mutation type="NUMBER"></mutation>
                        <field name="TYPE">NUMBER</field>
                      </block>
                    </value>
                    <value name="B"><shadow type="math_number" id="num1_2"><field name="NUM">1</field></shadow></value>
                  </block>
                </value>
                <next>
                  <block type="controls_if" id="check_even">
                    <value name="IF0">
                      <block type="logic_compare" id="cmp_mod">
                        <field name="OP">EQ</field>
                        <value name="A">
                          <block type="math_modulo" id="mod2">
                            <value name="DIVIDEND"><block type="variables_get" id="gx1"><field name="VAR" id="var_x">x</field></block></value>
                            <value name="DIVISOR"><shadow type="math_number" id="num2_1"><field name="NUM">2</field></shadow></value>
                          </block>
                        </value>
                        <value name="B"><shadow type="math_number" id="num0_2"><field name="NUM">0</field></shadow></value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="math_change" id="add_sum">
                        <field name="VAR" id="var_sum">sum</field>
                        <value name="DELTA"><block type="variables_get" id="gx2"><field name="VAR" id="var_x">x</field></block></value>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </statement>
            <next>
              <block type="text_print" id="print">
                <value name="TEXT"><block type="variables_get" id="gsum"><field name="VAR" id="var_sum">sum</field></block></value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>