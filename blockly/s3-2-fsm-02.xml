<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="s">s</variable>
    <variable id="max_len">max_len</variable>
    <variable id="curr_len">curr_len</variable>
    <variable id="i">i</variable>
    <variable id="curr_char">curr_char</variable>
    <variable id="prev_char">prev_char</variable>
  </variables>
  <block type="variables_set" x="20" y="20">
    <field name="VAR" id="s">s</field>
    <value name="VALUE">
      <block type="text_prompt_ext"><mutation type="TEXT"></mutation><field name="TYPE">TEXT</field></block>
    </value>
    <next>
      <block type="controls_if">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="logic_compare">
            <field name="OP">EQ</field>
            <value name="A"><block type="text_length"><value name="VALUE"><block type="variables_get"><field name="VAR" id="s">s</field></block></value></block></value>
            <value name="B"><block type="math_number"><field name="NUM">0</field></block></value>
          </block>
        </value>
        <statement name="DO0">
          <block type="text_print"><value name="TEXT"><block type="math_number"><field name="NUM">0</field></block></value></block>
        </statement>
        <statement name="ELSE">
          <block type="variables_set">
            <field name="VAR" id="max_len">max_len</field>
            <value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value>
            <next>
              <block type="variables_set">
                <field name="VAR" id="curr_len">curr_len</field>
                <value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value>
                <next>
                  <block type="controls_for">
                    <field name="VAR" id="i">i</field>
                    <value name="FROM"><block type="math_number"><field name="NUM">2</field></block></value>
                    <value name="TO"><block type="text_length"><value name="VALUE"><block type="variables_get"><field name="VAR" id="s">s</field></block></value></block></value>
                    <value name="BY"><block type="math_number"><field name="NUM">1</field></block></value>
                    <statement name="DO">
                      <block type="variables_set">
                        <field name="VAR" id="curr_char">curr_char</field>
                        <value name="VALUE">
                          <block type="text_charAt">
                            <mutation at="true"></mutation>
                            <field name="WHERE">FROM_START</field>
                            <value name="VALUE"><block type="variables_get"><field name="VAR" id="s">s</field></block></value>
                            <value name="AT"><block type="variables_get"><field name="VAR" id="i">i</field></block></value>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set">
                            <field name="VAR" id="prev_char">prev_char</field>
                            <value name="VALUE">
                              <block type="text_charAt">
                                <mutation at="true"></mutation>
                                <field name="WHERE">FROM_START</field>
                                <value name="VALUE"><block type="variables_get"><field name="VAR" id="s">s</field></block></value>
                                <value name="AT">
                                  <block type="math_arithmetic">
                                    <field name="OP">MINUS</field>
                                    <value name="A"><block type="variables_get"><field name="VAR" id="i">i</field></block></value>
                                    <value name="B"><block type="math_number"><field name="NUM">1</field></block></value>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <next>
                              <block type="controls_if">
                                <mutation else="1"></mutation>
                                <value name="IF0">
                                  <block type="logic_compare">
                                    <field name="OP">EQ</field>
                                    <value name="A"><block type="variables_get"><field name="VAR" id="curr_char">curr_char</field></block></value>
                                    <value name="B"><block type="variables_get"><field name="VAR" id="prev_char">prev_char</field></block></value>
                                  </block>
                                </value>
                                <statement name="DO0">
                                  <block type="variables_set">
                                    <field name="VAR" id="curr_len">curr_len</field>
                                    <value name="VALUE">
                                      <block type="math_arithmetic">
                                        <field name="OP">ADD</field>
                                        <value name="A"><block type="variables_get"><field name="VAR" id="curr_len">curr_len</field></block></value>
                                        <value name="B"><block type="math_number"><field name="NUM">1</field></block></value>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="controls_if">
                                        <value name="IF0">
                                          <block type="logic_compare">
                                            <field name="OP">GT</field>
                                            <value name="A"><block type="variables_get"><field name="VAR" id="curr_len">curr_len</field></block></value>
                                            <value name="B"><block type="variables_get"><field name="VAR" id="max_len">max_len</field></block></value>
                                          </block>
                                        </value>
                                        <statement name="DO0">
                                          <block type="variables_set">
                                            <field name="VAR" id="max_len">max_len</field>
                                            <value name="VALUE"><block type="variables_get"><field name="VAR" id="curr_len">curr_len</field></block></value>
                                          </block>
                                        </statement>
                                      </block>
                                    </next>
                                  </block>
                                </statement>
                                <statement name="ELSE">
                                  <block type="variables_set">
                                    <field name="VAR" id="curr_len">curr_len</field>
                                    <value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value>
                                  </block>
                                </statement>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <block type="text_print">
                        <value name="TEXT"><block type="variables_get"><field name="VAR" id="max_len">max_len</field></block></value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>