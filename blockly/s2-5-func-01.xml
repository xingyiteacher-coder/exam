<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_x">x</variable>
    <variable id="var_n">n</variable>
  </variables>
  <!-- 函式定義：square(x) -->
  <block type="procedures_defreturn" id="def_square" x="20" y="20">
    <mutation>
      <arg name="x" varid="var_x"></arg>
    </mutation>
    <field name="NAME">square</field>
    <comment pinned="false" h="80" w="160">回傳平方值</comment>
    <value name="RETURN">
      <block type="math_arithmetic" id="calc_sq">
        <field name="OP">MULTIPLY</field>
        <value name="A"><block type="variables_get" id="gx1"><field name="VAR" id="var_x">x</field></block></value>
        <value name="B"><block type="variables_get" id="gx2"><field name="VAR" id="var_x">x</field></block></value>
      </block>
    </value>
  </block>
  <!-- 主程式 -->
  <block type="variables_set" id="init_n" x="20" y="150">
    <field name="VAR" id="var_n">n</field>
    <value name="VALUE">
      <block type="math_arithmetic" id="cast_n">
        <field name="OP">ADD</field>
        <value name="A">
          <block type="text_prompt_ext" id="prompt_n">
            <mutation type="NUMBER"></mutation>
            <field name="TYPE">NUMBER</field>
          </block>
        </value>
        <value name="B"><shadow type="math_number" id="num0"><field name="NUM">0</field></shadow></value>
      </block>
    </value>
    <next>
      <block type="text_print" id="print">
        <value name="TEXT">
          <block type="procedures_callreturn" id="call_sq">
            <mutation name="square">
              <arg name="x"></arg>
            </mutation>
            <value name="ARG0"><block type="variables_get" id="gn1"><field name="VAR" id="var_n">n</field></block></value>
          </block>
        </value>
      </block>
    </next>
  </block>
</xml>