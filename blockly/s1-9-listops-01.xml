<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_n">N</variable>
    <variable id="var_line">line</variable>
    <variable id="var_lst">list</variable>
  </variables>
  <block type="variables_set" id="init_n" x="20" y="20">
    <field name="VAR" id="var_n">N</field>
    <value name="VALUE">
      <block type="text_prompt_ext" id="prompt_n">
        <mutation type="NUMBER"></mutation>
        <field name="TYPE">NUMBER</field>
      </block>
    </value>
    <next>
      <block type="variables_set" id="init_line">
        <field name="VAR" id="var_line">line</field>
        <value name="VALUE">
          <block type="text_prompt_ext" id="prompt_line">
            <mutation type="TEXT"></mutation>
            <field name="TYPE">TEXT</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="split_lst">
            <field name="VAR" id="var_lst">list</field>
            <value name="VALUE">
              <block type="lists_split" id="split_space">
                <mutation mode="SPLIT"></mutation>
                <field name="MODE">SPLIT</field>
                <value name="INPUT">
                  <block type="variables_get" id="gline"><field name="VAR" id="var_line">line</field></block>
                </value>
                <value name="DELIM">
                  <shadow type="text" id="delim_sp"><field name="TEXT"> </field></shadow>
                </value>
              </block>
            </value>
            <next>
              <block type="text_print" id="print">
                <value name="TEXT">
                  <block type="lists_split" id="join_space">
                    <mutation mode="JOIN"></mutation>
                    <field name="MODE">JOIN</field>
                    <value name="INPUT">
                      <block type="lists_reverse" id="rev_lst">
                        <value name="LIST">
                          <block type="variables_get" id="glst"><field name="VAR" id="var_lst">list</field></block>
                        </value>
                      </block>
                    </value>
                    <value name="DELIM">
                      <shadow type="text" id="delim_sp2"><field name="TEXT"> </field></shadow>
                    </value>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>