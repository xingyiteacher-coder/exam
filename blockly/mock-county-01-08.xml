<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_list">scores</variable>
  </variables>
  <block type="variables_set" id="init" x="20" y="20">
    <field name="VAR" id="var_list">scores</field>
    <value name="VALUE">
      <block type="lists_sort" id="sort">
        <field name="TYPE">NUMERIC</field>
        <field name="DIRECTION">-1</field>
        <value name="LIST">
          <block type="text_prompt_ext" id="prompt_list">
            <mutation type="TEXT"></mutation>
            <field name="TYPE">TEXT</field>
          </block>
        </value>
      </block>
    </value>
    <next>
      <block type="text_print" id="print">
        <value name="TEXT">
          <block type="variables_get" id="get_list"><field name="VAR" id="var_list">scores</field></block>
        </value>
      </block>
    </next>
  </block>
</xml>