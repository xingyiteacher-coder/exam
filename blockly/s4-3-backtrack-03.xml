<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_n">n</variable>
    <variable id="var_k">k</variable>
    <variable id="var_ans_count">ans_count</variable>
    <variable id="var_idx">idx</variable>
    <variable id="var_chosen_count">chosen_count</variable>
    <variable id="var_raw_line">raw_line</variable>
    <variable id="var_parts">parts</variable>
  </variables>

  <!-- 函式定義：solve(idx, chosen_count) -->
  <block type="procedures_defnoreturn" id="proc_solve" x="20" y="20">
    <mutation>
      <arg name="idx" varid="var_idx"></arg>
      <arg name="chosen_count" varid="var_chosen_count"></arg>
    </mutation>
    <field name="NAME">solve</field>
    <comment pinned="false" h="80" w="160">組合回溯搜尋</comment>
    <statement name="STACK">
      <block type="controls_if" id="if_check_k">
        <mutation else="1"></mutation>
        <!-- 條件：已選取數量 chosen_count == k -->
        <value name="IF0">
          <block type="logic_compare" id="cmp_cc_eq_k">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="variables_get" id="get_cc1">
                <field name="VAR" id="var_chosen_count">chosen_count</field>
              </block>
            </value>
            <value name="B">
              <block type="variables_get" id="get_k_proc1">
                <field name="VAR" id="var_k">k</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <!-- 找到合法組合，計數加 1 -->
          <block type="variables_set" id="set_inc_ans">
            <field name="VAR" id="var_ans_count">ans_count</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="add_ans1">
                <field name="OP">ADD</field>
                <value name="A">
                  <block type="variables_get" id="get_ans1">
                    <field name="VAR" id="var_ans_count">ans_count</field>
                  </block>
                </value>
                <value name="B">
                  <block type="math_number" id="num_1_ans">
                    <field name="NUM">1</field>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </statement>
        <statement name="ELSE">
          <!-- 剪枝與範圍檢查：idx <= n 且 (chosen_count + (n - idx + 1)) >= k -->
          <block type="controls_if" id="if_valid_bound">
            <value name="IF0">
              <block type="logic_operation" id="log_and1">
                <field name="OP">AND</field>
                <value name="A">
                  <block type="logic_compare" id="cmp_idx_lte_n">
                    <field name="OP">LTE</field>
                    <value name="A">
                      <block type="variables_get" id="get_idx1">
                        <field name="VAR" id="var_idx">idx</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="variables_get" id="get_n_proc1">
                        <field name="VAR" id="var_n">n</field>
                      </block>
                    </value>
                  </block>
                </value>
                <value name="B">
                  <block type="logic_compare" id="cmp_prune">
                    <field name="OP">GTE</field>
                    <value name="A">
                      <block type="math_arithmetic" id="add_prune1">
                        <field name="OP">ADD</field>
                        <value name="A">
                          <block type="variables_get" id="get_cc2">
                            <field name="VAR" id="var_chosen_count">chosen_count</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_arithmetic" id="add_rem1">
                            <field name="OP">ADD</field>
                            <value name="A">
                              <block type="math_arithmetic" id="sub_n_idx">
                                <field name="OP">MINUS</field>
                                <value name="A">
                                  <block type="variables_get" id="get_n_proc2">
                                    <field name="VAR" id="var_n">n</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="variables_get" id="get_idx2">
                                    <field name="VAR" id="var_idx">idx</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_number" id="num_1_rem">
                                <field name="NUM">1</field>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                    <value name="B">
                      <block type="variables_get" id="get_k_proc2">
                        <field name="VAR" id="var_k">k</field>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <!-- 分支 1：選擇第 idx 個物品 -->
              <block type="procedures_callnoreturn" id="call_pick">
                <mutation name="solve">
                  <arg name="idx"></arg>
                  <arg name="chosen_count"></arg>
                </mutation>
                <value name="ARG0">
                  <block type="math_arithmetic" id="add_idx1">
                    <field name="OP">ADD</field>
                    <value name="A">
                      <block type="variables_get" id="get_idx3">
                        <field name="VAR" id="var_idx">idx</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number" id="num_1a">
                        <field name="NUM">1</field>
                      </block>
                    </value>
                  </block>
                </value>
                <value name="ARG1">
                  <block type="math_arithmetic" id="add_cc_pick">
                    <field name="OP">ADD</field>
                    <value name="A">
                      <block type="variables_get" id="get_cc3">
                        <field name="VAR" id="var_chosen_count">chosen_count</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number" id="num_1b">
                        <field name="NUM">1</field>
                      </block>
                    </value>
                  </block>
                </value>
                <next>
                  <!-- 分支 2：不選擇第 idx 個物品 -->
                  <block type="procedures_callnoreturn" id="call_skip">
                    <mutation name="solve">
                      <arg name="idx"></arg>
                      <arg name="chosen_count"></arg>
                    </mutation>
                    <value name="ARG0">
                      <block type="math_arithmetic" id="add_idx2">
                        <field name="OP">ADD</field>
                        <value name="A">
                          <block type="variables_get" id="get_idx4">
                            <field name="VAR" id="var_idx">idx</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number" id="num_1c">
                            <field name="NUM">1</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <value name="ARG1">
                      <block type="variables_get" id="get_cc4">
                        <field name="VAR" id="var_chosen_count">chosen_count</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </statement>
          </block>
        </statement>
      </block>
    </statement>
  </block>

  <!-- 主程式進入點 -->
  <block type="variables_set" id="set_raw" x="20" y="420">
    <field name="VAR" id="var_raw_line">raw_line</field>
    <value name="VALUE">
      <block type="text_prompt_ext" id="prompt_line1">
        <mutation type="TEXT"></mutation>
        <field name="TYPE">TEXT</field>
        <value name="TEXT">
          <block type="text" id="t_empty1">
            <field name="TEXT"></field>
          </block>
        </value>
      </block>
    </value>
    <next>
      <block type="variables_set" id="set_parts">
        <field name="VAR" id="var_parts">parts</field>
        <value name="VALUE">
          <block type="lists_split" id="split_line">
            <mutation mode="SPLIT"></mutation>
            <field name="MODE">SPLIT</field>
            <value name="INPUT">
              <block type="variables_get" id="get_raw1">
                <field name="VAR" id="var_raw_line">raw_line</field>
              </block>
            </value>
            <value name="DELIM">
              <shadow type="text" id="t_space">
                <field name="TEXT"> </field>
              </shadow>
            </value>
          </block>
        </value>
        <next>
          <!-- 檢查單行切分結果 -->
          <block type="controls_if" id="if_split_len">
            <mutation else="1"></mutation>
            <value name="IF0">
              <block type="logic_compare" id="cmp_len">
                <field name="OP">GTE</field>
                <value name="A">
                  <block type="lists_length" id="len_parts">
                    <value name="VALUE">
                      <block type="variables_get" id="get_parts_len">
                        <field name="VAR" id="var_parts">parts</field>
                      </block>
                    </value>
                  </block>
                </value>
                <value name="B">
                  <block type="math_number" id="num_2">
                    <field name="NUM">2</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="variables_set" id="set_n_1">
                <field name="VAR" id="var_n">n</field>
                <value name="VALUE">
                  <block type="math_single" id="abs_n1">
                    <field name="OP">ABS</field>
                    <value name="NUM">
                      <block type="lists_getIndex" id="get_p1">
                        <mutation statement="false" at="true"></mutation>
                        <field name="MODE">GET</field>
                        <field name="WHERE">FROM_START</field>
                        <value name="VALUE">
                          <block type="variables_get" id="get_parts1">
                            <field name="VAR" id="var_parts">parts</field>
                          </block>
                        </value>
                        <value name="AT">
                          <block type="math_number" id="idx_1">
                            <field name="NUM">1</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="set_k_1">
                    <field name="VAR" id="var_k">k</field>
                    <value name="VALUE">
                      <block type="math_single" id="abs_k1">
                        <field name="OP">ABS</field>
                        <value name="NUM">
                          <block type="lists_getIndex" id="get_p2">
                            <mutation statement="false" at="true"></mutation>
                            <field name="MODE">GET</field>
                            <field name="WHERE">FROM_START</field>
                            <value name="VALUE">
                              <block type="variables_get" id="get_parts2">
                                <field name="VAR" id="var_parts">parts</field>
                              </block>
                            </value>
                            <value name="AT">
                              <block type="math_number" id="idx_2">
                                <field name="NUM">2</field>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="variables_set" id="set_n_2">
                <field name="VAR" id="var_n">n</field>
                <value name="VALUE">
                  <block type="math_single" id="abs_n2">
                    <field name="OP">ABS</field>
                    <value name="NUM">
                      <block type="lists_getIndex" id="get_p1_else">
                        <mutation statement="false" at="true"></mutation>
                        <field name="MODE">GET</field>
                        <field name="WHERE">FROM_START</field>
                        <value name="VALUE">
                          <block type="variables_get" id="get_parts3">
                            <field name="VAR" id="var_parts">parts</field>
                          </block>
                        </value>
                        <value name="AT">
                          <block type="math_number" id="idx_1_else">
                            <field name="NUM">1</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="set_k_2">
                    <field name="VAR" id="var_k">k</field>
                    <value name="VALUE">
                      <block type="text_prompt_ext" id="prompt_k2">
                        <mutation type="NUMBER"></mutation>
                        <field name="TYPE">NUMBER</field>
                        <value name="TEXT">
                          <block type="text" id="t_empty2">
                            <field name="TEXT"></field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </statement>
            <next>
              <!-- 初始化 ans_count = 0 -->
              <block type="variables_set" id="set_ans_0">
                <field name="VAR" id="var_ans_count">ans_count</field>
                <value name="VALUE">
                  <block type="math_number" id="num_ans_0">
                    <field name="NUM">0</field>
                  </block>
                </value>
                <next>
                  <!-- 呼叫 solve(1, 0) 開始回溯 -->
                  <block type="procedures_callnoreturn" id="start_solve">
                    <mutation name="solve">
                      <arg name="idx"></arg>
                      <arg name="chosen_count"></arg>
                    </mutation>
                    <value name="ARG0">
                      <block type="math_number" id="num_start_idx">
                        <field name="NUM">1</field>
                      </block>
                    </value>
                    <value name="ARG1">
                      <block type="math_number" id="num_start_cc">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                    <next>
                      <!-- 輸出結果 -->
                      <block type="text_print" id="print_ans">
                        <value name="TEXT">
                          <block type="variables_get" id="get_ans_final">
                            <field name="VAR" id="var_ans_count">ans_count</field>
                          </block>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>