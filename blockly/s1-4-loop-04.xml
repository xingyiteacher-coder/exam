<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_n">N</variable>
    <variable id="var_sum">sum</variable>
    <variable id="var_i">i</variable>
  </variables>
  <block type="variables_set" id="init_n" x="20" y="20">
    <field name="VAR" id="var_n">N</field>
    <value name="VALUE">
      <block type="text_prompt_ext" id="prompt_n">
        <mutation type="NUMBER"></mutation>
        <field name="TYPE">NUMBER</field>
      </block>
    </value>
    <next>
      <block type="variables_set" id="init_sum">
        <field name="VAR" id="var_sum">sum</field>
        <value name="VALUE">
          <block type="math_number" id="num0"><field name="NUM">0</field></block>
        </value>
        <next>
          <block type="variables_set" id="init_i">
            <field name="VAR" id="var_i">i</field>
            <value name="VALUE">
              <block type="math_number" id="num2"><field name="NUM">2</field></block>
            </value>
            <next>
              <block type="controls_whileUntil" id="loop_even">
                <field name="MODE">WHILE</field>
                <value name="BOOL">
                  <block type="logic_compare" id="cmp_i_n">
                    <field name="OP">LTE</field>
                    <value name="A">
                      <block type="variables_get" id="gi1"><field name="VAR" id="var_i">i</field></block>
                    </value>
                    <value name="B">
                      <block type="variables_get" id="gn1"><field name="VAR" id="var_n">N</field></block>
                    </value>
                  </block>
                </value>
                <statement name="DO">
                  <block type="math_change" id="add_i">
                    <field name="VAR" id="var_sum">sum</field>
                    <value name="DELTA">
                      <block type="variables_get" id="gi2"><field name="VAR" id="var_i">i</field></block>
                    </value>
                    <next>
                      <block type="math_change" id="inc_i2">
                        <field name="VAR" id="var_i">i</field>
                        <value name="DELTA">
                          <shadow type="math_number" id="step2"><field name="NUM">2</field></shadow>
                        </value>
                      </block>
                    </next>
                  </block>
                </statement>
                <next>
                  <block type="text_print" id="print">
                    <value name="TEXT">
                      <block type="variables_get" id="gsum"><field name="VAR" id="var_sum">sum</field></block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>