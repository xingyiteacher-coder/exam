<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="s">s</variable>
    <variable id="stack">stack</variable>
    <variable id="res">res</variable>
    <variable id="i">i</variable>
  </variables>
  <block type="variables_set" x="20" y="20">
    <field name="VAR" id="s">s</field>
    <value name="VALUE">
      <block type="text_prompt_ext"><mutation type="TEXT"></mutation><field name="TYPE">TEXT</field></block>
    </value>
    <next>
      <block type="variables_set">
        <field name="VAR" id="stack">stack</field>
        <value name="VALUE"><block type="lists_create_empty"></block></value>
        <next>
          <block type="variables_set">
            <field name="VAR" id="res">res</field>
            <value name="VALUE"><block type="text"><field name="TEXT"></field></block></value>
            <next>
              <block type="controls_for">
                <field name="VAR" id="i">i</field>
                <value name="FROM"><block type="math_number"><field name="NUM">1</field></block></value>
                <value name="TO"><block type="text_length"><value name="VALUE"><block type="variables_get"><field name="VAR" id="s">s</field></block></value></block></value>
                <value name="BY"><block type="math_number"><field name="NUM">1</field></block></value>
                <statement name="DO">
                  <block type="lists_setIndex">
                    <mutation at="false"></mutation>
                    <field name="MODE">INSERT</field>
                    <field name="WHERE">LAST</field>
                    <value name="LIST"><block type="variables_get"><field name="VAR" id="stack">stack</field></block></value>
                    <value name="TO">
                      <block type="text_charAt">
                        <mutation at="true"></mutation>
                        <field name="WHERE">FROM_START</field>
                        <value name="VALUE"><block type="variables_get"><field name="VAR" id="s">s</field></block></value>
                        <value name="AT"><block type="variables_get"><field name="VAR" id="i">i</field></block></value>
                      </block>
                    </value>
                  </block>
                </statement>
                <next>
                  <block type="controls_whileUntil">
                    <field name="MODE">WHILE</field>
                    <value name="BOOL">
                      <block type="logic_negate">
                        <value name="BOOL"><block type="lists_isEmpty"><value name="VALUE"><block type="variables_get"><field name="VAR" id="stack">stack</field></block></value></block></value>
                      </block>
                    </value>
                    <statement name="DO">
                      <block type="variables_set">
                        <field name="VAR" id="res">res</field>
                        <value name="VALUE">
                          <block type="text_join">
                            <mutation items="2"></mutation>
                            <value name="ADD0"><block type="variables_get"><field name="VAR" id="res">res</field></block></value>
                            <value name="ADD1">
                              <block type="lists_getIndex">
                                <mutation statement="false" at="false"></mutation>
                                <field name="MODE">GET_REMOVE</field>
                                <field name="WHERE">LAST</field>
                                <value name="VALUE"><block type="variables_get"><field name="VAR" id="stack">stack</field></block></value>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </statement>
                    <next>
                      <block type="text_print">
                        <value name="TEXT"><block type="variables_get"><field name="VAR" id="res">res</field></block></value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>