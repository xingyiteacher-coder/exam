<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_n">n</variable>
    <variable id="var_i">i</variable>
    <variable id="var_res">res</variable>
  </variables>
  <!-- 函式定義：isPrime(n) -->
  <block type="procedures_defreturn" id="def_prime" x="20" y="20">
    <mutation>
      <arg name="n" varid="var_n"></arg>
    </mutation>
    <field name="NAME">isPrime</field>
    <statement name="STACK">
      <block type="controls_if" id="check_lt_2">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="logic_compare" id="cmp_lt_2">
            <field name="OP">LT</field>
            <value name="A"><block type="variables_get" id="gn1"><field name="VAR" id="var_n">n</field></block></value>
            <value name="B"><shadow type="math_number" id="num2"><field name="NUM">2</field></shadow></value>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="set_false1">
            <field name="VAR" id="var_res">res</field>
            <value name="VALUE"><block type="logic_boolean" id="f1"><field name="BOOL">FALSE</field></block></value>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="controls_if" id="check_eq_2">
            <mutation else="1"></mutation>
            <value name="IF0">
              <block type="logic_compare" id="cmp_eq_2">
                <field name="OP">EQ</field>
                <value name="A"><block type="variables_get" id="gn2"><field name="VAR" id="var_n">n</field></block></value>
                <value name="B"><shadow type="math_number" id="num2_2"><field name="NUM">2</field></shadow></value>
              </block>
            </value>
            <statement name="DO0">
              <block type="variables_set" id="set_true1">
                <field name="VAR" id="var_res">res</field>
                <value name="VALUE"><block type="logic_boolean" id="t1"><field name="BOOL">TRUE</field></block></value>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="variables_set" id="init_res_true">
                <field name="VAR" id="var_res">res</field>
                <value name="VALUE"><block type="logic_boolean" id="t2"><field name="BOOL">TRUE</field></block></value>
                <next>
                  <block type="controls_for" id="loop_i">
                    <field name="VAR" id="var_i">i</field>
                    <value name="FROM"><shadow type="math_number" id="f2"><field name="NUM">2</field></shadow></value>
                    <value name="TO">
                      <block type="math_single" id="sqrt_n">
                        <field name="OP">ROOT</field>
                        <value name="NUM"><block type="variables_get" id="gn3"><field name="VAR" id="var_n">n</field></block></value>
                      </block>
                    </value>
                    <value name="BY"><shadow type="math_number" id="b1"><field name="NUM">1</field></shadow></value>
                    <statement name="DO">
                      <block type="controls_if" id="check_mod">
                        <value name="IF0">
                          <block type="logic_compare" id="cmp_mod">
                            <field name="OP">EQ</field>
                            <value name="A">
                              <block type="math_modulo" id="mod_ni">
                                <value name="DIVIDEND"><block type="variables_get" id="gn4"><field name="VAR" id="var_n">n</field></block></value>
                                <value name="DIVISOR"><block type="variables_get" id="gi1"><field name="VAR" id="var_i">i</field></block></value>
                              </block>
                            </value>
                            <value name="B"><shadow type="math_number" id="num0"><field name="NUM">0</field></shadow></value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="variables_set" id="set_false2">
                            <field name="VAR" id="var_res">res</field>
                            <value name="VALUE"><block type="logic_boolean" id="f2"><field name="BOOL">FALSE</field></block></value>
                            <next>
                              <block type="controls_flow_statements" id="break_loop">
                                <field name="FLOW">BREAK</field>
                              </block>
                            </next>
                          </block>
                        </statement>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </statement>
          </block>
        </statement>
      </block>
    </statement>
    <value name="RETURN">
      <block type="variables_get" id="gres"><field name="VAR" id="var_res">res</field></block>
    </value>
  </block>
  <!-- 主程式 -->
  <block type="variables_set" id="init_main_n" x="20" y="480">
    <field name="VAR" id="var_n">n</field>
    <value name="VALUE">
      <block type="math_arithmetic" id="cast_n">
        <field name="OP">ADD</field>
        <value name="A">
          <block type="text_prompt_ext" id="prompt_n">
            <mutation type="NUMBER"></mutation>
            <field name="TYPE">NUMBER</field>
          </block>
        </value>
        <value name="B"><shadow type="math_number" id="n0_1"><field name="NUM">0</field></shadow></value>
      </block>
    </value>
    <next>
      <block type="controls_if" id="check_p">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="procedures_callreturn" id="call_prime">
            <mutation name="isPrime">
              <arg name="n"></arg>
            </mutation>
            <value name="ARG0"><block type="variables_get" id="gn5"><field name="VAR" id="var_n">n</field></block></value>
          </block>
        </value>
        <statement name="DO0">
          <block type="text_print" id="p_yes">
            <value name="TEXT"><shadow type="text" id="t_yes"><field name="TEXT">yes</field></shadow></value>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="text_print" id="p_no">
            <value name="TEXT"><shadow type="text" id="t_no"><field name="TEXT">no</field></shadow></value>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>