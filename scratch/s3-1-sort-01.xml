<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="aa_N" islocal="false" iscloud="false">N</variable>
    <variable type="" id="aa_i" islocal="false" iscloud="false">i</variable>
    <variable type="" id="aa_j" islocal="false" iscloud="false">j</variable>
    <variable type="" id="aa_temp" islocal="false" iscloud="false">temp</variable>
    <variable type="" id="aa_res" islocal="false" iscloud="false">結果</variable>
    <variable type="list" id="aa_list" islocal="false" iscloud="false">數列</variable>
  </variables>

  <!-- 主程式 -->
  <block type="event_whenflagclicked" id="start_flag" x="10" y="10">
    <next>
      <block type="scratch_ask" id="ask_N">
        <value name="QUESTION">
          <shadow type="text" id="shd_ask_N"><field name="TEXT">N</field></shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_N">
            <field name="VARIABLE" id="aa_N" variabletype="">N</field>
            <value name="VALUE">
              <shadow type="text" id="shd_N_0"><field name="TEXT">0</field></shadow>
              <block type="scratch_answer" id="get_ans_N"></block>
            </value>
            <next>
              <block type="data_deletealloflist" id="del_list">
                <field name="LIST" id="aa_list" variabletype="list">數列</field>
                <next>
                  <block type="control_repeat" id="loop_input">
                    <value name="TIMES">
                      <block type="data_variable" id="var_N1">
                        <field name="VARIABLE" id="aa_N" variabletype="">N</field>
                      </block>
                    </value>
                    <statement name="SUBSTACK">
                      <block type="scratch_ask" id="ask_elem">
                        <value name="QUESTION">
                          <shadow type="text" id="shd_ask_elem"><field name="TEXT">元素</field></shadow>
                        </value>
                        <next>
                          <block type="data_addtolist" id="add_item">
                            <field name="LIST" id="aa_list" variabletype="list">數列</field>
                            <value name="ITEM">
                              <shadow type="text" id="shd_item_def"><field name="TEXT">thing</field></shadow>
                              <block type="scratch_answer" id="get_ans_elem"></block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <!-- 氣泡排序外層迴圈 -->
                      <block type="data_setvariableto" id="set_i_1">
                        <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                        <value name="VALUE">
                          <shadow type="text" id="shd_i1"><field name="TEXT">1</field></shadow>
                        </value>
                        <next>
                          <block type="control_repeat" id="outer_loop">
                            <value name="TIMES">
                              <block type="operator_arithmetic" id="sub_N_1">
                                <field name="OPERATOR">-</field>
                                <value name="NUM1">
                                  <shadow type="math_number" id="shd_n1"><field name="NUM">0</field></shadow>
                                  <block type="data_variable" id="var_N2">
                                    <field name="VARIABLE" id="aa_N" variabletype="">N</field>
                                  </block>
                                </value>
                                <value name="NUM2">
                                  <shadow type="math_number" id="shd_1_1"><field name="NUM">1</field></shadow>
                                </value>
                              </block>
                            </value>
                            <statement name="SUBSTACK">
                              <!-- 內層迴圈：j 從 1 到 N - i -->
                              <block type="data_setvariableto" id="set_j_1">
                                <field name="VARIABLE" id="aa_j" variabletype="">j</field>
                                <value name="VALUE">
                                  <shadow type="text" id="shd_j1"><field name="TEXT">1</field></shadow>
                                </value>
                                <next>
                                  <block type="control_repeat" id="inner_loop">
                                    <value name="TIMES">
                                      <block type="operator_arithmetic" id="sub_N_i">
                                        <field name="OPERATOR">-</field>
                                        <value name="NUM1">
                                          <shadow type="math_number" id="shd_n2"><field name="NUM">0</field></shadow>
                                          <block type="data_variable" id="var_N3">
                                            <field name="VARIABLE" id="aa_N" variabletype="">N</field>
                                          </block>
                                        </value>
                                        <value name="NUM2">
                                          <shadow type="math_number" id="shd_i_var"><field name="NUM">0</field></shadow>
                                          <block type="data_variable" id="var_i1">
                                            <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <statement name="SUBSTACK">
                                      <block type="control_if" id="check_swap">
                                        <value name="CONDITION">
                                          <block type="operator_compare" id="cmp_gt">
                                            <field name="OPERATOR">&gt;</field>
                                            <value name="OPERAND1">
                                              <block type="data_itemoflist" id="get_item_j">
                                                <field name="LIST" id="aa_list" variabletype="list">數列</field>
                                                <value name="INDEX">
                                                  <block type="data_variable" id="var_j1">
                                                    <field name="VARIABLE" id="aa_j" variabletype="">j</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <value name="OPERAND2">
                                              <block type="data_itemoflist" id="get_item_jp1">
                                                <field name="LIST" id="aa_list" variabletype="list">數列</field>
                                                <value name="INDEX">
                                                  <block type="operator_arithmetic" id="add_j_1">
                                                    <field name="OPERATOR">+</field>
                                                    <value name="NUM1">
                                                      <shadow type="math_number" id="shd_j_num"><field name="NUM">0</field></shadow>
                                                      <block type="data_variable" id="var_j2">
                                                        <field name="VARIABLE" id="aa_j" variabletype="">j</field>
                                                      </block>
                                                    </value>
                                                    <value name="NUM2">
                                                      <shadow type="math_number" id="shd_1_2"><field name="NUM">1</field></shadow>
                                                    </value>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                        <statement name="SUBSTACK">
                                          <!-- 交換：temp = 數列[j] -->
                                          <block type="data_setvariableto" id="set_temp">
                                            <field name="VARIABLE" id="aa_temp" variabletype="">temp</field>
                                            <value name="VALUE">
                                              <block type="data_itemoflist" id="get_item_j_temp">
                                                <field name="LIST" id="aa_list" variabletype="list">數列</field>
                                                <value name="INDEX">
                                                  <block type="data_variable" id="var_j3">
                                                    <field name="VARIABLE" id="aa_j" variabletype="">j</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <next>
                                              <!-- 數列[j] = 數列[j+1] -->
                                              <block type="data_replaceitemoflist" id="replace_j">
                                                <field name="LIST" id="aa_list" variabletype="list">數列</field>
                                                <value name="INDEX">
                                                  <block type="data_variable" id="var_j4">
                                                    <field name="VARIABLE" id="aa_j" variabletype="">j</field>
                                                  </block>
                                                </value>
                                                <value name="ITEM">
                                                  <block type="data_itemoflist" id="get_item_jp1_swap">
                                                    <field name="LIST" id="aa_list" variabletype="list">數列</field>
                                                    <value name="INDEX">
                                                      <block type="operator_arithmetic" id="add_j_1_swap">
                                                        <field name="OPERATOR">+</field>
                                                        <value name="NUM1">
                                                          <shadow type="math_number" id="shd_j_num2"><field name="NUM">0</field></shadow>
                                                          <block type="data_variable" id="var_j5">
                                                            <field name="VARIABLE" id="aa_j" variabletype="">j</field>
                                                          </block>
                                                        </value>
                                                        <value name="NUM2">
                                                          <shadow type="math_number" id="shd_1_3"><field name="NUM">1</field></shadow>
                                                        </value>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                                <next>
                                                  <!-- 數列[j+1] = temp -->
                                                  <block type="data_replaceitemoflist" id="replace_jp1">
                                                    <field name="LIST" id="aa_list" variabletype="list">數列</field>
                                                    <value name="INDEX">
                                                      <block type="operator_arithmetic" id="add_j_1_idx">
                                                        <field name="OPERATOR">+</field>
                                                        <value name="NUM1">
                                                          <shadow type="math_number" id="shd_j_num3"><field name="NUM">0</field></shadow>
                                                          <block type="data_variable" id="var_j6">
                                                            <field name="VARIABLE" id="aa_j" variabletype="">j</field>
                                                          </block>
                                                        </value>
                                                        <value name="NUM2">
                                                          <shadow type="math_number" id="shd_1_4"><field name="NUM">1</field></shadow>
                                                        </value>
                                                      </block>
                                                    </value>
                                                    <value name="ITEM">
                                                      <block type="data_variable" id="var_temp1">
                                                        <field name="VARIABLE" id="aa_temp" variabletype="">temp</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </statement>
                                        <next>
                                          <block type="data_changevariableby" id="inc_j">
                                            <field name="VARIABLE" id="aa_j" variabletype="">j</field>
                                            <value name="VALUE">
                                              <shadow type="math_number" id="shd_inc_j"><field name="NUM">1</field></shadow>
                                            </value>
                                          </block>
                                        </next>
                                      </block>
                                    </statement>
                                    <next>
                                      <block type="data_changevariableby" id="inc_i">
                                        <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                        <value name="VALUE">
                                          <shadow type="math_number" id="shd_inc_i"><field name="NUM">1</field></shadow>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </statement>
                            <next>
                              <!-- 組合輸出字串：結果 = 數列[1] -->
                              <block type="data_setvariableto" id="set_res_first">
                                <field name="VARIABLE" id="aa_res" variabletype="">結果</field>
                                <value name="VALUE">
                                  <block type="data_itemoflist" id="get_item_1_res">
                                    <field name="LIST" id="aa_list" variabletype="list">數列</field>
                                    <value name="INDEX">
                                      <shadow type="math_number" id="shd_idx1"><field name="NUM">1</field></shadow>
                                    </value>
                                  </block>
                                </value>
                                <next>
                                  <block type="data_setvariableto" id="set_i_2">
                                    <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                    <value name="VALUE">
                                      <shadow type="text" id="shd_i2"><field name="TEXT">2</field></shadow>
                                    </value>
                                    <next>
                                      <block type="control_repeat" id="loop_out_str">
                                        <value name="TIMES">
                                          <block type="operator_arithmetic" id="sub_N_1_out">
                                            <field name="OPERATOR">-</field>
                                            <value name="NUM1">
                                              <shadow type="math_number" id="shd_n3"><field name="NUM">0</field></shadow>
                                              <block type="data_variable" id="var_N4">
                                                <field name="VARIABLE" id="aa_N" variabletype="">N</field>
                                              </block>
                                            </value>
                                            <value name="NUM2">
                                              <shadow type="math_number" id="shd_1_5"><field name="NUM">1</field></shadow>
                                            </value>
                                          </block>
                                        </value>
                                        <statement name="SUBSTACK">
                                          <block type="data_setvariableto" id="append_res">
                                            <field name="VARIABLE" id="aa_res" variabletype="">結果</field>
                                            <value name="VALUE">
                                              <block type="operator_join" id="join_outer">
                                                <value name="OPERAND1">
                                                  <shadow type="text" id="shd_j_o1"><field name="TEXT"></field></shadow>
                                                  <block type="operator_join" id="join_inner">
                                                    <value name="OPERAND1">
                                                      <shadow type="text" id="shd_j_i1"><field name="TEXT"></field></shadow>
                                                      <block type="data_variable" id="var_res1">
                                                        <field name="VARIABLE" id="aa_res" variabletype="">結果</field>
                                                      </block>
                                                    </value>
                                                    <value name="OPERAND2">
                                                      <shadow type="text" id="shd_space"><field name="TEXT"> </field></shadow>
                                                    </value>
                                                  </block>
                                                </value>
                                                <value name="OPERAND2">
                                                  <shadow type="text" id="shd_j_o2"><field name="TEXT"></field></shadow>
                                                  <block type="data_itemoflist" id="get_item_i_res">
                                                    <field name="LIST" id="aa_list" variabletype="list">數列</field>
                                                    <value name="INDEX">
                                                      <block type="data_variable" id="var_i_out">
                                                        <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <next>
                                              <block type="data_changevariableby" id="inc_i_out">
                                                <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                                <value name="VALUE">
                                                  <shadow type="math_number" id="shd_inc_i2"><field name="NUM">1</field></shadow>
                                                </value>
                                              </block>
                                            </next>
                                          </block>
                                        </statement>
                                        <next>
                                          <block type="scratch_say" id="say_res">
                                            <value name="TEXT">
                                              <shadow type="text" id="shd_say_def"><field name="TEXT">Hello!</field></shadow>
                                              <block type="data_variable" id="var_res_out">
                                                <field name="VARIABLE" id="aa_res" variabletype="">結果</field>
                                              </block>
                                            </value>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
