<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="v_a" islocal="false" iscloud="false">a</variable>
    <variable type="" id="v_b" islocal="false" iscloud="false">b</variable>
    <variable type="" id="v_orig_a" islocal="false" iscloud="false">原a</variable>
    <variable type="" id="v_orig_b" islocal="false" iscloud="false">原b</variable>
    <variable type="" id="v_temp" islocal="false" iscloud="false">temp</variable>
    <variable type="" id="v_lcm" islocal="false" iscloud="false">lcm</variable>
  </variables>
  <block type="event_whenflagclicked" id="flag1" x="10" y="10">
    <next>
      <block type="scratch_ask" id="ask_a">
        <value name="QUESTION">
          <shadow type="text" id="txt_a">
            <field name="TEXT">a</field>
          </shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_a">
            <field name="VARIABLE" id="v_a" variabletype="">a</field>
            <value name="VALUE">
              <block type="scratch_answer" id="ans_a"></block>
            </value>
            <next>
              <block type="scratch_ask" id="ask_b">
                <value name="QUESTION">
                  <shadow type="text" id="txt_b">
                    <field name="TEXT">b</field>
                  </shadow>
                </value>
                <next>
                  <block type="data_setvariableto" id="set_b">
                    <field name="VARIABLE" id="v_b" variabletype="">b</field>
                    <value name="VALUE">
                      <block type="scratch_answer" id="ans_b"></block>
                    </value>
                    <next>
                      <block type="data_setvariableto" id="set_orig_a">
                        <field name="VARIABLE" id="v_orig_a" variabletype="">原a</field>
                        <value name="VALUE">
                          <block type="data_variable" id="get_a_orig">
                            <field name="VARIABLE" id="v_a" variabletype="">a</field>
                          </block>
                        </value>
                        <next>
                          <block type="data_setvariableto" id="set_orig_b">
                            <field name="VARIABLE" id="v_orig_b" variabletype="">原b</field>
                            <value name="VALUE">
                              <block type="data_variable" id="get_b_orig">
                                <field name="VARIABLE" id="v_b" variabletype="">b</field>
                              </block>
                            </value>
                            <next>
                              <block type="control_repeat_until" id="loop_gcd">
                                <value name="CONDITION">
                                  <block type="operator_compare" id="cmp_b_zero">
                                    <field name="OPERATOR">&gt;</field>
                                    <value name="OPERAND1">
                                      <shadow type="math_number" id="num_one">
                                        <field name="NUM">1</field>
                                      </shadow>
                                    </value>
                                    <value name="OPERAND2">
                                      <block type="data_variable" id="get_b_cmp">
                                        <field name="VARIABLE" id="v_b" variabletype="">b</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="SUBSTACK">
                                  <block type="data_setvariableto" id="set_temp">
                                    <field name="VARIABLE" id="v_temp" variabletype="">temp</field>
                                    <value name="VALUE">
                                      <block type="operator_mod" id="mod_ab">
                                        <value name="NUM1">
                                          <block type="data_variable" id="get_a_mod">
                                            <field name="VARIABLE" id="v_a" variabletype="">a</field>
                                          </block>
                                        </value>
                                        <value name="NUM2">
                                          <block type="data_variable" id="get_b_mod">
                                            <field name="VARIABLE" id="v_b" variabletype="">b</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="data_setvariableto" id="set_a_b">
                                        <field name="VARIABLE" id="v_a" variabletype="">a</field>
                                        <value name="VALUE">
                                          <block type="data_variable" id="get_b_seta">
                                            <field name="VARIABLE" id="v_b" variabletype="">b</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="data_setvariableto" id="set_b_temp">
                                            <field name="VARIABLE" id="v_b" variabletype="">b</field>
                                            <value name="VALUE">
                                              <block type="data_variable" id="get_temp_setb">
                                                <field name="VARIABLE" id="v_temp" variabletype="">temp</field>
                                              </block>
                                            </value>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </statement>
                                <next>
                                  <block type="data_setvariableto" id="calc_lcm">
                                    <field name="VARIABLE" id="v_lcm" variabletype="">lcm</field>
                                    <value name="VALUE">
                                      <block type="operator_divide" id="div_lcm">
                                        <value name="NUM1">
                                          <block type="operator_multiply" id="mul_orig">
                                            <value name="NUM1">
                                              <block type="data_variable" id="get_orig_a">
                                                <field name="VARIABLE" id="v_orig_a" variabletype="">原a</field>
                                              </block>
                                            </value>
                                            <value name="NUM2">
                                              <block type="data_variable" id="get_orig_b">
                                                <field name="VARIABLE" id="v_orig_b" variabletype="">原b</field>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                        <value name="NUM2">
                                          <block type="data_variable" id="get_gcd_res">
                                            <field name="VARIABLE" id="v_a" variabletype="">a</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="scratch_say" id="say_lcm">
                                        <value name="TEXT">
                                          <block type="data_variable" id="get_lcm_say">
                                            <field name="VARIABLE" id="v_lcm" variabletype="">lcm</field>
                                          </block>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
