<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="v_s" islocal="false" iscloud="false">字串</variable>
    <variable type="" id="v_p" islocal="false" iscloud="false">前綴</variable>
    <variable type="" id="v_match" islocal="false" iscloud="false">符合</variable>
    <variable type="" id="v_i" islocal="false" iscloud="false">i</variable>
  </variables>
  <block type="event_whenflagclicked" id="flag_so4" x="10" y="10">
    <next>
      <block type="scratch_ask" id="ask_so4_s">
        <value name="QUESTION">
          <shadow type="text" id="txt_so4_s"><field name="TEXT">字串</field></shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_so4_s">
            <field name="VARIABLE" id="v_s" variabletype="">字串</field>
            <value name="VALUE">
              <block type="scratch_answer" id="ans_so4_s"></block>
            </value>
            <next>
              <block type="scratch_ask" id="ask_so4_p">
                <value name="QUESTION">
                  <shadow type="text" id="txt_so4_p"><field name="TEXT">前綴</field></shadow>
                </value>
                <next>
                  <block type="data_setvariableto" id="set_so4_p">
                    <field name="VARIABLE" id="v_p" variabletype="">前綴</field>
                    <value name="VALUE">
                      <block type="scratch_answer" id="ans_so4_p"></block>
                    </value>
                    <next>
                      <block type="data_setvariableto" id="init_match_so4">
                        <field name="VARIABLE" id="v_match" variabletype="">符合</field>
                        <value name="VALUE">
                          <shadow type="text" id="one_so4_1"><field name="TEXT">1</field></shadow>
                        </value>
                        <next>
                          <block type="control_if_else" id="if_else_len_so4">
                            <value name="CONDITION">
                              <block type="operator_compare" id="cmp_len_so4">
                                <field name="OPERATOR">&gt;</field>
                                <value name="OPERAND1">
                                  <shadow type="text" id="sh_len_p_so4"><field name="TEXT"></field></shadow>
                                  <block type="operator_length" id="len_p_so4">
                                    <value name="STRING">
                                      <block type="data_variable" id="get_p_len_so4">
                                        <field name="VARIABLE" id="v_p" variabletype="">前綴</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <value name="OPERAND2">
                                  <shadow type="text" id="sh_len_s_so4"><field name="TEXT"></field></shadow>
                                  <block type="operator_length" id="len_s_so4">
                                    <value name="STRING">
                                      <block type="data_variable" id="get_s_len_so4">
                                        <field name="VARIABLE" id="v_s" variabletype="">字串</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="SUBSTACK">
                              <block type="data_setvariableto" id="set_match_zero_so4">
                                <field name="VARIABLE" id="v_match" variabletype="">符合</field>
                                <value name="VALUE">
                                  <shadow type="text" id="zero_so4_1"><field name="TEXT">0</field></shadow>
                                </value>
                              </block>
                            </statement>
                            <statement name="SUBSTACK2">
                              <block type="data_setvariableto" id="init_i_so4">
                                <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                <value name="VALUE">
                                  <shadow type="text" id="one_so4_2"><field name="TEXT">1</field></shadow>
                                </value>
                                <next>
                                  <block type="control_repeat" id="rep_so4">
                                    <value name="TIMES">
                                      <block type="operator_length" id="len_p_rep_so4">
                                        <value name="STRING">
                                          <block type="data_variable" id="get_p_rep_so4">
                                            <field name="VARIABLE" id="v_p" variabletype="">前綴</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <statement name="SUBSTACK">
                                      <block type="control_if" id="if_ne_so4">
                                        <value name="CONDITION">
                                          <block type="operator_compare" id="cmp_char_so4">
                                            <field name="OPERATOR">!=</field>
                                            <value name="OPERAND1">
                                              <shadow type="text" id="sh_s_char_so4"><field name="TEXT"></field></shadow>
                                              <block type="operator_letter_of" id="let_s_so4">
                                                <value name="STRING">
                                                  <shadow type="text" id="sh_s_str_so4"><field name="TEXT"></field></shadow>
                                                  <block type="data_variable" id="get_s_char_so4">
                                                    <field name="VARIABLE" id="v_s" variabletype="">字串</field>
                                                  </block>
                                                </value>
                                                <value name="LETTER">
                                                  <shadow type="math_whole_number" id="sh_i1_so4"><field name="NUM">1</field></shadow>
                                                  <block type="data_variable" id="get_i_char_s_so4">
                                                    <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <value name="OPERAND2">
                                              <shadow type="text" id="sh_p_char_so4"><field name="TEXT"></field></shadow>
                                              <block type="operator_letter_of" id="let_p_so4">
                                                <value name="STRING">
                                                  <shadow type="text" id="sh_p_str_so4"><field name="TEXT"></field></shadow>
                                                  <block type="data_variable" id="get_p_char_so4">
                                                    <field name="VARIABLE" id="v_p" variabletype="">前綴</field>
                                                  </block>
                                                </value>
                                                <value name="LETTER">
                                                  <shadow type="math_whole_number" id="sh_i2_so4"><field name="NUM">1</field></shadow>
                                                  <block type="data_variable" id="get_i_char_p_so4">
                                                    <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                        <statement name="SUBSTACK">
                                          <block type="data_setvariableto" id="set_match_zero_loop_so4">
                                            <field name="VARIABLE" id="v_match" variabletype="">符合</field>
                                            <value name="VALUE">
                                              <shadow type="text" id="zero_so4_2"><field name="TEXT">0</field></shadow>
                                            </value>
                                          </block>
                                        </statement>
                                        <next>
                                          <block type="data_changevariableby" id="inc_i_so4">
                                            <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                            <value name="VALUE">
                                              <shadow type="math_number" id="one_so4_3"><field name="NUM">1</field></shadow>
                                            </value>
                                          </block>
                                        </next>
                                      </block>
                                    </statement>
                                  </block>
                                </next>
                              </block>
                            </statement>
                            <next>
                              <block type="control_if_else" id="if_else_out_so4">
                                <value name="CONDITION">
                                  <block type="operator_compare" id="cmp_out_match_so4">
                                    <field name="OPERATOR">==</field>
                                    <value name="OPERAND1">
                                      <shadow type="text" id="sh_match_so4"><field name="TEXT"></field></shadow>
                                      <block type="data_variable" id="get_match_out_so4">
                                        <field name="VARIABLE" id="v_match" variabletype="">符合</field>
                                      </block>
                                    </value>
                                    <value name="OPERAND2">
                                      <shadow type="text" id="one_out_so4"><field name="TEXT">1</field></shadow>
                                    </value>
                                  </block>
                                </value>
                                <statement name="SUBSTACK">
                                  <block type="scratch_say" id="say_yes_so4">
                                    <value name="TEXT">
                                      <shadow type="text" id="txt_yes_so4"><field name="TEXT">yes</field></shadow>
                                    </value>
                                  </block>
                                </statement>
                                <statement name="SUBSTACK2">
                                  <block type="scratch_say" id="say_no_so4">
                                    <value name="TEXT">
                                      <shadow type="text" id="txt_no_so4"><field name="TEXT">no</field></shadow>
                                    </value>
                                  </block>
                                </statement>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>