<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="aa_N" islocal="false" iscloud="false">N</variable>
    <variable type="" id="aa_K" islocal="false" iscloud="false">K</variable>
    <variable type="" id="aa_x" islocal="false" iscloud="false">x</variable>
    <variable type="" id="aa_sum" islocal="false" iscloud="false">累加和</variable>
    <variable type="" id="aa_max" islocal="false" iscloud="false">最大值</variable>
    <variable type="" id="aa_cur" islocal="false" iscloud="false">當前和</variable>
    <variable type="" id="aa_i" islocal="false" iscloud="false">i</variable>
    <variable type="list" id="aa_pref" islocal="false" iscloud="false">前綴和</variable>
  </variables>

  <!-- 主程式 -->
  <block type="event_whenflagclicked" id="start_flag" x="10" y="10">
    <next>
      <block type="scratch_ask" id="ask_N">
        <value name="QUESTION">
          <shadow type="text" id="shd_ask_N"><field name="TEXT">N</field></shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_N">
            <field name="VARIABLE" id="aa_N" variabletype="">N</field>
            <value name="VALUE">
              <shadow type="text" id="shd_N_0"><field name="TEXT">0</field></shadow>
              <block type="scratch_answer" id="get_ans_N"></block>
            </value>
            <next>
              <block type="data_deletealloflist" id="del_pref">
                <field name="LIST" id="aa_pref" variabletype="list">前綴和</field>
                <next>
                  <block type="data_addtolist" id="add_0_pref">
                    <field name="LIST" id="aa_pref" variabletype="list">前綴和</field>
                    <value name="ITEM">
                      <shadow type="text" id="shd_zero"><field name="TEXT">0</field></shadow>
                    </value>
                    <next>
                      <block type="data_setvariableto" id="set_sum_0">
                        <field name="VARIABLE" id="aa_sum" variabletype="">累加和</field>
                        <value name="VALUE">
                          <shadow type="text" id="shd_s0"><field name="TEXT">0</field></shadow>
                        </value>
                        <next>
                          <block type="control_repeat" id="loop_N">
                            <value name="TIMES">
                              <block type="data_variable" id="var_N1">
                                <field name="VARIABLE" id="aa_N" variabletype="">N</field>
                              </block>
                            </value>
                            <statement name="SUBSTACK">
                              <block type="scratch_ask" id="ask_x">
                                <value name="QUESTION">
                                  <shadow type="text" id="shd_ask_x"><field name="TEXT">x</field></shadow>
                                </value>
                                <next>
                                  <block type="data_setvariableto" id="set_x">
                                    <field name="VARIABLE" id="aa_x" variabletype="">x</field>
                                    <value name="VALUE">
                                      <shadow type="text" id="shd_x_0"><field name="TEXT">0</field></shadow>
                                      <block type="scratch_answer" id="get_ans_x"></block>
                                    </value>
                                    <next>
                                      <block type="data_changevariableby" id="add_x_to_sum">
                                        <field name="VARIABLE" id="aa_sum" variabletype="">累加和</field>
                                        <value name="VALUE">
                                          <block type="data_variable" id="var_x1">
                                            <field name="VARIABLE" id="aa_x" variabletype="">x</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="data_addtolist" id="add_sum_pref">
                                            <field name="LIST" id="aa_pref" variabletype="list">前綴和</field>
                                            <value name="ITEM">
                                              <block type="data_variable" id="var_sum1">
                                                <field name="VARIABLE" id="aa_sum" variabletype="">累加和</field>
                                              </block>
                                            </value>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </statement>
                            <next>
                              <block type="scratch_ask" id="ask_K">
                                <value name="QUESTION">
                                  <shadow type="text" id="shd_ask_K"><field name="TEXT">K</field></shadow>
                                </value>
                                <next>
                                  <block type="data_setvariableto" id="set_K">
                                    <field name="VARIABLE" id="aa_K" variabletype="">K</field>
                                    <value name="VALUE">
                                      <shadow type="text" id="shd_K_0"><field name="TEXT">0</field></shadow>
                                      <block type="scratch_answer" id="get_ans_K"></block>
                                    </value>
                                    <next>
                                      <block type="data_setvariableto" id="set_max_first">
                                        <field name="VARIABLE" id="aa_max" variabletype="">最大值</field>
                                        <value name="VALUE">
                                          <block type="operator_arithmetic" id="sub_init">
                                            <field name="OPERATOR">-</field>
                                            <value name="NUM1">
                                              <shadow type="math_number" id="shd_m1"><field name="NUM">0</field></shadow>
                                              <block type="data_itemoflist" id="get_item_K1">
                                                <field name="LIST" id="aa_pref" variabletype="list">前綴和</field>
                                                <value name="INDEX">
                                                  <block type="operator_arithmetic" id="add_K_1">
                                                    <field name="OPERATOR">+</field>
                                                    <value name="NUM1">
                                                      <shadow type="math_number" id="shd_k1"><field name="NUM">0</field></shadow>
                                                      <block type="data_variable" id="var_K1">
                                                        <field name="VARIABLE" id="aa_K" variabletype="">K</field>
                                                      </block>
                                                    </value>
                                                    <value name="NUM2">
                                                      <shadow type="math_number" id="shd_1_1"><field name="NUM">1</field></shadow>
                                                    </value>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <value name="NUM2">
                                              <shadow type="math_number" id="shd_m2"><field name="NUM">0</field></shadow>
                                              <block type="data_itemoflist" id="get_item_1">
                                                <field name="LIST" id="aa_pref" variabletype="list">前綴和</field>
                                                <value name="INDEX">
                                                  <shadow type="math_number" id="shd_idx_1"><field name="NUM">1</field></shadow>
                                                </value>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="data_setvariableto" id="set_i_init">
                                            <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                            <value name="VALUE">
                                              <block type="operator_arithmetic" id="add_i_init">
                                                <field name="OPERATOR">+</field>
                                                <value name="NUM1">
                                                  <shadow type="math_number" id="shd_ik1"><field name="NUM">0</field></shadow>
                                                  <block type="data_variable" id="var_K2">
                                                    <field name="VARIABLE" id="aa_K" variabletype="">K</field>
                                                  </block>
                                                </value>
                                                <value name="NUM2">
                                                  <shadow type="math_number" id="shd_1_2"><field name="NUM">1</field></shadow>
                                                </value>
                                              </block>
                                            </value>
                                            <next>
                                              <block type="control_repeat" id="loop_slide">
                                                <value name="TIMES">
                                                  <block type="operator_arithmetic" id="sub_NK">
                                                    <field name="OPERATOR">-</field>
                                                    <value name="NUM1">
                                                      <shadow type="math_number" id="shd_nk1"><field name="NUM">0</field></shadow>
                                                      <block type="data_variable" id="var_N2">
                                                        <field name="VARIABLE" id="aa_N" variabletype="">N</field>
                                                      </block>
                                                    </value>
                                                    <value name="NUM2">
                                                      <shadow type="math_number" id="shd_nk2"><field name="NUM">0</field></shadow>
                                                      <block type="data_variable" id="var_K3">
                                                        <field name="VARIABLE" id="aa_K" variabletype="">K</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                                <statement name="SUBSTACK">
                                                  <block type="data_setvariableto" id="calc_cur">
                                                    <field name="VARIABLE" id="aa_cur" variabletype="">當前和</field>
                                                    <value name="VALUE">
                                                      <block type="operator_arithmetic" id="sub_cur">
                                                        <field name="OPERATOR">-</field>
                                                        <value name="NUM1">
                                                          <shadow type="math_number" id="shd_c1"><field name="NUM">0</field></shadow>
                                                          <block type="data_itemoflist" id="get_item_ip1">
                                                            <field name="LIST" id="aa_pref" variabletype="list">前綴和</field>
                                                            <value name="INDEX">
                                                              <block type="operator_arithmetic" id="add_i_1">
                                                                <field name="OPERATOR">+</field>
                                                                <value name="NUM1">
                                                                  <shadow type="math_number" id="shd_i1"><field name="NUM">0</field></shadow>
                                                                  <block type="data_variable" id="var_i1">
                                                                    <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                                                  </block>
                                                                </value>
                                                                <value name="NUM2">
                                                                  <shadow type="math_number" id="shd_1_3"><field name="NUM">1</field></shadow>
                                                                </value>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </value>
                                                        <value name="NUM2">
                                                          <shadow type="math_number" id="shd_c2"><field name="NUM">0</field></shadow>
                                                          <block type="data_itemoflist" id="get_item_imKp1">
                                                            <field name="LIST" id="aa_pref" variabletype="list">前綴和</field>
                                                            <value name="INDEX">
                                                              <block type="operator_arithmetic" id="add_i_mK_1">
                                                                <field name="OPERATOR">+</field>
                                                                <value name="NUM1">
                                                                  <shadow type="math_number" id="shd_imk"><field name="NUM">0</field></shadow>
                                                                  <block type="operator_arithmetic" id="sub_i_K">
                                                                    <field name="OPERATOR">-</field>
                                                                    <value name="NUM1">
                                                                      <shadow type="math_number" id="shd_i2"><field name="NUM">0</field></shadow>
                                                                      <block type="data_variable" id="var_i2">
                                                                        <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                                                      </block>
                                                                    </value>
                                                                    <value name="NUM2">
                                                                      <shadow type="math_number" id="shd_k4"><field name="NUM">0</field></shadow>
                                                                      <block type="data_variable" id="var_K4">
                                                                        <field name="VARIABLE" id="aa_K" variabletype="">K</field>
                                                                      </block>
                                                                    </value>
                                                                  </block>
                                                                </value>
                                                                <value name="NUM2">
                                                                  <shadow type="math_number" id="shd_1_4"><field name="NUM">1</field></shadow>
                                                                </value>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </value>
                                                    <next>
                                                      <block type="control_if" id="check_gt">
                                                        <value name="CONDITION">
                                                          <block type="operator_compare" id="cmp_cur_max">
                                                            <field name="OPERATOR">&gt;</field>
                                                            <value name="OPERAND1">
                                                              <block type="data_variable" id="var_cur1">
                                                                <field name="VARIABLE" id="aa_cur" variabletype="">當前和</field>
                                                              </block>
                                                            </value>
                                                            <value name="OPERAND2">
                                                              <block type="data_variable" id="var_max1">
                                                                <field name="VARIABLE" id="aa_max" variabletype="">最大值</field>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </value>
                                                        <statement name="SUBSTACK">
                                                          <block type="data_setvariableto" id="update_max">
                                                            <field name="VARIABLE" id="aa_max" variabletype="">最大值</field>
                                                            <value name="VALUE">
                                                              <block type="data_variable" id="var_cur2">
                                                                <field name="VARIABLE" id="aa_cur" variabletype="">當前和</field>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </statement>
                                                        <next>
                                                          <block type="data_changevariableby" id="inc_i">
                                                            <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                                            <value name="VALUE">
                                                              <shadow type="math_number" id="shd_inc1"><field name="NUM">1</field></shadow>
                                                            </value>
                                                          </block>
                                                        </next>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </statement>
                                                <next>
                                                  <block type="scratch_say" id="say_max">
                                                    <value name="TEXT">
                                                      <shadow type="text" id="shd_say_def"><field name="TEXT">Hello!</field></shadow>
                                                      <block type="data_variable" id="var_max_out">
                                                        <field name="VARIABLE" id="aa_max" variabletype="">最大值</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
