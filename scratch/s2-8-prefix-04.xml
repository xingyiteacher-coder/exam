<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="aa_N" islocal="false" iscloud="false">N</variable>
    <variable type="" id="aa_t" islocal="false" iscloud="false">t</variable>
    <variable type="" id="aa_x" islocal="false" iscloud="false">x</variable>
    <variable type="" id="aa_sum" islocal="false" iscloud="false">累加和</variable>
    <variable type="" id="aa_cnt" islocal="false" iscloud="false">個數</variable>
    <variable type="" id="aa_i" islocal="false" iscloud="false">i</variable>
    <variable type="" id="aa_j" islocal="false" iscloud="false">j</variable>
    <variable type="list" id="aa_pref" islocal="false" iscloud="false">前綴和</variable>
  </variables>

  <!-- 主程式 -->
  <block type="event_whenflagclicked" id="start_flag" x="10" y="10">
    <next>
      <block type="scratch_ask" id="ask_N">
        <value name="QUESTION">
          <shadow type="text" id="shd_ask_N"><field name="TEXT">N</field></shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_N">
            <field name="VARIABLE" id="aa_N" variabletype="">N</field>
            <value name="VALUE">
              <shadow type="text" id="shd_N_0"><field name="TEXT">0</field></shadow>
              <block type="scratch_answer" id="get_ans_N"></block>
            </value>
            <next>
              <block type="data_deletealloflist" id="del_pref">
                <field name="LIST" id="aa_pref" variabletype="list">前綴和</field>
                <next>
                  <block type="data_addtolist" id="add_0_pref">
                    <field name="LIST" id="aa_pref" variabletype="list">前綴和</field>
                    <value name="ITEM">
                      <shadow type="text" id="shd_zero"><field name="TEXT">0</field></shadow>
                    </value>
                    <next>
                      <block type="data_setvariableto" id="set_sum_0">
                        <field name="VARIABLE" id="aa_sum" variabletype="">累加和</field>
                        <value name="VALUE">
                          <shadow type="text" id="shd_s0"><field name="TEXT">0</field></shadow>
                        </value>
                        <next>
                          <block type="control_repeat" id="loop_N">
                            <value name="TIMES">
                              <block type="data_variable" id="var_N1">
                                <field name="VARIABLE" id="aa_N" variabletype="">N</field>
                              </block>
                            </value>
                            <statement name="SUBSTACK">
                              <block type="scratch_ask" id="ask_x">
                                <value name="QUESTION">
                                  <shadow type="text" id="shd_ask_x"><field name="TEXT">x</field></shadow>
                                </value>
                                <next>
                                  <block type="data_setvariableto" id="set_x">
                                    <field name="VARIABLE" id="aa_x" variabletype="">x</field>
                                    <value name="VALUE">
                                      <shadow type="text" id="shd_x_0"><field name="TEXT">0</field></shadow>
                                      <block type="scratch_answer" id="get_ans_x"></block>
                                    </value>
                                    <next>
                                      <block type="data_changevariableby" id="add_x_to_sum">
                                        <field name="VARIABLE" id="aa_sum" variabletype="">累加和</field>
                                        <value name="VALUE">
                                          <block type="data_variable" id="var_x1">
                                            <field name="VARIABLE" id="aa_x" variabletype="">x</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="data_addtolist" id="add_sum_pref">
                                            <field name="LIST" id="aa_pref" variabletype="list">前綴和</field>
                                            <value name="ITEM">
                                              <block type="data_variable" id="var_sum1">
                                                <field name="VARIABLE" id="aa_sum" variabletype="">累加和</field>
                                              </block>
                                            </value>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </statement>
                            <next>
                              <block type="scratch_ask" id="ask_t">
                                <value name="QUESTION">
                                  <shadow type="text" id="shd_ask_t"><field name="TEXT">t</field></shadow>
                                </value>
                                <next>
                                  <block type="data_setvariableto" id="set_t">
                                    <field name="VARIABLE" id="aa_t" variabletype="">t</field>
                                    <value name="VALUE">
                                      <shadow type="text" id="shd_t_0"><field name="TEXT">0</field></shadow>
                                      <block type="scratch_answer" id="get_ans_t"></block>
                                    </value>
                                    <next>
                                      <block type="data_setvariableto" id="set_cnt_0">
                                        <field name="VARIABLE" id="aa_cnt" variabletype="">個數</field>
                                        <value name="VALUE">
                                          <shadow type="math_number" id="shd_c0"><field name="NUM">0</field></shadow>
                                        </value>
                                        <next>
                                          <block type="data_setvariableto" id="set_i_1">
                                            <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                            <value name="VALUE">
                                              <shadow type="math_number" id="shd_i_init"><field name="NUM">1</field></shadow>
                                            </value>
                                            <next>
                                              <block type="control_repeat" id="outer_loop">
                                                <value name="TIMES">
                                                  <block type="data_variable" id="var_N2">
                                                    <field name="VARIABLE" id="aa_N" variabletype="">N</field>
                                                  </block>
                                                </value>
                                                <statement name="SUBSTACK">
                                                  <block type="data_setvariableto" id="set_j_i">
                                                    <field name="VARIABLE" id="aa_j" variabletype="">j</field>
                                                    <value name="VALUE">
                                                      <block type="data_variable" id="var_i1">
                                                        <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                                      </block>
                                                    </value>
                                                    <next>
                                                      <block type="control_repeat" id="inner_loop">
                                                        <value name="TIMES">
                                                          <block type="operator_arithmetic" id="calc_inner_times">
                                                            <field name="OPERATOR">+</field>
                                                            <value name="NUM1">
                                                              <block type="operator_arithmetic" id="sub_N_i">
                                                                <field name="OPERATOR">-</field>
                                                                <value name="NUM1">
                                                                  <shadow type="math_number" id="shd_n1"><field name="NUM">0</field></shadow>
                                                                  <block type="data_variable" id="var_N3">
                                                                    <field name="VARIABLE" id="aa_N" variabletype="">N</field>
                                                                  </block>
                                                                </value>
                                                                <value name="NUM2">
                                                                  <shadow type="math_number" id="shd_i1"><field name="NUM">0</field></shadow>
                                                                  <block type="data_variable" id="var_i2">
                                                                    <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </value>
                                                            <value name="NUM2">
                                                              <shadow type="math_number" id="shd_1_1"><field name="NUM">1</field></shadow>
                                                            </value>
                                                          </block>
                                                        </value>
                                                        <statement name="SUBSTACK">
                                                          <block type="control_if" id="check_sum_eq_t">
                                                            <value name="CONDITION">
                                                              <block type="operator_compare" id="cmp_eq_t">
                                                                <field name="OPERATOR">==</field>
                                                                <value name="OPERAND1">
                                                                  <block type="operator_arithmetic" id="sub_pref">
                                                                    <field name="OPERATOR">-</field>
                                                                    <value name="NUM1">
                                                                      <shadow type="math_number" id="shd_m1"><field name="NUM">0</field></shadow>
                                                                      <block type="data_itemoflist" id="get_item_jp1">
                                                                        <field name="LIST" id="aa_pref" variabletype="list">前綴和</field>
                                                                        <value name="INDEX">
                                                                          <block type="operator_arithmetic" id="add_j_1">
                                                                            <field name="OPERATOR">+</field>
                                                                            <value name="NUM1">
                                                                              <shadow type="math_number" id="shd_j1"><field name="NUM">0</field></shadow>
                                                                              <block type="data_variable" id="var_j1">
                                                                                <field name="VARIABLE" id="aa_j" variabletype="">j</field>
                                                                              </block>
                                                                            </value>
                                                                            <value name="NUM2">
                                                                              <shadow type="math_number" id="shd_1_2"><field name="NUM">1</field></shadow>
                                                                            </value>
                                                                          </block>
                                                                        </value>
                                                                      </block>
                                                                    </value>
                                                                    <value name="NUM2">
                                                                      <shadow type="math_number" id="shd_m2"><field name="NUM">0</field></shadow>
                                                                      <block type="data_itemoflist" id="get_item_i">
                                                                        <field name="LIST" id="aa_pref" variabletype="list">前綴和</field>
                                                                        <value name="INDEX">
                                                                          <block type="data_variable" id="var_i3">
                                                                            <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                                                          </block>
                                                                        </value>
                                                                      </block>
                                                                    </value>
                                                                  </block>
                                                                </value>
                                                                <value name="OPERAND2">
                                                                  <block type="data_variable" id="var_t1">
                                                                    <field name="VARIABLE" id="aa_t" variabletype="">t</field>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </value>
                                                            <statement name="SUBSTACK">
                                                              <block type="data_changevariableby" id="inc_cnt">
                                                                <field name="VARIABLE" id="aa_cnt" variabletype="">個數</field>
                                                                <value name="VALUE">
                                                                  <shadow type="math_number" id="shd_inc_c"><field name="NUM">1</field></shadow>
                                                                </value>
                                                              </block>
                                                            </statement>
                                                            <next>
                                                              <block type="data_changevariableby" id="inc_j">
                                                                <field name="VARIABLE" id="aa_j" variabletype="">j</field>
                                                                <value name="VALUE">
                                                                  <shadow type="math_number" id="shd_inc_j"><field name="NUM">1</field></shadow>
                                                                </value>
                                                              </block>
                                                            </next>
                                                          </block>
                                                        </statement>
                                                        <next>
                                                          <block type="data_changevariableby" id="inc_i">
                                                            <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                                            <value name="VALUE">
                                                              <shadow type="math_number" id="shd_inc_i"><field name="NUM">1</field></shadow>
                                                            </value>
                                                          </block>
                                                        </next>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </statement>
                                                <next>
                                                  <block type="scratch_say" id="say_cnt">
                                                    <value name="TEXT">
                                                      <shadow type="text" id="shd_say_def"><field name="TEXT">Hello!</field></shadow>
                                                      <block type="data_variable" id="var_cnt_out">
                                                        <field name="VARIABLE" id="aa_cnt" variabletype="">個數</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
