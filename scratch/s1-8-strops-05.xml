<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="v_s" islocal="false" iscloud="false">字串</variable>
    <variable type="" id="v_cnt" islocal="false" iscloud="false">個數</variable>
    <variable type="" id="v_i" islocal="false" iscloud="false">i</variable>
  </variables>
  <block type="event_whenflagclicked" id="flag_so5" x="10" y="10">
    <next>
      <block type="scratch_ask" id="ask_so5">
        <value name="QUESTION">
          <shadow type="text" id="txt_so5"><field name="TEXT">字串</field></shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_so5_s">
            <field name="VARIABLE" id="v_s" variabletype="">字串</field>
            <value name="VALUE">
              <block type="scratch_answer" id="ans_so5"></block>
            </value>
            <next>
              <block type="data_setvariableto" id="init_cnt_so5">
                <field name="VARIABLE" id="v_cnt" variabletype="">個數</field>
                <value name="VALUE">
                  <shadow type="text" id="one_so5_1"><field name="TEXT">1</field></shadow>
                </value>
                <next>
                  <block type="data_setvariableto" id="init_i_so5">
                    <field name="VARIABLE" id="v_i" variabletype="">i</field>
                    <value name="VALUE">
                      <shadow type="text" id="one_so5_2"><field name="TEXT">1</field></shadow>
                    </value>
                    <next>
                      <block type="control_repeat" id="rep_so5">
                        <value name="TIMES">
                          <block type="operator_length" id="len_so5">
                            <value name="STRING">
                              <block type="data_variable" id="get_s_len_so5">
                                <field name="VARIABLE" id="v_s" variabletype="">字串</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <statement name="SUBSTACK">
                          <block type="control_if" id="if_space_so5">
                            <value name="CONDITION">
                              <block type="operator_compare" id="cmp_space_so5">
                                <field name="OPERATOR">==</field>
                                <value name="OPERAND1">
                                  <shadow type="text" id="sh_let_space_so5"><field name="TEXT"></field></shadow>
                                  <block type="operator_letter_of" id="let_so5">
                                    <value name="STRING">
                                      <shadow type="text" id="sh_str_so5"><field name="TEXT"></field></shadow>
                                      <block type="data_variable" id="get_s_let_so5">
                                        <field name="VARIABLE" id="v_s" variabletype="">字串</field>
                                      </block>
                                    </value>
                                    <value name="LETTER">
                                      <shadow type="math_whole_number" id="sh_i_so5"><field name="NUM">1</field></shadow>
                                      <block type="data_variable" id="get_i_so5">
                                        <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <value name="OPERAND2">
                                  <shadow type="text" id="space_so5"><field name="TEXT"> </field></shadow>
                                </value>
                              </block>
                            </value>
                            <statement name="SUBSTACK">
                              <block type="data_changevariableby" id="inc_cnt_so5">
                                <field name="VARIABLE" id="v_cnt" variabletype="">個數</field>
                                <value name="VALUE">
                                  <shadow type="math_number" id="one_so5_3"><field name="NUM">1</field></shadow>
                                </value>
                              </block>
                            </statement>
                            <next>
                              <block type="data_changevariableby" id="inc_i_so5">
                                <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                <value name="VALUE">
                                  <shadow type="math_number" id="one_so5_4"><field name="NUM">1</field></shadow>
                                </value>
                              </block>
                            </next>
                          </block>
                        </statement>
                        <next>
                          <block type="scratch_say" id="say_so5">
                            <value name="TEXT">
                              <block type="data_variable" id="out_cnt_so5">
                                <field name="VARIABLE" id="v_cnt" variabletype="">個數</field>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>