<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="aa_N" islocal="false" iscloud="false">N</variable>
    <variable type="" id="aa_k" islocal="false" iscloud="false">k</variable>
    <variable type="" id="aa_str" islocal="false" iscloud="false">輸入字串</variable>
    <variable type="" id="aa_word" islocal="false" iscloud="false">單字</variable>
    <variable type="" id="aa_ptr" islocal="false" iscloud="false">ptr</variable>
    <variable type="" id="aa_char" islocal="false" iscloud="false">char</variable>
    <variable type="" id="aa_i" islocal="false" iscloud="false">i</variable>
    <variable type="" id="aa_j" islocal="false" iscloud="false">j</variable>
    <variable type="" id="aa_min_idx" islocal="false" iscloud="false">最小值位置</variable>
    <variable type="" id="aa_temp" islocal="false" iscloud="false">temp</variable>
    <variable type="list" id="aa_list" islocal="false" iscloud="false">數列</variable>
  </variables>

  <!-- 主程式 -->
  <block type="event_whenflagclicked" id="start_flag" x="10" y="10">
    <next>
      <!-- 1. 讀取 N -->
      <block type="scratch_ask" id="ask_N">
        <value name="QUESTION">
          <shadow type="text" id="shd_ask_N"><field name="TEXT">N</field></shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_N">
            <field name="VARIABLE" id="aa_N" variabletype="">N</field>
            <value name="VALUE">
              <block type="scratch_answer" id="get_ans_N"></block>
            </value>
            <next>
              <!-- 2. 讀取第二行整行數列字串 -->
              <block type="scratch_ask" id="ask_line">
                <value name="QUESTION">
                  <shadow type="text" id="shd_ask_line"><field name="TEXT">數列字串</field></shadow>
                </value>
                <next>
                  <block type="data_setvariableto" id="set_str">
                    <field name="VARIABLE" id="aa_str" variabletype="">輸入字串</field>
                    <value name="VALUE">
                      <block type="scratch_answer" id="get_ans_line"></block>
                    </value>
                    <next>
                      <!-- 3. 讀取 k -->
                      <block type="scratch_ask" id="ask_k">
                        <value name="QUESTION">
                          <shadow type="text" id="shd_ask_k"><field name="TEXT">k</field></shadow>
                        </value>
                        <next>
                          <block type="data_setvariableto" id="set_k">
                            <field name="VARIABLE" id="aa_k" variabletype="">k</field>
                            <value name="VALUE">
                              <block type="scratch_answer" id="get_ans_k"></block>
                            </value>
                            <next>
                              <!-- 清空數列清單 -->
                              <block type="data_deletealloflist" id="del_list">
                                <field name="LIST" id="aa_list" variabletype="list">數列</field>
                                <next>
                                  <!-- 4. 拆解字串填入數列清單 -->
                                  <block type="data_setvariableto" id="set_word_empty">
                                    <field name="VARIABLE" id="aa_word" variabletype="">單字</field>
                                    <value name="VALUE">
                                      <shadow type="text" id="shd_empty1"><field name="TEXT"></field></shadow>
                                    </value>
                                    <next>
                                      <block type="data_setvariableto" id="set_ptr_1">
                                        <field name="VARIABLE" id="aa_ptr" variabletype="">ptr</field>
                                        <value name="VALUE">
                                          <shadow type="text" id="shd_ptr1"><field name="TEXT">1</field></shadow>
                                        </value>
                                        <next>
                                          <block type="control_repeat" id="loop_parse_str">
                                            <value name="TIMES">
                                              <block type="operator_length" id="get_len">
                                                <value name="STRING">
                                                  <block type="data_variable" id="var_str1">
                                                    <field name="VARIABLE" id="aa_str" variabletype="">輸入字串</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <statement name="SUBSTACK">
                                              <block type="data_setvariableto" id="set_char">
                                                <field name="VARIABLE" id="aa_char" variabletype="">char</field>
                                                <value name="VALUE">
                                                  <block type="operator_letter_of" id="get_char_idx">
                                                    <value name="LETTER">
                                                      <block type="data_variable" id="var_ptr1">
                                                        <field name="VARIABLE" id="aa_ptr" variabletype="">ptr</field>
                                                      </block>
                                                    </value>
                                                    <value name="STRING">
                                                      <block type="data_variable" id="var_str2">
                                                        <field name="VARIABLE" id="aa_str" variabletype="">輸入字串</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                                <next>
                                                  <block type="control_if_else" id="check_space">
                                                    <value name="CONDITION">
                                                      <block type="operator_compare" id="cmp_space">
                                                        <field name="OPERATOR">=</field>
                                                        <value name="OPERAND1">
                                                          <block type="data_variable" id="var_char1">
                                                            <field name="VARIABLE" id="aa_char" variabletype="">char</field>
                                                          </block>
                                                        </value>
                                                        <value name="OPERAND2">
                                                          <shadow type="text" id="shd_space_char"><field name="TEXT"> </field></shadow>
                                                        </value>
                                                      </block>
                                                    </value>
                                                    <statement name="IF">
                                                      <block type="control_if" id="check_word_not_empty">
                                                        <value name="CONDITION">
                                                          <block type="operator_compare" id="cmp_word_gt_0">
                                                            <field name="OPERATOR">&gt;</field>
                                                            <value name="OPERAND1">
                                                              <block type="operator_length" id="get_word_len">
                                                                <value name="STRING">
                                                                  <block type="data_variable" id="var_word1">
                                                                    <field name="VARIABLE" id="aa_word" variabletype="">單字</field>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </value>
                                                            <value name="OPERAND2">
                                                              <shadow type="math_number" id="shd_zero1"><field name="NUM">0</field></shadow>
                                                            </value>
                                                          </block>
                                                        </value>
                                                        <statement name="SUBSTACK">
                                                          <block type="data_addtolist" id="add_word_list">
                                                            <field name="LIST" id="aa_list" variabletype="list">數列</field>
                                                            <value name="ITEM">
                                                              <block type="data_variable" id="var_word2">
                                                                <field name="VARIABLE" id="aa_word" variabletype="">單字</field>
                                                              </block>
                                                            </value>
                                                            <next>
                                                              <block type="data_setvariableto" id="reset_word">
                                                                <field name="VARIABLE" id="aa_word" variabletype="">單字</field>
                                                                <value name="VALUE">
                                                                  <shadow type="text" id="shd_empty2"><field name="TEXT"></field></shadow>
                                                                </value>
                                                              </block>
                                                            </next>
                                                          </block>
                                                        </statement>
                                                      </block>
                                                    </statement>
                                                    <statement name="ELSE">
                                                      <block type="data_setvariableto" id="append_char">
                                                        <field name="VARIABLE" id="aa_word" variabletype="">單字</field>
                                                        <value name="VALUE">
                                                          <block type="operator_join" id="join_char">
                                                            <value name="OPERAND1">
                                                              <block type="data_variable" id="var_word3">
                                                                <field name="VARIABLE" id="aa_word" variabletype="">單字</field>
                                                              </block>
                                                            </value>
                                                            <value name="OPERAND2">
                                                              <block type="data_variable" id="var_char2">
                                                                <field name="VARIABLE" id="aa_char" variabletype="">char</field>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </statement>
                                                    <next>
                                                      <block type="data_changevariableby" id="inc_ptr">
                                                        <field name="VARIABLE" id="aa_ptr" variabletype="">ptr</field>
                                                        <value name="VALUE">
                                                          <shadow type="math_number" id="shd_inc_ptr1"><field name="NUM">1</field></shadow>
                                                        </value>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </next>
                                              </block>
                                            </statement>
                                            <next>
                                              <!-- 處理最後一個數字 -->
                                              <block type="control_if" id="check_last_word">
                                                <value name="CONDITION">
                                                  <block type="operator_compare" id="cmp_last_word">
                                                    <field name="OPERATOR">&gt;</field>
                                                    <value name="OPERAND1">
                                                      <block type="operator_length" id="get_last_word_len">
                                                        <value name="STRING">
                                                          <block type="data_variable" id="var_word4">
                                                            <field name="VARIABLE" id="aa_word" variabletype="">單字</field>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </value>
                                                    <value name="OPERAND2">
                                                      <shadow type="math_number" id="shd_zero2"><field name="NUM">0</field></shadow>
                                                    </value>
                                                  </block>
                                                </value>
                                                <statement name="SUBSTACK">
                                                  <block type="data_addtolist" id="add_last_word">
                                                    <field name="LIST" id="aa_list" variabletype="list">數列</field>
                                                    <value name="ITEM">
                                                      <block type="data_variable" id="var_word5">
                                                        <field name="VARIABLE" id="aa_word" variabletype="">單字</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </statement>
                                                <next>
                                                  <!-- 5. 選擇排序法 -->
                                                  <block type="data_setvariableto" id="set_i_1">
                                                    <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                                    <value name="VALUE">
                                                      <shadow type="text" id="shd_i1"><field name="TEXT">1</field></shadow>
                                                    </value>
                                                    <next>
                                                      <block type="control_repeat" id="outer_loop">
                                                        <value name="TIMES">
                                                          <block type="operator_arithmetic" id="sub_N_1">
                                                            <field name="OPERATOR">-</field>
                                                            <value name="NUM1">
                                                              <block type="data_variable" id="var_N2">
                                                                <field name="VARIABLE" id="aa_N" variabletype="">N</field>
                                                              </block>
                                                            </value>
                                                            <value name="NUM2">
                                                              <shadow type="math_number" id="shd_1_1"><field name="NUM">1</field></shadow>
                                                            </value>
                                                          </block>
                                                        </value>
                                                        <statement name="SUBSTACK">
                                                          <block type="data_setvariableto" id="set_min_idx">
                                                            <field name="VARIABLE" id="aa_min_idx" variabletype="">最小值位置</field>
                                                            <value name="VALUE">
                                                              <block type="data_variable" id="var_i_min">
                                                                <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                                              </block>
                                                            </value>
                                                            <next>
                                                              <block type="data_setvariableto" id="set_j_ip1">
                                                                <field name="VARIABLE" id="aa_j" variabletype="">j</field>
                                                                <value name="VALUE">
                                                                  <block type="operator_arithmetic" id="add_i_1">
                                                                    <field name="OPERATOR">+</field>
                                                                    <value name="NUM1">
                                                                      <block type="data_variable" id="var_i1">
                                                                        <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                                                      </block>
                                                                    </value>
                                                                    <value name="NUM2">
                                                                      <shadow type="math_number" id="shd_1_2"><field name="NUM">1</field></shadow>
                                                                    </value>
                                                                  </block>
                                                                </value>
                                                                <next>
                                                                  <block type="control_repeat" id="inner_loop">
                                                                    <value name="TIMES">
                                                                      <block type="operator_arithmetic" id="sub_N_i">
                                                                        <field name="OPERATOR">-</field>
                                                                        <value name="NUM1">
                                                                          <block type="data_variable" id="var_N3">
                                                                            <field name="VARIABLE" id="aa_N" variabletype="">N</field>
                                                                          </block>
                                                                        </value>
                                                                        <value name="NUM2">
                                                                          <block type="data_variable" id="var_i2">
                                                                            <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                                                          </block>
                                                                        </value>
                                                                      </block>
                                                                    </value>
                                                                    <statement name="SUBSTACK">
                                                                      <block type="control_if" id="check_min">
                                                                        <value name="CONDITION">
                                                                          <block type="operator_compare" id="cmp_lt">
                                                                            <field name="OPERATOR">&lt;</field>
                                                                            <value name="OPERAND1">
                                                                              <block type="data_itemoflist" id="get_item_j">
                                                                                <field name="LIST" id="aa_list" variabletype="list">數列</field>
                                                                                <value name="INDEX">
                                                                                  <block type="data_variable" id="var_j1">
                                                                                    <field name="VARIABLE" id="aa_j" variabletype="">j</field>
                                                                                  </block>
                                                                                </value>
                                                                              </block>
                                                                            </value>
                                                                            <value name="OPERAND2">
                                                                              <block type="data_itemoflist" id="get_item_min">
                                                                                <field name="LIST" id="aa_list" variabletype="list">數列</field>
                                                                                <value name="INDEX">
                                                                                  <block type="data_variable" id="var_min_idx">
                                                                                    <field name="VARIABLE" id="aa_min_idx" variabletype="">最小值位置</field>
                                                                                  </block>
                                                                                </value>
                                                                              </block>
                                                                            </value>
                                                                          </block>
                                                                        </value>
                                                                        <statement name="SUBSTACK">
                                                                          <block type="data_setvariableto" id="update_min_idx">
                                                                            <field name="VARIABLE" id="aa_min_idx" variabletype="">最小值位置</field>
                                                                            <value name="VALUE">
                                                                              <block type="data_variable" id="var_j2">
                                                                                <field name="VARIABLE" id="aa_j" variabletype="">j</field>
                                                                              </block>
                                                                            </value>
                                                                          </block>
                                                                        </statement>
                                                                        <next>
                                                                          <block type="data_changevariableby" id="inc_j">
                                                                            <field name="VARIABLE" id="aa_j" variabletype="">j</field>
                                                                            <value name="VALUE">
                                                                              <shadow type="math_number" id="shd_inc_j"><field name="NUM">1</field></shadow>
                                                                            </value>
                                                                          </block>
                                                                        </next>
                                                                      </block>
                                                                    </statement>
                                                                    <next>
                                                                      <!-- 交換 數列[i] 與 數列[最小值位置] -->
                                                                      <block type="data_setvariableto" id="set_temp">
                                                                        <field name="VARIABLE" id="aa_temp" variabletype="">temp</field>
                                                                        <value name="VALUE">
                                                                          <block type="data_itemoflist" id="get_item_i">
                                                                            <field name="LIST" id="aa_list" variabletype="list">數列</field>
                                                                            <value name="INDEX">
                                                                              <block type="data_variable" id="var_i3">
                                                                                <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                                                              </block>
                                                                            </value>
                                                                          </block>
                                                                        </value>
                                                                        <next>
                                                                          <block type="data_replaceitemoflist" id="replace_i">
                                                                            <field name="LIST" id="aa_list" variabletype="list">數列</field>
                                                                            <value name="INDEX">
                                                                              <block type="data_variable" id="var_i4">
                                                                                <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                                                              </block>
                                                                            </value>
                                                                            <value name="ITEM">
                                                                              <block type="data_itemoflist" id="get_item_min_swap">
                                                                                <field name="LIST" id="aa_list" variabletype="list">數列</field>
                                                                                <value name="INDEX">
                                                                                  <block type="data_variable" id="var_min_idx2">
                                                                                    <field name="VARIABLE" id="aa_min_idx" variabletype="">最小值位置</field>
                                                                                  </block>
                                                                                </value>
                                                                              </block>
                                                                            </value>
                                                                            <next>
                                                                              <block type="data_replaceitemoflist" id="replace_min">
                                                                                <field name="LIST" id="aa_list" variabletype="list">數列</field>
                                                                                <value name="INDEX">
                                                                                  <block type="data_variable" id="var_min_idx3">
                                                                                    <field name="VARIABLE" id="aa_min_idx" variabletype="">最小值位置</field>
                                                                                  </block>
                                                                                </value>
                                                                                <value name="ITEM">
                                                                                  <block type="data_variable" id="var_temp1">
                                                                                    <field name="VARIABLE" id="aa_temp" variabletype="">temp</field>
                                                                                  </block>
                                                                                </value>
                                                                                <next>
                                                                                  <block type="data_changevariableby" id="inc_i">
                                                                                    <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                                                                    <value name="VALUE">
                                                                                      <shadow type="math_number" id="shd_inc_i"><field name="NUM">1</field></shadow>
                                                                                    </value>
                                                                                  </block>
                                                                                </next>
                                                                              </block>
                                                                            </next>
                                                                          </block>
                                                                        </next>
                                                                      </block>
                                                                    </next>
                                                                  </block>
                                                                </next>
                                                              </block>
                                                            </next>
                                                          </block>
                                                        </statement>
                                                        <next>
                                                          <!-- 6. 輸出第 k 小的數 -->
                                                          <block type="scratch_say" id="say_ans">
                                                            <value name="TEXT">
                                                              <block type="data_itemoflist" id="get_item_k">
                                                                <field name="LIST" id="aa_list" variabletype="list">數列</field>
                                                                <value name="INDEX">
                                                                  <block type="data_variable" id="var_k1">
                                                                    <field name="VARIABLE" id="aa_k" variabletype="">k</field>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </next>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
