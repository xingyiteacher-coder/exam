<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="v_N" islocal="false" iscloud="false">N</variable>
    <variable type="" id="v_t" islocal="false" iscloud="false">t</variable>
    <variable type="" id="v_left" islocal="false" iscloud="false">left</variable>
    <variable type="" id="v_right" islocal="false" iscloud="false">right</variable>
    <variable type="" id="v_mid" islocal="false" iscloud="false">mid</variable>
    <variable type="" id="v_curr" islocal="false" iscloud="false">curr</variable>
    <variable type="" id="v_ans" islocal="false" iscloud="false">ans</variable>
    <variable type="list" id="l_arr" islocal="false" iscloud="false">陣列</variable>
  </variables>
  <block type="event_whenflagclicked" id="start_first_ge" x="10" y="10">
    <next>
      <block type="data_deletealloflist" id="del_arr">
        <field name="LIST" id="l_arr" variabletype="list">陣列</field>
        <next>
          <block type="scratch_ask" id="ask_N">
            <value name="QUESTION">
              <shadow type="text" id="txt_N"><field name="TEXT">N</field></shadow>
            </value>
            <next>
              <block type="data_setvariableto" id="set_N">
                <field name="VARIABLE" id="v_N" variabletype="">N</field>
                <value name="VALUE">
                  <block type="scratch_answer" id="ans_N"></block>
                </value>
                <next>
                  <block type="control_repeat" id="rep_read">
                    <value name="TIMES">
                      <block type="data_variable" id="get_N">
                        <field name="VARIABLE" id="v_N" variabletype="">N</field>
                      </block>
                    </value>
                    <statement name="SUBSTACK">
                      <block type="scratch_ask" id="ask_item">
                        <value name="QUESTION">
                          <shadow type="text" id="txt_item"><field name="TEXT">x</field></shadow>
                        </value>
                        <next>
                          <block type="data_addtolist" id="add_item">
                            <field name="LIST" id="l_arr" variabletype="list">陣列</field>
                            <value name="ITEM">
                              <block type="scratch_answer" id="ans_item"></block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <block type="scratch_ask" id="ask_t">
                        <value name="QUESTION">
                          <shadow type="text" id="txt_t"><field name="TEXT">t</field></shadow>
                        </value>
                        <next>
                          <block type="data_setvariableto" id="set_t">
                            <field name="VARIABLE" id="v_t" variabletype="">t</field>
                            <value name="VALUE">
                              <block type="scratch_answer" id="ans_t"></block>
                            </value>
                            <next>
                              <block type="data_setvariableto" id="set_left">
                                <field name="VARIABLE" id="v_left" variabletype="">left</field>
                                <value name="VALUE">
                                  <shadow type="math_number" id="num_1"><field name="NUM">1</field></shadow>
                                </value>
                                <next>
                                  <block type="data_setvariableto" id="set_right">
                                    <field name="VARIABLE" id="v_right" variabletype="">right</field>
                                    <value name="VALUE">
                                      <block type="data_variable" id="get_N_val">
                                        <field name="VARIABLE" id="v_N" variabletype="">N</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="data_setvariableto" id="set_ans_none">
                                        <field name="VARIABLE" id="v_ans" variabletype="">ans</field>
                                        <value name="VALUE">
                                          <shadow type="text" id="txt_none"><field name="TEXT">none</field></shadow>
                                        </value>
                                        <next>
                                          <block type="control_repeat_until" id="rep_until_fge">
                                            <value name="CONDITION">
                                              <block type="operator_compare" id="cmp_gt">
                                                <field name="OPERATOR">&gt;</field>
                                                <value name="OPERAND1">
                                                  <block type="data_variable" id="get_left">
                                                    <field name="VARIABLE" id="v_left" variabletype="">left</field>
                                                  </block>
                                                </value>
                                                <value name="OPERAND2">
                                                  <block type="data_variable" id="get_right">
                                                    <field name="VARIABLE" id="v_right" variabletype="">right</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <statement name="SUBSTACK">
                                              <block type="data_setvariableto" id="set_mid">
                                                <field name="VARIABLE" id="v_mid" variabletype="">mid</field>
                                                <value name="VALUE">
                                                  <block type="operator_round" id="round_mid">
                                                    <value name="NUM">
                                                      <block type="operator_divide" id="div_mid">
                                                        <value name="NUM1">
                                                          <block type="operator_add" id="add_lr">
                                                            <value name="NUM1">
                                                              <block type="data_variable" id="get_left2">
                                                                <field name="VARIABLE" id="v_left" variabletype="">left</field>
                                                              </block>
                                                            </value>
                                                            <value name="NUM2">
                                                              <block type="data_variable" id="get_right2">
                                                                <field name="VARIABLE" id="v_right" variabletype="">right</field>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </value>
                                                        <value name="NUM2">
                                                          <shadow type="math_number" id="num_2"><field name="NUM">2</field></shadow>
                                                        </value>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                                <next>
                                                  <block type="data_setvariableto" id="set_curr">
                                                    <field name="VARIABLE" id="v_curr" variabletype="">curr</field>
                                                    <value name="VALUE">
                                                      <block type="data_itemoflist" id="get_list_item">
                                                        <field name="LIST" id="l_arr" variabletype="list">陣列</field>
                                                        <value name="INDEX">
                                                          <block type="data_variable" id="get_mid">
                                                            <field name="VARIABLE" id="v_mid" variabletype="">mid</field>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </value>
                                                    <next>
                                                      <block type="control_if_else" id="if_else_fge">
                                                        <value name="CONDITION">
                                                          <block type="operator_compare" id="cmp_ge">
                                                            <field name="OPERATOR">&gt;=</field>
                                                            <value name="OPERAND1">
                                                              <block type="data_variable" id="get_curr">
                                                                <field name="VARIABLE" id="v_curr" variabletype="">curr</field>
                                                              </block>
                                                            </value>
                                                            <value name="OPERAND2">
                                                              <block type="data_variable" id="get_t">
                                                                <field name="VARIABLE" id="v_t" variabletype="">t</field>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </value>
                                                        <statement name="SUBSTACK">
                                                          <block type="data_setvariableto" id="set_ans_curr">
                                                            <field name="VARIABLE" id="v_ans" variabletype="">ans</field>
                                                            <value name="VALUE">
                                                              <block type="data_variable" id="get_curr2">
                                                                <field name="VARIABLE" id="v_curr" variabletype="">curr</field>
                                                              </block>
                                                            </value>
                                                            <next>
                                                              <block type="data_setvariableto" id="set_right_down">
                                                                <field name="VARIABLE" id="v_right" variabletype="">right</field>
                                                                <value name="VALUE">
                                                                  <block type="operator_subtract" id="sub_mid_1">
                                                                    <field name="OPERATOR">-</field>
                                                                    <value name="NUM1">
                                                                      <block type="data_variable" id="get_mid2">
                                                                        <field name="VARIABLE" id="v_mid" variabletype="">mid</field>
                                                                      </block>
                                                                    </value>
                                                                    <value name="NUM2">
                                                                      <shadow type="math_number" id="num_1_sub"><field name="NUM">1</field></shadow>
                                                                    </value>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </next>
                                                          </block>
                                                        </statement>
                                                        <statement name="SUBSTACK2">
                                                          <block type="data_setvariableto" id="set_left_up">
                                                            <field name="VARIABLE" id="v_left" variabletype="">left</field>
                                                            <value name="VALUE">
                                                              <block type="operator_add" id="add_mid_1">
                                                                <value name="NUM1">
                                                                  <block type="data_variable" id="get_mid3">
                                                                    <field name="VARIABLE" id="v_mid" variabletype="">mid</field>
                                                                  </block>
                                                                </value>
                                                                <value name="NUM2">
                                                                  <shadow type="math_number" id="num_1_plus"><field name="NUM">1</field></shadow>
                                                                </value>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </statement>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </next>
                                              </block>
                                            </statement>
                                            <next>
                                              <block type="scratch_say" id="say_ans">
                                                <value name="TEXT">
                                                  <block type="data_variable" id="out_ans">
                                                    <field name="VARIABLE" id="v_ans" variabletype="">ans</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
