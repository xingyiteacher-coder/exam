<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="var_n" islocal="false" iscloud="false">N</variable>
    <variable type="" id="var_sum" islocal="false" iscloud="false">總和</variable>
    <variable type="" id="var_i" islocal="false" iscloud="false">i</variable>
  </variables>
  <block type="event_whenflagclicked" id="flag" x="50" y="50">
    <next>
      <block type="scratch_ask" id="ask_n">
        <value name="QUESTION">
          <shadow type="text" id="txt_n"><field name="TEXT">N</field></shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_n">
            <field name="VARIABLE" id="var_n" variabletype="">N</field>
            <value name="VALUE"><block type="scratch_answer" id="ans_n"></block></value>
            <next>
              <block type="data_setvariableto" id="init_sum">
                <field name="VARIABLE" id="var_sum" variabletype="">總和</field>
                <value name="VALUE"><shadow type="math_number" id="num0"><field name="NUM">0</field></shadow></value>
                <next>
                  <block type="data_setvariableto" id="init_i">
                    <field name="VARIABLE" id="var_i" variabletype="">i</field>
                    <value name="VALUE"><shadow type="math_number" id="num1"><field name="NUM">1</field></shadow></value>
                    <next>
                      <block type="control_repeat" id="loop">
                        <value name="TIMES">
                          <block type="data_variable" id="get_n">
                            <field name="VARIABLE" id="var_n" variabletype="">N</field>
                          </block>
                        </value>
                        <statement name="SUBSTACK">
                          <block type="data_setvariableto" id="add_sum">
                            <field name="VARIABLE" id="var_sum" variabletype="">總和</field>
                            <value name="VALUE">
                              <block type="operator_arithmetic" id="plus">
                                <field name="OPERATOR">+</field>
                                <value name="NUM1">
                                  <block type="data_variable" id="get_sum">
                                    <field name="VARIABLE" id="var_sum" variabletype="">總和</field>
                                  </block>
                                </value>
                                <value name="NUM2">
                                  <block type="data_variable" id="get_i">
                                    <field name="VARIABLE" id="var_i" variabletype="">i</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <next>
                              <block type="data_changevariableby" id="inc_i">
                                <field name="VARIABLE" id="var_i" variabletype="">i</field>
                                <value name="VALUE"><shadow type="math_number" id="step1"><field name="NUM">1</field></shadow></value>
                              </block>
                            </next>
                          </block>
                        </statement>
                        <next>
                          <block type="scratch_say" id="say_res">
                            <value name="TEXT">
                              <block type="data_variable" id="out_sum">
                                <field name="VARIABLE" id="var_sum" variabletype="">總和</field>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>