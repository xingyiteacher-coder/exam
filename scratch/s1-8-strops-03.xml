<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="v_s" islocal="false" iscloud="false">字串</variable>
    <variable type="" id="v_k" islocal="false" iscloud="false">k</variable>
    <variable type="" id="v_seg" islocal="false" iscloud="false">結果</variable>
    <variable type="" id="v_curr_k" islocal="false" iscloud="false">當前段數</variable>
    <variable type="" id="v_i" islocal="false" iscloud="false">i</variable>
  </variables>
  <block type="event_whenflagclicked" id="flag_so3" x="10" y="10">
    <next>
      <block type="scratch_ask" id="ask_so3_s">
        <value name="QUESTION">
          <shadow type="text" id="txt_so3_s"><field name="TEXT">字串</field></shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_so3_s">
            <field name="VARIABLE" id="v_s" variabletype="">字串</field>
            <value name="VALUE">
              <block type="scratch_answer" id="ans_so3_s"></block>
            </value>
            <next>
              <block type="scratch_ask" id="ask_so3_k">
                <value name="QUESTION">
                  <shadow type="text" id="txt_so3_k"><field name="TEXT">k</field></shadow>
                </value>
                <next>
                  <block type="data_setvariableto" id="set_so3_k">
                    <field name="VARIABLE" id="v_k" variabletype="">k</field>
                    <value name="VALUE">
                      <block type="scratch_answer" id="ans_so3_k"></block>
                    </value>
                    <next>
                      <block type="data_setvariableto" id="init_seg_so3">
                        <field name="VARIABLE" id="v_seg" variabletype="">結果</field>
                        <value name="VALUE">
                          <shadow type="text" id="empty_so3"><field name="TEXT"></field></shadow>
                        </value>
                        <next>
                          <block type="data_setvariableto" id="init_curr_k_so3">
                            <field name="VARIABLE" id="v_curr_k" variabletype="">當前段數</field>
                            <value name="VALUE">
                              <shadow type="text" id="one_so3_1"><field name="TEXT">1</field></shadow>
                            </value>
                            <next>
                              <block type="data_setvariableto" id="init_i_so3">
                                <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                <value name="VALUE">
                                  <shadow type="text" id="one_so3_2"><field name="TEXT">1</field></shadow>
                                </value>
                                <next>
                                  <block type="control_repeat" id="rep_so3">
                                    <value name="TIMES">
                                      <block type="operator_length" id="len_so3">
                                        <value name="STRING">
                                          <block type="data_variable" id="get_s_len_so3">
                                            <field name="VARIABLE" id="v_s" variabletype="">字串</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <statement name="SUBSTACK">
                                      <block type="control_if_else" id="if_else_so3">
                                        <value name="CONDITION">
                                          <block type="operator_compare" id="cmp_comma_so3">
                                            <field name="OPERATOR">==</field>
                                            <value name="OPERAND1">
                                              <shadow type="text" id="sh_op1_comma_so3"><field name="TEXT"></field></shadow>
                                              <block type="operator_letter_of" id="let_so3">
                                                <value name="STRING">
                                                  <shadow type="text" id="sh_str_so3"><field name="TEXT"></field></shadow>
                                                  <block type="data_variable" id="get_s_let_so3">
                                                    <field name="VARIABLE" id="v_s" variabletype="">字串</field>
                                                  </block>
                                                </value>
                                                <value name="LETTER">
                                                  <shadow type="math_whole_number" id="sh_i_so3"><field name="NUM">1</field></shadow>
                                                  <block type="data_variable" id="get_i_so3">
                                                    <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <value name="OPERAND2">
                                              <shadow type="text" id="comma_so3"><field name="TEXT">,</field></shadow>
                                            </value>
                                          </block>
                                        </value>
                                        <statement name="SUBSTACK">
                                          <block type="data_changevariableby" id="inc_curr_k_so3">
                                            <field name="VARIABLE" id="v_curr_k" variabletype="">當前段數</field>
                                            <value name="VALUE">
                                              <shadow type="math_number" id="one_so3_3"><field name="NUM">1</field></shadow>
                                            </value>
                                          </block>
                                        </statement>
                                        <statement name="SUBSTACK2">
                                          <block type="control_if" id="if_match_k_so3">
                                            <value name="CONDITION">
                                              <block type="operator_compare" id="cmp_k_so3">
                                                <field name="OPERATOR">==</field>
                                                <value name="OPERAND1">
                                                  <shadow type="text" id="sh_op1_k_so3"><field name="TEXT"></field></shadow>
                                                  <block type="data_variable" id="get_curr_k_so3">
                                                    <field name="VARIABLE" id="v_curr_k" variabletype="">當前段數</field>
                                                  </block>
                                                </value>
                                                <value name="OPERAND2">
                                                  <shadow type="text" id="sh_op2_k_so3"><field name="TEXT"></field></shadow>
                                                  <block type="data_variable" id="get_k_so3">
                                                    <field name="VARIABLE" id="v_k" variabletype="">k</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <statement name="SUBSTACK">
                                              <block type="data_setvariableto" id="append_so3">
                                                <field name="VARIABLE" id="v_seg" variabletype="">結果</field>
                                                <value name="VALUE">
                                                  <block type="operator_join" id="join_so3">
                                                    <value name="OPERAND1">
                                                      <shadow type="text" id="sh_seg_so3"><field name="TEXT"></field></shadow>
                                                      <block type="data_variable" id="get_seg_so3">
                                                        <field name="VARIABLE" id="v_seg" variabletype="">結果</field>
                                                      </block>
                                                    </value>
                                                    <value name="OPERAND2">
                                                      <shadow type="text" id="sh_let_append_so3"><field name="TEXT"></field></shadow>
                                                      <block type="operator_letter_of" id="let_append_so3">
                                                        <value name="STRING">
                                                          <shadow type="text" id="sh_str_app_so3"><field name="TEXT"></field></shadow>
                                                          <block type="data_variable" id="get_s_app_so3">
                                                            <field name="VARIABLE" id="v_s" variabletype="">字串</field>
                                                          </block>
                                                        </value>
                                                        <value name="LETTER">
                                                          <shadow type="math_whole_number" id="sh_i_app_so3"><field name="NUM">1</field></shadow>
                                                          <block type="data_variable" id="get_i_app_so3">
                                                            <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                              </block>
                                            </statement>
                                          </block>
                                        </statement>
                                        <next>
                                          <block type="data_changevariableby" id="inc_i_so3">
                                            <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                            <value name="VALUE">
                                              <shadow type="math_number" id="one_so3_4"><field name="NUM">1</field></shadow>
                                            </value>
                                          </block>
                                        </next>
                                      </block>
                                    </statement>
                                    <next>
                                      <block type="scratch_say" id="say_so3">
                                        <value name="TEXT">
                                          <block type="data_variable" id="out_seg_so3">
                                            <field name="VARIABLE" id="v_seg" variabletype="">結果</field>
                                          </block>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>