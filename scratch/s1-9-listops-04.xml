<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="v_N" islocal="false" iscloud="false">N</variable>
    <variable type="" id="v_v" islocal="false" iscloud="false">v</variable>
    <variable type="" id="v_i" islocal="false" iscloud="false">i</variable>
    <variable type="" id="v_cnt" islocal="false" iscloud="false">count</variable>
    <variable type="" id="v_res" islocal="false" iscloud="false">結果</variable>
    <variable type="list" id="l_data" islocal="false" iscloud="false">資料</variable>
  </variables>
  <block type="event_whenflagclicked" id="flag1" x="10" y="10">
    <next>
      <block type="data_deletealloflist" id="del1">
        <field name="LIST" id="l_data" variabletype="list">資料</field>
        <next>
          <!-- 1. 讀取 N -->
          <block type="scratch_ask" id="ask_N">
            <value name="QUESTION">
              <shadow type="text" id="txt_N"><field name="TEXT">N</field></shadow>
            </value>
            <next>
              <block type="data_setvariableto" id="set_N">
                <field name="VARIABLE" id="v_N" variabletype="">N</field>
                <value name="VALUE">
                  <block type="scratch_answer" id="ans_N"></block>
                </value>
                <next>
                  <!-- 2. 讀取 N 個元素存入清單 -->
                  <block type="control_repeat" id="rep_read">
                    <value name="TIMES">
                      <block type="data_variable" id="get_N">
                        <field name="VARIABLE" id="v_N" variabletype="">N</field>
                      </block>
                    </value>
                    <statement name="SUBSTACK">
                      <block type="scratch_ask" id="ask_elem">
                        <value name="QUESTION">
                          <shadow type="text" id="txt_elem"><field name="TEXT">x</field></shadow>
                        </value>
                        <next>
                          <block type="data_addtolist" id="add_elem">
                            <field name="LIST" id="l_data" variabletype="list">資料</field>
                            <value name="ITEM">
                              <block type="scratch_answer" id="ans_elem"></block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <!-- 3. 讀取要刪除的值 v -->
                      <block type="scratch_ask" id="ask_v">
                        <value name="QUESTION">
                          <shadow type="text" id="txt_v"><field name="TEXT">v</field></shadow>
                        </value>
                        <next>
                          <block type="data_setvariableto" id="set_v">
                            <field name="VARIABLE" id="v_v" variabletype="">v</field>
                            <value name="VALUE">
                              <block type="scratch_answer" id="ans_v"></block>
                            </value>
                            <next>
                              <!-- 4. 初始化變數 -->
                              <block type="data_setvariableto" id="init_res">
                                <field name="VARIABLE" id="v_res" variabletype="">結果</field>
                                <value name="VALUE">
                                  <shadow type="text" id="txt_init_res"><field name="TEXT"></field></shadow>
                                </value>
                                <next>
                                  <block type="data_setvariableto" id="init_cnt">
                                    <field name="VARIABLE" id="v_cnt" variabletype="">count</field>
                                    <value name="VALUE">
                                      <shadow type="math_number" id="num_zero_cnt"><field name="NUM">0</field></shadow>
                                    </value>
                                    <next>
                                      <block type="data_setvariableto" id="init_i">
                                        <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                        <value name="VALUE">
                                          <shadow type="math_number" id="num_one_i"><field name="NUM">1</field></shadow>
                                        </value>
                                        <next>
                                          <!-- 5. 巡覽清單進行過濾 -->
                                          <block type="control_repeat" id="rep_filter">
                                            <value name="TIMES">
                                              <block type="data_lengthoflist" id="len_data">
                                                <field name="LIST" id="l_data" variabletype="list">資料</field>
                                              </block>
                                            </value>
                                            <statement name="SUBSTACK">
                                              <block type="control_if_else" id="if_else_v">
                                                <value name="CONDITION">
                                                  <block type="operator_compare" id="cmp_v">
                                                    <field name="OPERATOR">==</field>
                                                    <value name="OPERAND1">
                                                      <block type="data_itemoflist" id="item_i">
                                                        <field name="LIST" id="l_data" variabletype="list">資料</field>
                                                        <value name="INDEX">
                                                          <block type="data_variable" id="get_i">
                                                            <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </value>
                                                    <value name="OPERAND2">
                                                      <block type="data_variable" id="get_v">
                                                        <field name="VARIABLE" id="v_v" variabletype="">v</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                                <statement name="SUBSTACK2">
                                                  <!-- 當元素不等於 v 時進行拼接 -->
                                                  <block type="control_if_else" id="if_else_first">
                                                    <value name="CONDITION">
                                                      <block type="operator_compare" id="cmp_cnt">
                                                        <field name="OPERATOR">==</field>
                                                        <value name="OPERAND1">
                                                          <block type="data_variable" id="get_cnt1">
                                                            <field name="VARIABLE" id="v_cnt" variabletype="">count</field>
                                                          </block>
                                                        </value>
                                                        <value name="OPERAND2">
                                                          <shadow type="math_number" id="num_zero1"><field name="NUM">0</field></shadow>
                                                        </value>
                                                      </block>
                                                    </value>
                                                    <statement name="SUBSTACK">
                                                      <block type="data_setvariableto" id="set_res_first">
                                                        <field name="VARIABLE" id="v_res" variabletype="">結果</field>
                                                        <value name="VALUE">
                                                          <block type="data_itemoflist" id="item_i_first">
                                                            <field name="LIST" id="l_data" variabletype="list">資料</field>
                                                            <value name="INDEX">
                                                              <block type="data_variable" id="get_i_first">
                                                                <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </value>
                                                        <next>
                                                          <block type="data_setvariableto" id="set_cnt_one">
                                                            <field name="VARIABLE" id="v_cnt" variabletype="">count</field>
                                                            <value name="VALUE">
                                                              <shadow type="math_number" id="num_one_cnt"><field name="NUM">1</field></shadow>
                                                            </value>
                                                          </block>
                                                        </next>
                                                      </block>
                                                    </statement>
                                                    <statement name="SUBSTACK2">
                                                      <block type="data_setvariableto" id="append_res">
                                                        <field name="VARIABLE" id="v_res" variabletype="">結果</field>
                                                        <value name="VALUE">
                                                          <block type="operator_join" id="join_outer">
                                                            <value name="OPERAND1">
                                                              <block type="data_variable" id="get_res_loop">
                                                                <field name="VARIABLE" id="v_res" variabletype="">結果</field>
                                                              </block>
                                                            </value>
                                                            <value name="OPERAND2">
                                                              <block type="operator_join" id="join_inner">
                                                                <value name="OPERAND1">
                                                                  <shadow type="text" id="sp_txt"><field name="TEXT"> </field></shadow>
                                                                </value>
                                                                <value name="OPERAND2">
                                                                  <block type="data_itemoflist" id="item_i_loop">
                                                                    <field name="LIST" id="l_data" variabletype="list">資料</field>
                                                                    <value name="INDEX">
                                                                      <block type="data_variable" id="get_i_loop">
                                                                        <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                                                      </block>
                                                                    </value>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </statement>
                                                  </block>
                                                </statement>
                                                <next>
                                                  <block type="data_changevariableby" id="inc_i">
                                                    <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                                    <value name="VALUE">
                                                      <shadow type="math_number" id="num_step_i"><field name="NUM">1</field></shadow>
                                                    </value>
                                                  </block>
                                                </next>
                                              </block>
                                            </statement>
                                            <next>
                                              <!-- 6. 若完全無留存元素，設為 empty -->
                                              <block type="control_if" id="if_empty">
                                                <value name="CONDITION">
                                                  <block type="operator_compare" id="cmp_cnt_zero">
                                                    <field name="OPERATOR">==</field>
                                                    <value name="OPERAND1">
                                                      <block type="data_variable" id="get_cnt_check">
                                                        <field name="VARIABLE" id="v_cnt" variabletype="">count</field>
                                                      </block>
                                                    </value>
                                                    <value name="OPERAND2">
                                                      <shadow type="math_number" id="num_zero_check"><field name="NUM">0</field></shadow>
                                                    </value>
                                                  </block>
                                                </value>
                                                <statement name="SUBSTACK">
                                                  <block type="data_setvariableto" id="set_empty">
                                                    <field name="VARIABLE" id="v_res" variabletype="">結果</field>
                                                    <value name="VALUE">
                                                      <shadow type="text" id="txt_empty"><field name="TEXT">empty</field></shadow>
                                                    </value>
                                                  </block>
                                                </statement>
                                                <next>
                                                  <!-- 7. 輸出結果 -->
                                                  <block type="scratch_say" id="say_out">
                                                    <value name="TEXT">
                                                      <block type="data_variable" id="get_res_out">
                                                        <field name="VARIABLE" id="v_res" variabletype="">結果</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>