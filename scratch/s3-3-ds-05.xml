<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="v_n" islocal="false" iscloud="false">N</variable>
    <variable type="" id="v_num_str" islocal="false" iscloud="false">num_str</variable>
    <variable type="" id="v_temp" islocal="false" iscloud="false">temp</variable>
    <variable type="" id="v_p" islocal="false" iscloud="false">p</variable>
    <variable type="" id="v_ch" islocal="false" iscloud="false">ch</variable>
    <variable type="" id="v_key_idx" islocal="false" iscloud="false">key_idx</variable>
    <variable type="" id="v_max_count" islocal="false" iscloud="false">max_count</variable>
    <variable type="" id="v_mode" islocal="false" iscloud="false">mode</variable>
    <variable type="" id="v_curr_key" islocal="false" iscloud="false">curr_key</variable>
    <variable type="" id="v_curr_cnt" islocal="false" iscloud="false">curr_cnt</variable>
    <variable type="" id="v_idx" islocal="false" iscloud="false">idx</variable>
    <variable type="list" id="l_keys" islocal="false" iscloud="false">keys_list</variable>
    <variable type="list" id="l_counts" islocal="false" iscloud="false">counts_list</variable>
  </variables>
  <block type="event_whenflagclicked" id="start" x="20" y="20">
    <next>
      <block type="scratch_ask" id="ask_n">
        <value name="QUESTION">
          <shadow type="text" id="q_n"><field name="TEXT">請輸入 N</field></shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_n">
            <field name="VARIABLE" id="v_n" variabletype="">N</field>
            <value name="VALUE"><block type="scratch_answer" id="ans_n"></block></value>
            <next>
              <block type="data_deletealloflist" id="clear_keys">
                <field name="LIST" id="l_keys" variabletype="list">keys_list</field>
                <next>
                  <block type="data_deletealloflist" id="clear_counts">
                    <field name="LIST" id="l_counts" variabletype="list">counts_list</field>
                    <next>
                      <block type="scratch_ask" id="ask_nums">
                        <value name="QUESTION">
                          <shadow type="text" id="q_nums"><field name="TEXT">請輸入數字</field></shadow>
                        </value>
                        <next>
                          <block type="data_setvariableto" id="set_num_str">
                            <field name="VARIABLE" id="v_num_str" variabletype="">num_str</field>
                            <value name="VALUE"><block type="scratch_answer" id="ans_nums"></block></value>
                            <next>
                              <block type="data_setvariableto" id="init_temp">
                                <field name="VARIABLE" id="v_temp" variabletype="">temp</field>
                                <value name="VALUE"><shadow type="text" id="empty_temp"><field name="TEXT"></field></shadow></value>
                                <next>
                                  <block type="data_setvariableto" id="init_p">
                                    <field name="VARIABLE" id="v_p" variabletype="">p</field>
                                    <value name="VALUE"><shadow type="math_number" id="num_1p"><field name="NUM">1</field></shadow></value>
                                    <next>
                                      <!-- 逐字元解析字串 -->
                                      <block type="control_repeat" id="parse_loop">
                                        <value name="TIMES">
                                          <block type="operator_length" id="len_str">
                                            <value name="STRING">
                                              <block type="data_variable" id="var_num_str">
                                                <field name="VARIABLE" id="v_num_str" variabletype="">num_str</field>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                        <statement name="SUBSTACK">
                                          <block type="data_setvariableto" id="set_ch">
                                            <field name="VARIABLE" id="v_ch" variabletype="">ch</field>
                                            <value name="VALUE">
                                              <block type="operator_letter_of" id="get_ch">
                                                <value name="STRING">
                                                  <block type="data_variable" id="var_num_str2">
                                                    <field name="VARIABLE" id="v_num_str" variabletype="">num_str</field>
                                                  </block>
                                                </value>
                                                <value name="LETTER">
                                                  <block type="data_variable" id="var_p1">
                                                    <field name="VARIABLE" id="v_p" variabletype="">p</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <next>
                                              <block type="control_if_else" id="check_space">
                                                <value name="CONDITION">
                                                  <block type="operator_compare" id="cmp_space_x">
                                                    <field name="OPERATOR">==</field>
                                                    <value name="OPERAND1">
                                                      <block type="operator_join" id="join_x_ch">
                                                        <value name="OPERAND1">
                                                          <shadow type="text" id="txt_x"><field name="TEXT">x</field></shadow>
                                                        </value>
                                                        <value name="OPERAND2">
                                                          <block type="data_variable" id="var_ch_in_join">
                                                            <field name="VARIABLE" id="v_ch" variabletype="">ch</field>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </value>
                                                    <value name="OPERAND2">
                                                      <shadow type="text" id="txt_x_space"><field name="TEXT">x </field></shadow>
                                                    </value>
                                                  </block>
                                                </value>
                                                <statement name="SUBSTACK">
                                                  <block type="control_if" id="check_temp_len">
                                                    <value name="CONDITION">
                                                      <block type="operator_compare" id="cmp_gt_0">
                                                        <field name="OPERATOR">&gt;</field>
                                                        <value name="OPERAND1">
                                                          <block type="operator_length" id="len_temp">
                                                            <value name="STRING">
                                                              <block type="data_variable" id="var_temp1">
                                                                <field name="VARIABLE" id="v_temp" variabletype="">temp</field>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </value>
                                                        <value name="OPERAND2">
                                                          <shadow type="text" id="txt_0"><field name="TEXT">0</field></shadow>
                                                        </value>
                                                      </block>
                                                    </value>
                                                    <statement name="SUBSTACK">
                                                      <block type="data_setvariableto" id="set_key_idx">
                                                        <field name="VARIABLE" id="v_key_idx" variabletype="">key_idx</field>
                                                        <value name="VALUE">
                                                          <block type="data_itemnumoflist" id="find_key">
                                                            <field name="LIST" id="l_keys" variabletype="list">keys_list</field>
                                                            <value name="ITEM">
                                                              <block type="data_variable" id="var_temp_find">
                                                                <field name="VARIABLE" id="v_temp" variabletype="">temp</field>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </value>
                                                        <next>
                                                          <block type="control_if_else" id="check_key_exists">
                                                            <value name="CONDITION">
                                                              <block type="operator_compare" id="cmp_key_exists">
                                                                <field name="OPERATOR">&gt;</field>
                                                                <value name="OPERAND1">
                                                                  <block type="data_variable" id="var_key_idx_val">
                                                                    <field name="VARIABLE" id="v_key_idx" variabletype="">key_idx</field>
                                                                  </block>
                                                                </value>
                                                                <value name="OPERAND2">
                                                                  <shadow type="text" id="txt_0_key"><field name="TEXT">0</field></shadow>
                                                                </value>
                                                              </block>
                                                            </value>
                                                            <statement name="SUBSTACK">
                                                              <block type="data_replaceitemoflist" id="inc_cnt">
                                                                <field name="LIST" id="l_counts" variabletype="list">counts_list</field>
                                                                <value name="INDEX">
                                                                  <block type="data_variable" id="var_key_idx_use">
                                                                    <field name="VARIABLE" id="v_key_idx" variabletype="">key_idx</field>
                                                                  </block>
                                                                </value>
                                                                <value name="ITEM">
                                                                  <block type="operator_add" id="add_cnt">
                                                                    <value name="NUM1">
                                                                      <block type="data_itemoflist" id="get_cnt">
                                                                        <field name="LIST" id="l_counts" variabletype="list">counts_list</field>
                                                                        <value name="INDEX">
                                                                          <block type="data_variable" id="var_key_idx_use2">
                                                                            <field name="VARIABLE" id="v_key_idx" variabletype="">key_idx</field>
                                                                          </block>
                                                                        </value>
                                                                      </block>
                                                                    </value>
                                                                    <value name="NUM2">
                                                                      <shadow type="math_number" id="num_1_add"><field name="NUM">1</field></shadow>
                                                                    </value>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </statement>
                                                            <statement name="SUBSTACK2">
                                                              <block type="data_addtolist" id="add_key">
                                                                <field name="LIST" id="l_keys" variabletype="list">keys_list</field>
                                                                <value name="ITEM">
                                                                  <block type="data_variable" id="var_temp_add">
                                                                    <field name="VARIABLE" id="v_temp" variabletype="">temp</field>
                                                                  </block>
                                                                </value>
                                                                <next>
                                                                  <block type="data_addtolist" id="add_count">
                                                                    <field name="LIST" id="l_counts" variabletype="list">counts_list</field>
                                                                    <value name="ITEM">
                                                                      <shadow type="math_number" id="num_1_cnt"><field name="NUM">1</field></shadow>
                                                                    </value>
                                                                  </block>
                                                                </next>
                                                              </block>
                                                            </statement>
                                                            <next>
                                                              <block type="data_setvariableto" id="clear_temp">
                                                                <field name="VARIABLE" id="v_temp" variabletype="">temp</field>
                                                                <value name="VALUE"><shadow type="text" id="empty_temp2"><field name="TEXT"></field></shadow></value>
                                                              </block>
                                                            </next>
                                                          </block>
                                                        </next>
                                                      </block>
                                                    </statement>
                                                  </block>
                                                </statement>
                                                <statement name="SUBSTACK2">
                                                  <block type="data_setvariableto" id="join_ch">
                                                    <field name="VARIABLE" id="v_temp" variabletype="">temp</field>
                                                    <value name="VALUE">
                                                      <block type="operator_join" id="join_op">
                                                        <value name="OPERAND1">
                                                          <block type="data_variable" id="var_temp3">
                                                            <field name="VARIABLE" id="v_temp" variabletype="">temp</field>
                                                          </block>
                                                        </value>
                                                        <value name="OPERAND2">
                                                          <block type="data_variable" id="var_ch2">
                                                            <field name="VARIABLE" id="v_ch" variabletype="">ch</field>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </statement>
                                                <next>
                                                  <block type="data_changevariableby" id="inc_p">
                                                    <field name="VARIABLE" id="v_p" variabletype="">p</field>
                                                    <value name="VALUE"><shadow type="math_number" id="num_1p2"><field name="NUM">1</field></shadow></value>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </statement>
                                        <next>
                                          <!-- 處理最後一個數字 -->
                                          <block type="control_if" id="check_last_temp">
                                            <value name="CONDITION">
                                              <block type="operator_compare" id="cmp_last_gt_0">
                                                <field name="OPERATOR">&gt;</field>
                                                <value name="OPERAND1">
                                                  <block type="operator_length" id="len_temp_last">
                                                    <value name="STRING">
                                                      <block type="data_variable" id="var_temp4">
                                                        <field name="VARIABLE" id="v_temp" variabletype="">temp</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                                <value name="OPERAND2">
                                                  <shadow type="text" id="txt_0_last"><field name="TEXT">0</field></shadow>
                                                </value>
                                              </block>
                                            </value>
                                            <statement name="SUBSTACK">
                                              <block type="data_setvariableto" id="set_key_idx_last">
                                                <field name="VARIABLE" id="v_key_idx" variabletype="">key_idx</field>
                                                <value name="VALUE">
                                                  <block type="data_itemnumoflist" id="find_key_last">
                                                    <field name="LIST" id="l_keys" variabletype="list">keys_list</field>
                                                    <value name="ITEM">
                                                      <block type="data_variable" id="var_temp_find_last">
                                                        <field name="VARIABLE" id="v_temp" variabletype="">temp</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                                <next>
                                                  <block type="control_if_else" id="check_key_exists_last">
                                                    <value name="CONDITION">
                                                      <block type="operator_compare" id="cmp_key_exists_last">
                                                        <field name="OPERATOR">&gt;</field>
                                                        <value name="OPERAND1">
                                                          <block type="data_variable" id="var_key_idx_val_last">
                                                            <field name="VARIABLE" id="v_key_idx" variabletype="">key_idx</field>
                                                          </block>
                                                        </value>
                                                        <value name="OPERAND2">
                                                          <shadow type="text" id="txt_0_key_last"><field name="TEXT">0</field></shadow>
                                                        </value>
                                                      </block>
                                                    </value>
                                                    <statement name="SUBSTACK">
                                                      <block type="data_replaceitemoflist" id="inc_cnt_last">
                                                        <field name="LIST" id="l_counts" variabletype="list">counts_list</field>
                                                        <value name="INDEX">
                                                          <block type="data_variable" id="var_key_idx_use_last">
                                                            <field name="VARIABLE" id="v_key_idx" variabletype="">key_idx</field>
                                                          </block>
                                                        </value>
                                                        <value name="ITEM">
                                                          <block type="operator_add" id="add_cnt_last">
                                                            <value name="NUM1">
                                                              <block type="data_itemoflist" id="get_cnt_last">
                                                                <field name="LIST" id="l_counts" variabletype="list">counts_list</field>
                                                                <value name="INDEX">
                                                                  <block type="data_variable" id="var_key_idx_use2_last">
                                                                    <field name="VARIABLE" id="v_key_idx" variabletype="">key_idx</field>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </value>
                                                            <value name="NUM2">
                                                              <shadow type="math_number" id="num_1_add_last"><field name="NUM">1</field></shadow>
                                                            </value>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </statement>
                                                    <statement name="SUBSTACK2">
                                                      <block type="data_addtolist" id="add_key_last">
                                                        <field name="LIST" id="l_keys" variabletype="list">keys_list</field>
                                                        <value name="ITEM">
                                                          <block type="data_variable" id="var_temp_add_last">
                                                            <field name="VARIABLE" id="v_temp" variabletype="">temp</field>
                                                          </block>
                                                        </value>
                                                        <next>
                                                          <block type="data_addtolist" id="add_count_last">
                                                            <field name="LIST" id="l_counts" variabletype="list">counts_list</field>
                                                            <value name="ITEM">
                                                              <shadow type="math_number" id="num_1_cnt_last"><field name="NUM">1</field></shadow>
                                                            </value>
                                                          </block>
                                                        </next>
                                                      </block>
                                                    </statement>
                                                  </block>
                                                </next>
                                              </block>
                                            </statement>
                                            <next>
                                              <!-- 尋找眾數（並列取最小） -->
                                              <block type="data_setvariableto" id="init_max_count">
                                                <field name="VARIABLE" id="v_max_count" variabletype="">max_count</field>
                                                <value name="VALUE"><shadow type="math_number" id="num_0_mc"><field name="NUM">0</field></shadow></value>
                                                <next>
                                                  <block type="data_setvariableto" id="init_mode">
                                                    <field name="VARIABLE" id="v_mode" variabletype="">mode</field>
                                                    <value name="VALUE"><shadow type="text" id="empty_mode"><field name="TEXT"></field></shadow></value>
                                                    <next>
                                                      <block type="data_setvariableto" id="init_idx">
                                                        <field name="VARIABLE" id="v_idx" variabletype="">idx</field>
                                                        <value name="VALUE"><shadow type="math_number" id="num_1_idx"><field name="NUM">1</field></shadow></value>
                                                        <next>
                                                          <block type="control_repeat" id="find_mode_loop">
                                                            <value name="TIMES">
                                                              <block type="data_lengthoflist" id="len_keys">
                                                                <field name="LIST" id="l_keys" variabletype="list">keys_list</field>
                                                              </block>
                                                            </value>
                                                            <statement name="SUBSTACK">
                                                              <block type="data_setvariableto" id="set_curr_key">
                                                                <field name="VARIABLE" id="v_curr_key" variabletype="">curr_key</field>
                                                                <value name="VALUE">
                                                                  <block type="data_itemoflist" id="get_curr_key">
                                                                    <field name="LIST" id="l_keys" variabletype="list">keys_list</field>
                                                                    <value name="INDEX">
                                                                      <block type="data_variable" id="var_idx_use1">
                                                                        <field name="VARIABLE" id="v_idx" variabletype="">idx</field>
                                                                      </block>
                                                                    </value>
                                                                  </block>
                                                                </value>
                                                                <next>
                                                                  <block type="data_setvariableto" id="set_curr_cnt">
                                                                    <field name="VARIABLE" id="v_curr_cnt" variabletype="">curr_cnt</field>
                                                                    <value name="VALUE">
                                                                      <block type="data_itemoflist" id="get_curr_cnt">
                                                                        <field name="LIST" id="l_counts" variabletype="list">counts_list</field>
                                                                        <value name="INDEX">
                                                                          <block type="data_variable" id="var_idx_use2">
                                                                            <field name="VARIABLE" id="v_idx" variabletype="">idx</field>
                                                                          </block>
                                                                        </value>
                                                                      </block>
                                                                    </value>
                                                                    <next>
                                                                      <block type="control_if_else" id="check_cnt_gt">
                                                                        <value name="CONDITION">
                                                                          <block type="operator_compare" id="cmp_cnt_gt">
                                                                            <field name="OPERATOR">&gt;</field>
                                                                            <value name="OPERAND1">
                                                                              <block type="data_variable" id="var_curr_cnt_use">
                                                                                <field name="VARIABLE" id="v_curr_cnt" variabletype="">curr_cnt</field>
                                                                              </block>
                                                                            </value>
                                                                            <value name="OPERAND2">
                                                                              <block type="data_variable" id="var_max_cnt_use">
                                                                                <field name="VARIABLE" id="v_max_count" variabletype="">max_count</field>
                                                                              </block>
                                                                            </value>
                                                                          </block>
                                                                        </value>
                                                                        <statement name="SUBSTACK">
                                                                          <block type="data_setvariableto" id="update_max_cnt">
                                                                            <field name="VARIABLE" id="v_max_count" variabletype="">max_count</field>
                                                                            <value name="VALUE">
                                                                              <block type="data_variable" id="var_curr_cnt_use2">
                                                                                <field name="VARIABLE" id="v_curr_cnt" variabletype="">curr_cnt</field>
                                                                              </block>
                                                                            </value>
                                                                            <next>
                                                                              <block type="data_setvariableto" id="update_mode">
                                                                                <field name="VARIABLE" id="v_mode" variabletype="">mode</field>
                                                                                <value name="VALUE">
                                                                                  <block type="data_variable" id="var_curr_key_use">
                                                                                    <field name="VARIABLE" id="v_curr_key" variabletype="">curr_key</field>
                                                                                  </block>
                                                                                </value>
                                                                              </block>
                                                                            </next>
                                                                          </block>
                                                                        </statement>
                                                                        <statement name="SUBSTACK2">
                                                                          <block type="control_if" id="check_cnt_eq">
                                                                            <value name="CONDITION">
                                                                              <block type="operator_compare" id="cmp_cnt_eq">
                                                                                <field name="OPERATOR">==</field>
                                                                                <value name="OPERAND1">
                                                                                  <block type="data_variable" id="var_curr_cnt_use3">
                                                                                    <field name="VARIABLE" id="v_curr_cnt" variabletype="">curr_cnt</field>
                                                                                  </block>
                                                                                </value>
                                                                                <value name="OPERAND2">
                                                                                  <block type="data_variable" id="var_max_cnt_use2">
                                                                                    <field name="VARIABLE" id="v_max_count" variabletype="">max_count</field>
                                                                                  </block>
                                                                                </value>
                                                                              </block>
                                                                            </value>
                                                                            <statement name="SUBSTACK">
                                                                              <block type="control_if" id="check_key_lt">
                                                                                <value name="CONDITION">
                                                                                  <block type="operator_compare" id="cmp_key_lt">
                                                                                    <field name="OPERATOR">&lt;</field>
                                                                                    <value name="OPERAND1">
                                                                                      <block type="operator_multiply" id="mult_1_key">
                                                                                        <value name="NUM1">
                                                                                          <block type="data_variable" id="var_curr_key_use2">
                                                                                            <field name="VARIABLE" id="v_curr_key" variabletype="">curr_key</field>
                                                                                          </block>
                                                                                        </value>
                                                                                        <value name="NUM2">
                                                                                          <shadow type="math_number" id="num_1_m1"><field name="NUM">1</field></shadow>
                                                                                        </value>
                                                                                      </block>
                                                                                    </value>
                                                                                    <value name="OPERAND2">
                                                                                      <block type="operator_multiply" id="mult_1_mode">
                                                                                        <value name="NUM1">
                                                                                          <block type="data_variable" id="var_mode_use">
                                                                                            <field name="VARIABLE" id="v_mode" variabletype="">mode</field>
                                                                                          </block>
                                                                                        </value>
                                                                                        <value name="NUM2">
                                                                                          <shadow type="math_number" id="num_1_m2"><field name="NUM">1</field></shadow>
                                                                                        </value>
                                                                                      </block>
                                                                                    </value>
                                                                                  </block>
                                                                                </value>
                                                                                <statement name="SUBSTACK">
                                                                                  <block type="data_setvariableto" id="update_mode_tie">
                                                                                    <field name="VARIABLE" id="v_mode" variabletype="">mode</field>
                                                                                    <value name="VALUE">
                                                                                      <block type="data_variable" id="var_curr_key_use3">
                                                                                        <field name="VARIABLE" id="v_curr_key" variabletype="">curr_key</field>
                                                                                      </block>
                                                                                    </value>
                                                                                  </block>
                                                                                </statement>
                                                                              </block>
                                                                            </statement>
                                                                          </block>
                                                                        </statement>
                                                                        <next>
                                                                          <block type="data_changevariableby" id="inc_idx">
                                                                            <field name="VARIABLE" id="v_idx" variabletype="">idx</field>
                                                                            <value name="VALUE"><shadow type="math_number" id="num_1_inc_idx"><field name="NUM">1</field></shadow></value>
                                                                          </block>
                                                                        </next>
                                                                      </block>
                                                                    </next>
                                                                  </block>
                                                                </next>
                                                              </block>
                                                            </statement>
                                                            <next>
                                                              <block type="scratch_say" id="say_mode">
                                                                <value name="TEXT">
                                                                  <block type="data_variable" id="var_mode_out">
                                                                    <field name="VARIABLE" id="v_mode" variabletype="">mode</field>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </next>
                                                          </block>
                                                        </next>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
