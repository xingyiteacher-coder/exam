<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="aa_a" islocal="false" iscloud="false">a</variable>
    <variable type="" id="aa_b" islocal="false" iscloud="false">b</variable>
    <variable type="" id="aa_x" islocal="false" iscloud="false">x</variable>
    <variable type="" id="aa_y" islocal="false" iscloud="false">y</variable>
    <variable type="" id="aa_temp" islocal="false" iscloud="false">temp</variable>
    <variable type="" id="aa_res" islocal="false" iscloud="false">結果</variable>
  </variables>

  <!-- 主程式 -->
  <block type="event_whenflagclicked" id="start_flag" x="10" y="10">
    <next>
      <block type="scratch_ask" id="ask_a">
        <value name="QUESTION">
          <shadow type="text" id="shd_ask_a"><field name="TEXT">a</field></shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_a">
            <field name="VARIABLE" id="aa_a" variabletype="">a</field>
            <value name="VALUE">
              <shadow type="text" id="shd_a_0"><field name="TEXT"></field></shadow>
              <block type="scratch_answer" id="get_ans_a"></block>
            </value>
            <next>
              <block type="scratch_ask" id="ask_b">
                <value name="QUESTION">
                  <shadow type="text" id="shd_ask_b"><field name="TEXT">b</field></shadow>
                </value>
                <next>
                  <block type="data_setvariableto" id="set_b">
                    <field name="VARIABLE" id="aa_b" variabletype="">b</field>
                    <value name="VALUE">
                      <shadow type="text" id="shd_b_0"><field name="TEXT"></field></shadow>
                      <block type="scratch_answer" id="get_ans_b"></block>
                    </value>
                    <next>
                      <block type="procedures_call" id="call_gcd">
                        <mutation proccode="gcd %s %s" argumentids='["arg_a","arg_b"]' warp="false"/>
                        <value name="arg_a">
                          <shadow type="text" id="shd_arg_a"><field name="TEXT"></field></shadow>
                          <block type="data_variable" id="var_a">
                            <field name="VARIABLE" id="aa_a" variabletype="">a</field>
                          </block>
                        </value>
                        <value name="arg_b">
                          <shadow type="text" id="shd_arg_b"><field name="TEXT"></field></shadow>
                          <block type="data_variable" id="var_b">
                            <field name="VARIABLE" id="aa_b" variabletype="">b</field>
                          </block>
                        </value>
                        <next>
                          <block type="scratch_say" id="say_res">
                            <value name="TEXT">
                              <shadow type="text" id="shd_say_def"><field name="TEXT">Hello!</field></shadow>
                              <block type="data_variable" id="var_res_out">
                                <field name="VARIABLE" id="aa_res" variabletype="">結果</field>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>

  <!-- 自訂函式：gcd %s %s -->
  <block type="procedures_definition" id="def_gcd" x="450" y="10">
    <statement name="custom_block">
      <block type="procedures_prototype" id="proto_gcd">
        <mutation proccode="gcd %s %s" argumentids='["arg_a","arg_b"]' argumentnames='["a","b"]' argumentdefaults='["0","0"]' warp="false"/>
        <value name="arg_a">
          <block type="argument_reporter_string_number" id="arg_rep_a">
            <field name="VALUE">a</field>
          </block>
        </value>
        <value name="arg_b">
          <block type="argument_reporter_string_number" id="arg_rep_b">
            <field name="VALUE">b</field>
          </block>
        </value>
      </block>
    </statement>
    <next>
      <block type="data_setvariableto" id="set_x">
        <field name="VARIABLE" id="aa_x" variabletype="">x</field>
        <value name="VALUE">
          <block type="argument_reporter_string_number" id="get_arg_a">
            <field name="VALUE">a</field>
          </block>
        </value>
        <next>
          <block type="data_setvariableto" id="set_y">
            <field name="VARIABLE" id="aa_y" variabletype="">y</field>
            <value name="VALUE">
              <block type="argument_reporter_string_number" id="get_arg_b">
                <field name="VALUE">b</field>
              </block>
            </value>
            <next>
              <block type="control_repeat_until" id="loop_gcd">
                <value name="CONDITION">
                  <block type="operator_compare" id="cmp_y_0">
                    <field name="OPERATOR">==</field>
                    <value name="OPERAND1">
                      <block type="data_variable" id="var_y1">
                        <field name="VARIABLE" id="aa_y" variabletype="">y</field>
                      </block>
                    </value>
                    <value name="OPERAND2">
                      <shadow type="text" id="shd_0"><field name="TEXT">0</field></shadow>
                    </value>
                  </block>
                </value>
                <statement name="SUBSTACK">
                  <block type="data_setvariableto" id="set_temp">
                    <field name="VARIABLE" id="aa_temp" variabletype="">temp</field>
                    <value name="VALUE">
                      <block type="data_variable" id="var_y2">
                        <field name="VARIABLE" id="aa_y" variabletype="">y</field>
                      </block>
                    </value>
                    <next>
                      <block type="data_setvariableto" id="set_y_mod">
                        <field name="VARIABLE" id="aa_y" variabletype="">y</field>
                        <value name="VALUE">
                          <block type="operator_mod" id="mod_xy">
                            <value name="NUM1">
                              <shadow type="math_number" id="shd_m1"><field name="NUM">1</field></shadow>
                              <block type="data_variable" id="var_x1">
                                <field name="VARIABLE" id="aa_x" variabletype="">x</field>
                              </block>
                            </value>
                            <value name="NUM2">
                              <shadow type="math_number" id="shd_m2"><field name="NUM">1</field></shadow>
                              <block type="data_variable" id="var_y3">
                                <field name="VARIABLE" id="aa_y" variabletype="">y</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <next>
                          <block type="data_setvariableto" id="set_x_temp">
                            <field name="VARIABLE" id="aa_x" variabletype="">x</field>
                            <value name="VALUE">
                              <block type="data_variable" id="var_temp1">
                                <field name="VARIABLE" id="aa_temp" variabletype="">temp</field>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </statement>
                <next>
                  <block type="data_setvariableto" id="set_res">
                    <field name="VARIABLE" id="aa_res" variabletype="">結果</field>
                    <value name="VALUE">
                      <block type="data_variable" id="var_x2">
                        <field name="VARIABLE" id="aa_x" variabletype="">x</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
