<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="v_raw" islocal="false" iscloud="false">raw_input</variable>
    <variable type="" id="v_count" islocal="false" iscloud="false">count</variable>
    <variable type="" id="v_found" islocal="false" iscloud="false">found</variable>
    <variable type="" id="v_ptr" islocal="false" iscloud="false">ptr</variable>
    <variable type="" id="v_char" islocal="false" iscloud="false">char</variable>
  </variables>
  <block type="event_whenflagclicked" id="start" x="20" y="20">
    <next>
      <block type="scratch_ask" id="ask_input">
        <value name="QUESTION">
          <shadow type="text" id="q_input"><field name="TEXT">請輸入 0/1 字串</field></shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_raw">
            <field name="VARIABLE" id="v_raw" variabletype="">raw_input</field>
            <value name="VALUE"><block type="scratch_answer" id="ans_input"></block></value>
            <next>
              <block type="data_setvariableto" id="set_count_0">
                <field name="VARIABLE" id="v_count" variabletype="">count</field>
                <value name="VALUE"><shadow type="math_number" id="num0_1"><field name="NUM">0</field></shadow></value>
                <next>
                  <block type="data_setvariableto" id="set_found_0">
                    <field name="VARIABLE" id="v_found" variabletype="">found</field>
                    <value name="VALUE"><shadow type="math_number" id="num0_2"><field name="NUM">0</field></shadow></value>
                    <next>
                      <block type="data_setvariableto" id="set_ptr_1">
                        <field name="VARIABLE" id="v_ptr" variabletype="">ptr</field>
                        <value name="VALUE"><shadow type="math_number" id="num1_1"><field name="NUM">1</field></shadow></value>
                        <next>
                          <block type="control_repeat" id="loop_chars">
                            <value name="TIMES">
                              <block type="operator_length" id="len_raw">
                                <value name="STRING">
                                  <block type="data_variable" id="v_raw1">
                                    <field name="VARIABLE" id="v_raw" variabletype="">raw_input</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="SUBSTACK">
                              <block type="data_setvariableto" id="set_char">
                                <field name="VARIABLE" id="v_char" variabletype="">char</field>
                                <value name="VALUE">
                                  <block type="operator_letter_of" id="get_char">
                                    <value name="STRING">
                                      <block type="data_variable" id="v_raw2">
                                        <field name="VARIABLE" id="v_raw" variabletype="">raw_input</field>
                                      </block>
                                    </value>
                                    <value name="LETTER">
                                      <block type="data_variable" id="v_ptr1">
                                        <field name="VARIABLE" id="v_ptr" variabletype="">ptr</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <next>
                                  <block type="control_if_else" id="check_one">
                                    <value name="CONDITION">
                                      <block type="operator_compare" id="cmp_1">
                                        <field name="OPERATOR">==</field>
                                        <value name="OPERAND1">
                                          <block type="data_variable" id="v_char1">
                                            <field name="VARIABLE" id="v_char" variabletype="">char</field>
                                          </block>
                                        </value>
                                        <value name="OPERAND2"><shadow type="text" id="t_1"><field name="TEXT">1</field></shadow></value>
                                      </block>
                                    </value>
                                    <statement name="SUBSTACK">
                                      <block type="data_changevariableby" id="inc_count">
                                        <field name="VARIABLE" id="v_count" variabletype="">count</field>
                                        <value name="VALUE"><shadow type="math_number" id="num1_inc"><field name="NUM">1</field></shadow></value>
                                        <next>
                                          <block type="control_if" id="check_three">
                                            <value name="CONDITION">
                                              <block type="operator_compare" id="cmp_count_3">
                                                <field name="OPERATOR">==</field>
                                                <value name="OPERAND1">
                                                  <block type="data_variable" id="v_count1">
                                                    <field name="VARIABLE" id="v_count" variabletype="">count</field>
                                                  </block>
                                                </value>
                                                <value name="OPERAND2"><shadow type="math_number" id="num3_cmp"><field name="NUM">3</field></shadow></value>
                                              </block>
                                            </value>
                                            <statement name="SUBSTACK">
                                              <block type="data_setvariableto" id="set_found_1">
                                                <field name="VARIABLE" id="v_found" variabletype="">found</field>
                                                <value name="VALUE"><shadow type="math_number" id="num1_found"><field name="NUM">1</field></shadow></value>
                                              </block>
                                            </statement>
                                          </block>
                                        </next>
                                      </block>
                                    </statement>
                                    <statement name="SUBSTACK2">
                                      <block type="data_setvariableto" id="reset_count">
                                        <field name="VARIABLE" id="v_count" variabletype="">count</field>
                                        <value name="VALUE"><shadow type="math_number" id="num0_reset"><field name="NUM">0</field></shadow></value>
                                      </block>
                                    </statement>
                                    <next>
                                      <block type="data_changevariableby" id="inc_ptr">
                                        <field name="VARIABLE" id="v_ptr" variabletype="">ptr</field>
                                        <value name="VALUE"><shadow type="math_number" id="num1_ptr"><field name="NUM">1</field></shadow></value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </statement>
                            <next>
                              <block type="control_if_else" id="check_found">
                                <value name="CONDITION">
                                  <block type="operator_compare" id="cmp_found_1">
                                    <field name="OPERATOR">==</field>
                                    <value name="OPERAND1">
                                      <block type="data_variable" id="v_found1">
                                        <field name="VARIABLE" id="v_found" variabletype="">found</field>
                                      </block>
                                    </value>
                                    <value name="OPERAND2"><shadow type="math_number" id="num1_check"><field name="NUM">1</field></shadow></value>
                                  </block>
                                </value>
                                <statement name="SUBSTACK">
                                  <block type="scratch_say" id="say_yes">
                                    <value name="TEXT"><shadow type="text" id="t_yes"><field name="TEXT">yes</field></shadow></value>
                                  </block>
                                </statement>
                                <statement name="SUBSTACK2">
                                  <block type="scratch_say" id="say_no">
                                    <value name="TEXT"><shadow type="text" id="t_no"><field name="TEXT">no</field></shadow></value>
                                  </block>
                                </statement>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
