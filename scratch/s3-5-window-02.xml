<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="v_N" islocal="false" iscloud="false">N</variable>
    <variable type="" id="v_K" islocal="false" iscloud="false">K</variable>
    <variable type="" id="v_sum" islocal="false" iscloud="false">總和</variable>
    <variable type="" id="v_min" islocal="false" iscloud="false">最小總和</variable>
    <variable type="" id="v_i" islocal="false" iscloud="false">i</variable>
    <variable type="list" id="l_A" islocal="false" iscloud="false">資料</variable>
  </variables>
  <block type="event_whenflagclicked" id="start_sw_min" x="10" y="10">
    <next>
      <block type="data_deletealloflist" id="del_data">
        <field name="LIST" id="l_A" variabletype="list">資料</field>
        <next>
          <!-- 1. 讀取 N -->
          <block type="scratch_ask" id="ask_N">
            <value name="QUESTION">
              <shadow type="text" id="txt_N"><field name="TEXT">N</field></shadow>
            </value>
            <next>
              <block type="data_setvariableto" id="set_N">
                <field name="VARIABLE" id="v_N" variabletype="">N</field>
                <value name="VALUE">
                  <block type="scratch_answer" id="ans_N"></block>
                </value>
                <next>
                  <!-- 2. 逐一讀取 N 個整數存入清單 -->
                  <block type="control_repeat" id="rep_read">
                    <value name="TIMES">
                      <block type="data_variable" id="get_N">
                        <field name="VARIABLE" id="v_N" variabletype="">N</field>
                      </block>
                    </value>
                    <statement name="SUBSTACK">
                      <block type="scratch_ask" id="ask_item">
                        <value name="QUESTION">
                          <shadow type="text" id="txt_item"><field name="TEXT">x</field></shadow>
                        </value>
                        <next>
                          <block type="data_addtolist" id="add_item">
                            <field name="LIST" id="l_A" variabletype="list">資料</field>
                            <value name="ITEM">
                              <block type="scratch_answer" id="ans_item"></block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <!-- 3. 讀取 K -->
                      <block type="scratch_ask" id="ask_K">
                        <value name="QUESTION">
                          <shadow type="text" id="txt_K"><field name="TEXT">K</field></shadow>
                        </value>
                        <next>
                          <block type="data_setvariableto" id="set_K">
                            <field name="VARIABLE" id="v_K" variabletype="">K</field>
                            <value name="VALUE">
                              <block type="scratch_answer" id="ans_K"></block>
                            </value>
                            <next>
                              <!-- 4. 初始化 總和 = 0, i = 1 -->
                              <block type="data_setvariableto" id="init_sum">
                                <field name="VARIABLE" id="v_sum" variabletype="">總和</field>
                                <value name="VALUE">
                                  <shadow type="math_number" id="num_zero_s"><field name="NUM">0</field></shadow>
                                </value>
                                <next>
                                  <block type="data_setvariableto" id="init_i">
                                    <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                    <value name="VALUE">
                                      <shadow type="math_number" id="num_one_i"><field name="NUM">1</field></shadow>
                                    </value>
                                    <next>
                                      <!-- 5. 計算前 K 個數字的和 -->
                                      <block type="control_repeat" id="rep_first_k">
                                        <value name="TIMES">
                                          <block type="data_variable" id="get_K">
                                            <field name="VARIABLE" id="v_K" variabletype="">K</field>
                                          </block>
                                        </value>
                                        <statement name="SUBSTACK">
                                          <block type="data_setvariableto" id="add_sum_1">
                                            <field name="VARIABLE" id="v_sum" variabletype="">總和</field>
                                            <value name="VALUE">
                                              <block type="operator_arithmetic" id="plus_1">
                                                <field name="OPERATOR">+</field>
                                                <value name="NUM1">
                                                  <block type="data_variable" id="get_sum_1">
                                                    <field name="VARIABLE" id="v_sum" variabletype="">總和</field>
                                                  </block>
                                                </value>
                                                <value name="NUM2">
                                                  <block type="data_itemoflist" id="item_i_1">
                                                    <field name="LIST" id="l_A" variabletype="list">資料</field>
                                                    <value name="INDEX">
                                                      <block type="data_variable" id="get_i_1">
                                                        <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <next>
                                              <block type="data_changevariableby" id="inc_i_1">
                                                <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                                <value name="VALUE">
                                                  <shadow type="math_number" id="num_step_1"><field name="NUM">1</field></shadow>
                                                </value>
                                              </block>
                                            </next>
                                          </block>
                                        </statement>
                                        <next>
                                          <!-- 6. 初始化 最小總和 = 第一個視窗的和 -->
                                          <block type="data_setvariableto" id="init_min">
                                            <field name="VARIABLE" id="v_min" variabletype="">最小總和</field>
                                            <value name="VALUE">
                                              <block type="data_variable" id="get_sum_init">
                                                <field name="VARIABLE" id="v_sum" variabletype="">總和</field>
                                              </block>
                                            </value>
                                            <next>
                                              <!-- 7. 滑動視窗迴圈：重複 (N - K) 次 -->
                                              <block type="control_repeat" id="rep_window">
                                                <value name="TIMES">
                                                  <block type="operator_arithmetic" id="sub_nk">
                                                    <field name="OPERATOR">-</field>
                                                    <value name="NUM1">
                                                      <block type="data_variable" id="get_N_win">
                                                        <field name="VARIABLE" id="v_N" variabletype="">N</field>
                                                      </block>
                                                    </value>
                                                    <value name="NUM2">
                                                      <block type="data_variable" id="get_K_win">
                                                        <field name="VARIABLE" id="v_K" variabletype="">K</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                                <statement name="SUBSTACK">
                                                  <!-- 總和 = 總和 - 離開視窗的最左邊元素 + 進入視窗的最右邊元素 -->
                                                  <block type="data_setvariableto" id="update_sum">
                                                    <field name="VARIABLE" id="v_sum" variabletype="">總和</field>
                                                    <value name="VALUE">
                                                      <block type="operator_arithmetic" id="plus_new">
                                                        <field name="OPERATOR">+</field>
                                                        <value name="NUM1">
                                                          <block type="operator_arithmetic" id="minus_old">
                                                            <field name="OPERATOR">-</field>
                                                            <value name="NUM1">
                                                              <block type="data_variable" id="get_current_sum">
                                                                <field name="VARIABLE" id="v_sum" variabletype="">總和</field>
                                                              </block>
                                                            </value>
                                                            <value name="NUM2">
                                                              <block type="data_itemoflist" id="item_left_out">
                                                                <field name="LIST" id="l_A" variabletype="list">資料</field>
                                                                <value name="INDEX">
                                                                  <block type="operator_arithmetic" id="sub_i_k">
                                                                    <field name="OPERATOR">-</field>
                                                                    <value name="NUM1">
                                                                      <block type="data_variable" id="get_i_l">
                                                                        <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                                                      </block>
                                                                    </value>
                                                                    <value name="NUM2">
                                                                      <block type="data_variable" id="get_K_l">
                                                                        <field name="VARIABLE" id="v_K" variabletype="">K</field>
                                                                      </block>
                                                                    </value>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </value>
                                                        <value name="NUM2">
                                                          <block type="data_itemoflist" id="item_right_in">
                                                            <field name="LIST" id="l_A" variabletype="list">資料</field>
                                                            <value name="INDEX">
                                                              <block type="data_variable" id="get_i_r">
                                                                <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </value>
                                                    <next>
                                                      <!-- 8. 檢查並更新最小總和 (當前總和 < 最小總和) -->
                                                      <block type="control_if" id="if_update_min">
                                                        <value name="CONDITION">
                                                          <block type="operator_compare" id="cmp_min">
                                                            <field name="OPERATOR">&lt;</field>
                                                            <value name="OPERAND1">
                                                              <block type="data_variable" id="get_sum_m">
                                                                <field name="VARIABLE" id="v_sum" variabletype="">總和</field>
                                                              </block>
                                                            </value>
                                                            <value name="OPERAND2">
                                                              <block type="data_variable" id="get_min_m">
                                                                <field name="VARIABLE" id="v_min" variabletype="">最小總和</field>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </value>
                                                        <statement name="SUBSTACK">
                                                          <block type="data_setvariableto" id="set_new_min">
                                                            <field name="VARIABLE" id="v_min" variabletype="">最小總和</field>
                                                            <value name="VALUE">
                                                              <block type="data_variable" id="get_sum_new">
                                                                <field name="VARIABLE" id="v_sum" variabletype="">總和</field>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </statement>
                                                        <next>
                                                          <block type="data_changevariableby" id="inc_i_2">
                                                            <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                                            <value name="VALUE">
                                                              <shadow type="math_number" id="num_step_2"><field name="NUM">1</field></shadow>
                                                            </value>
                                                          </block>
                                                        </next>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </statement>
                                                <next>
                                                  <!-- 9. 最終輸出結果 -->
                                                  <block type="scratch_say" id="say_ans">
                                                    <value name="TEXT">
                                                      <block type="data_variable" id="out_min">
                                                        <field name="VARIABLE" id="v_min" variabletype="">最小總和</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>