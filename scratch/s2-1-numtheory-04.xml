                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <value name="OPERAND2">
                                      <block type="data_variable" id="get_n_sq">
                                        <field name="VARIABLE" id="v_n" variabletype="">n</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="SUBSTACK">
                                  <block type="data_changevariableby" id="inc_cnt1">
                                    <field name="VARIABLE" id="v_cnt" variabletype="">因數個數</field>
                                    <value name="VALUE">
