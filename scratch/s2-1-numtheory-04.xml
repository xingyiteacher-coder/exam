                                  </block>
                                </statement>
                              </block>
                            </statement>
                            <next>
                              <block type="data_changevariableby" id="inc_i">
                                <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                <value name="VALUE">
                                  <shadow type="math_number" id="num_inc_i">
                                    <field name="NUM">1</field>
                                  </shadow>
                                </value>
                              </block>
                            </next>
                          </block>
                        </statement>
                        <next>
                          <block type="scratch_say" id="say_ans">
                            <value name="TEXT">
                              <block type="data_variable" id="get_ans">
                                <field name="VARIABLE" id="v_cnt" variabletype="">因數個數</field>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
