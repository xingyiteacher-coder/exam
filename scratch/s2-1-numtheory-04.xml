                                      <block type="data_variable" id="get_n_mod">
                                        <field name="VARIABLE" id="v_n" variabletype="">n</field>
                                      </block>
                                    </value>
                                    <value name="NUM2">
                                      <block type="data_variable" id="get_i_mod">
                                        <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <value name="OPERAND2">
                                  <shadow type="text" id="txt_zero">
                                    <field name="TEXT">0</field>
                                  </shadow>
                                </value>
                              </block>
                            </value>
                            <statement name="SUBSTACK">
                              <block type="control_if_else" id="check_square">
                                <value name="CONDITION">
                                  <block type="operator_compare" id="cmp_sq_eq">
                                    <field name="OPERATOR">==</field>
                                    <value name="OPERAND1">
                                      <block type="operator_arithmetic" id="mul_i_sq">
                                        <field name="OPERATOR">*</field>
                                        <value name="NUM1">
                                          <block type="data_variable" id="get_i_sq1">
                                            <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                          </block>
                                        </value>
                                        <value name="NUM2">
