<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="v_a">a</variable>
    <variable type="" id="v_b">b</variable>
    <variable type="" id="v_ans">ans</variable>
  </variables>

  <!-- 自訂積木：gcd (a, b) -->
  <block type="procedures_definition" id="def_gcd" x="20" y="20">
    <statement name="custom_block">
      <block type="procedures_prototype" id="proto_gcd">
        <mutation proccode="gcd %n %n" argumentids="[&quot;arg_a&quot;,&quot;arg_b&quot;]" argumentnames="[&quot;a&quot;,&quot;b&quot;]" argumentdefaults="[&quot;0&quot;,&quot;0&quot;]" warp="true"></mutation>
      </block>
    </statement>
    <next>
      <block type="control_if_else" id="check_base">
        <value name="CONDITION">
          <block type="operator_compare" id="cmp_b_0">
            <field name="OPERATOR">==</field>
            <value name="OPERAND1">
              <block type="argument_reporter_string_number" id="rep_b1"><field name="VALUE">b</field></block>
            </value>
            <value name="OPERAND2">
              <shadow type="math_number" id="num_0"><field name="NUM">0</field></shadow>
            </value>
          </block>
        </value>
        <statement name="SUBSTACK">
          <block type="data_setvariableto" id="set_ans_a">
            <field name="VARIABLE" id="v_ans" variabletype="">ans</field>
            <value name="VALUE">
              <block type="argument_reporter_string_number" id="rep_a1"><field name="VALUE">a</field></block>
            </value>
          </block>
        </statement>
        <statement name="SUBSTACK2">
          <block type="procedures_call" id="call_rec">
            <mutation proccode="gcd %n %n" argumentids="[&quot;arg_a&quot;,&quot;arg_b&quot;]" warp="true"></mutation>
            <value name="arg_a">
              <block type="argument_reporter_string_number" id="rep_b2"><field name="VALUE">b</field></block>
            </value>
            <value name="arg_b">
              <block type="operator_mod" id="mod_a_b">
                <value name="NUM1">
                  <block type="argument_reporter_string_number" id="rep_a2"><field name="VALUE">a</field></block>
                </value>
                <value name="NUM2">
                  <block type="argument_reporter_string_number" id="rep_b3"><field name="VALUE">b</field></block>
                </value>
              </block>
            </value>
          </block>
        </statement>
      </block>
    </next>
  </block>

  <!-- 主程式 -->
  <block type="event_whenflagclicked" id="start" x="420" y="20">
    <next>
      <block type="scratch_ask" id="ask_a">
        <value name="QUESTION">
          <shadow type="text" id="q_a"><field name="TEXT">a</field></shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_a">
            <field name="VARIABLE" id="v_a" variabletype="">a</field>
            <value name="VALUE">
              <block type="scratch_answer" id="ans_a"></block>
            </value>
            <next>
              <block type="scratch_ask" id="ask_b">
                <value name="QUESTION">
                  <shadow type="text" id="q_b"><field name="TEXT">b</field></shadow>
                </value>
                <next>
                  <block type="data_setvariableto" id="set_b">
                    <field name="VARIABLE" id="v_b" variabletype="">b</field>
                    <value name="VALUE">
                      <block type="scratch_answer" id="ans_b"></block>
                    </value>
                    <next>
                      <block type="procedures_call" id="call_main">
                        <mutation proccode="gcd %n %n" argumentids="[&quot;arg_a&quot;,&quot;arg_b&quot;]" warp="true"></mutation>
                        <value name="arg_a">
                          <block type="data_variable" id="var_a_in"><field name="VARIABLE" id="v_a" variabletype="">a</field></block>
                        </value>
                        <value name="arg_b">
                          <block type="data_variable" id="var_b_in"><field name="VARIABLE" id="v_b" variabletype="">b</field></block>
                        </value>
                        <next>
                          <block type="scratch_say" id="say_ans">
                            <value name="TEXT">
                              <block type="data_variable" id="var_ans_out"><field name="VARIABLE" id="v_ans" variabletype="">ans</field></block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
