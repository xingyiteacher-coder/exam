<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="v_s" islocal="false" iscloud="false">字串</variable>
    <variable type="" id="v_a" islocal="false" iscloud="false">a</variable>
    <variable type="" id="v_b" islocal="false" iscloud="false">b</variable>
    <variable type="" id="v_res" islocal="false" iscloud="false">結果</variable>
    <variable type="" id="v_i" islocal="false" iscloud="false">i</variable>
  </variables>
  <block type="event_whenflagclicked" id="flag_so1" x="10" y="10">
    <next>
      <block type="scratch_ask" id="ask_so1_s">
        <value name="QUESTION">
          <shadow type="text" id="txt_so1_s"><field name="TEXT">字串</field></shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_so1_s">
            <field name="VARIABLE" id="v_s" variabletype="">字串</field>
            <value name="VALUE">
              <block type="scratch_answer" id="ans_so1_s"></block>
            </value>
            <next>
              <block type="scratch_ask" id="ask_so1_a">
                <value name="QUESTION">
                  <shadow type="text" id="txt_so1_a"><field name="TEXT">a</field></shadow>
                </value>
                <next>
                  <block type="data_setvariableto" id="set_so1_a">
                    <field name="VARIABLE" id="v_a" variabletype="">a</field>
                    <value name="VALUE">
                      <block type="scratch_answer" id="ans_so1_a"></block>
                    </value>
                    <next>
                      <block type="scratch_ask" id="ask_so1_b">
                        <value name="QUESTION">
                          <shadow type="text" id="txt_so1_b"><field name="TEXT">b</field></shadow>
                        </value>
                        <next>
                          <block type="data_setvariableto" id="set_so1_b">
                            <field name="VARIABLE" id="v_b" variabletype="">b</field>
                            <value name="VALUE">
                              <block type="scratch_answer" id="ans_so1_b"></block>
                            </value>
                            <next>
                              <block type="data_setvariableto" id="init_res_so1">
                                <field name="VARIABLE" id="v_res" variabletype="">結果</field>
                                <value name="VALUE">
                                  <shadow type="text" id="empty_so1"><field name="TEXT"></field></shadow>
                                </value>
                                <next>
                                  <block type="data_setvariableto" id="init_i_so1">
                                    <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                    <value name="VALUE">
                                      <block type="operator_arithmetic" id="plus_a1_so1">
                                        <field name="OPERATOR">+</field>
                                        <value name="NUM1">
                                          <block type="data_variable" id="get_a_so1">
                                            <field name="VARIABLE" id="v_a" variabletype="">a</field>
                                          </block>
                                        </value>
                                        <value name="NUM2">
                                          <shadow type="math_number" id="one_so1_1"><field name="NUM">1</field></shadow>
                                        </value>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="control_repeat" id="rep_so1">
                                        <value name="TIMES">
                                          <block type="operator_arithmetic" id="sub_ba_so1">
                                            <field name="OPERATOR">-</field>
                                            <value name="NUM1">
                                              <block type="data_variable" id="get_b_so1">
                                                <field name="VARIABLE" id="v_b" variabletype="">b</field>
                                              </block>
                                            </value>
                                            <value name="NUM2">
                                              <block type="data_variable" id="get_a_sub_so1">
                                                <field name="VARIABLE" id="v_a" variabletype="">a</field>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                        <statement name="SUBSTACK">
                                          <block type="data_setvariableto" id="append_so1">
                                            <field name="VARIABLE" id="v_res" variabletype="">結果</field>
                                            <value name="VALUE">
                                              <block type="operator_join" id="join_so1">
                                                <value name="OPERAND1">
                                                  <shadow type="text" id="sh_res_so1"><field name="TEXT"></field></shadow>
                                                  <block type="data_variable" id="get_res_so1">
                                                    <field name="VARIABLE" id="v_res" variabletype="">結果</field>
                                                  </block>
                                                </value>
                                                <value name="OPERAND2">
                                                  <shadow type="text" id="sh_let_so1"><field name="TEXT"></field></shadow>
                                                  <block type="operator_letter_of" id="let_so1">
                                                    <value name="STRING">
                                                      <shadow type="text" id="sh_str_so1"><field name="TEXT"></field></shadow>
                                                      <block type="data_variable" id="get_s_so1">
                                                        <field name="VARIABLE" id="v_s" variabletype="">字串</field>
                                                      </block>
                                                    </value>
                                                    <value name="LETTER">
                                                      <shadow type="math_whole_number" id="sh_i_so1"><field name="NUM">1</field></shadow>
                                                      <block type="data_variable" id="get_i_so1">
                                                        <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <next>
                                              <block type="data_changevariableby" id="inc_i_so1">
                                                <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                                <value name="VALUE">
                                                  <shadow type="math_number" id="one_so1_2"><field name="NUM">1</field></shadow>
                                                </value>
                                              </block>
                                            </next>
                                          </block>
                                        </statement>
                                        <next>
                                          <block type="scratch_say" id="say_so1">
                                            <value name="TEXT">
                                              <block type="data_variable" id="out_res_so1">
                                                <field name="VARIABLE" id="v_res" variabletype="">結果</field>
                                              </block>
                                            </value>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>