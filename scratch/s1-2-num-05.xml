<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="var_n" islocal="false" iscloud="false">n</variable>
  </variables>
  <block type="event_whenflagclicked" id="flag" x="50" y="50">
    <next>
      <!-- 1. 詢問並讀入 n -->
      <block type="scratch_ask" id="ask_n">
        <value name="QUESTION">
          <shadow type="text" id="txt_q">
            <field name="TEXT">n</field>
          </shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_n">
            <field name="VARIABLE" id="var_n" variabletype="">n</field>
            <value name="VALUE">
              <shadow type="text" id="shd_0"><field name="TEXT">0</field></shadow>
              <block type="scratch_answer" id="ans_n"></block>
            </value>
            <next>
              <!-- 2. 取 abs(n) 並輸出 -->
              <block type="scratch_say" id="say_abs">
                <value name="TEXT">
                  <shadow type="text" id="shd_say"><field name="TEXT">Hello!</field></shadow>
                  <block type="operator_mathop" id="mathop_abs">
                    <field name="OPERATOR">abs</field>
                    <value name="NUM">
                      <shadow type="math_number" id="shd_num"><field name="NUM">9</field></shadow>
                      <block type="data_variable" id="get_n">
                        <field name="VARIABLE" id="var_n" variabletype="">n</field>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>