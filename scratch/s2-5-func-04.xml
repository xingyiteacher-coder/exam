<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="aa_n" islocal="false" iscloud="false">n</variable>
    <variable type="" id="aa_i" islocal="false" iscloud="false">i</variable>
    <variable type="" id="aa_is_prime" islocal="false" iscloud="false">是質數</variable>
  </variables>

  <!-- 主程式 -->
  <block type="event_whenflagclicked" id="start_flag" x="10" y="10">
    <next>
      <block type="scratch_ask" id="ask_n">
        <value name="QUESTION">
          <shadow type="text" id="shd_ask_n"><field name="TEXT">n</field></shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_n">
            <field name="VARIABLE" id="aa_n" variabletype="">n</field>
            <value name="VALUE">
              <shadow type="text" id="shd_n_0"><field name="TEXT"></field></shadow>
              <block type="scratch_answer" id="get_ans"></block>
            </value>
            <next>
              <block type="procedures_call" id="call_prime">
                <mutation proccode="質數判斷 %s" argumentids='["arg_n"]' warp="false"/>
                <value name="arg_n">
                  <shadow type="text" id="shd_arg_n"><field name="TEXT"></field></shadow>
                  <block type="data_variable" id="var_n">
                    <field name="VARIABLE" id="aa_n" variabletype="">n</field>
                  </block>
                </value>
                <next>
                  <block type="control_if_else" id="check_res">
                    <value name="CONDITION">
                      <block type="operator_compare" id="cmp_res_1">
                        <field name="OPERATOR">==</field>
                        <value name="OPERAND1">
                          <block type="data_variable" id="var_is_prime1">
                            <field name="VARIABLE" id="aa_is_prime" variabletype="">是質數</field>
                          </block>
                        </value>
                        <value name="OPERAND2">
                          <shadow type="math_number" id="shd_1"><field name="NUM">1</field></shadow>
                        </value>
                      </block>
                    </value>
                    <statement name="SUBSTACK">
                      <block type="scratch_say" id="say_yes">
                        <value name="TEXT">
                          <shadow type="text" id="shd_yes"><field name="TEXT">yes</field></shadow>
                        </value>
                      </block>
                    </statement>
                    <statement name="SUBSTACK2">
                      <block type="scratch_say" id="say_no">
                        <value name="TEXT">
                          <shadow type="text" id="shd_no"><field name="TEXT">no</field></shadow>
                        </value>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>

  <!-- 自訂函式：質數判斷 %s -->
  <block type="procedures_definition" id="def_prime" x="450" y="10">
    <statement name="custom_block">
      <block type="procedures_prototype" id="proto_prime">
        <mutation proccode="質數判斷 %s" argumentids='["arg_n"]' argumentnames='["n"]' argumentdefaults='["0"]' warp="false"/>
        <value name="arg_n">
          <block type="argument_reporter_string_number" id="arg_rep_n">
            <field name="VALUE">n</field>
          </block>
        </value>
      </block>
    </statement>
    <next>
      <block type="control_if_else" id="check_n_lt_2">
        <value name="CONDITION">
          <block type="operator_compare" id="cmp_lt_2">
            <field name="OPERATOR">&lt;</field>
            <value name="OPERAND1">
              <block type="argument_reporter_string_number" id="arg_rep_n1">
                <field name="VALUE">n</field>
              </block>
            </value>
            <value name="OPERAND2">
              <shadow type="math_number" id="shd_2"><field name="NUM">2</field></shadow>
            </value>
          </block>
        </value>
        <statement name="SUBSTACK">
          <block type="data_setvariableto" id="set_not_prime_0">
            <field name="VARIABLE" id="aa_is_prime" variabletype="">是質數</field>
            <value name="VALUE">
              <shadow type="math_number" id="shd_num_0"><field name="NUM">0</field></shadow>
            </value>
          </block>
        </statement>
        <statement name="SUBSTACK2">
          <block type="data_setvariableto" id="set_prime_1">
            <field name="VARIABLE" id="aa_is_prime" variabletype="">是質數</field>
            <value name="VALUE">
              <shadow type="math_number" id="shd_num_1"><field name="NUM">1</field></shadow>
            </value>
            <next>
              <block type="data_setvariableto" id="set_i_2">
                <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                <value name="VALUE">
                  <shadow type="math_number" id="shd_num_i_2"><field name="NUM">2</field></shadow>
                </value>
                <next>
                  <block type="control_repeat_until" id="loop_check">
                    <value name="CONDITION">
                      <block type="operator_or" id="or_stop">
                        <value name="OPERAND1">
                          <block type="operator_compare" id="cmp_i2_gt_n">
                            <field name="OPERATOR">&gt;</field>
                            <value name="OPERAND1">
                              <block type="operator_multiply" id="mul_ii">
                                <value name="NUM1">
                                  <block type="data_variable" id="var_i1">
                                    <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                  </block>
                                </value>
                                <value name="NUM2">
                                  <block type="data_variable" id="var_i2">
                                    <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <value name="OPERAND2">
                              <block type="argument_reporter_string_number" id="arg_rep_n2">
                                <field name="VALUE">n</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <value name="OPERAND2">
                          <block type="operator_compare" id="cmp_not_prime">
                            <field name="OPERATOR">==</field>
                            <value name="OPERAND1">
                              <block type="data_variable" id="var_is_prime2">
                                <field name="VARIABLE" id="aa_is_prime" variabletype="">是質數</field>
                              </block>
                            </value>
                            <value name="OPERAND2">
                              <shadow type="math_number" id="shd_num_0_check"><field name="NUM">0</field></shadow>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="SUBSTACK">
                      <block type="control_if" id="check_mod">
                        <value name="CONDITION">
                          <block type="operator_compare" id="cmp_mod_0">
                            <field name="OPERATOR">==</field>
                            <value name="OPERAND1">
                              <block type="operator_mod" id="mod_ni">
                                <value name="NUM1">
                                  <block type="argument_reporter_string_number" id="arg_rep_n3">
                                    <field name="VALUE">n</field>
                                  </block>
                                </value>
                                <value name="NUM2">
                                  <block type="data_variable" id="var_i3">
                                    <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <value name="OPERAND2">
                              <shadow type="math_number" id="shd_mod_0"><field name="NUM">0</field></shadow>
                            </value>
                          </block>
                        </value>
                        <statement name="SUBSTACK">
                          <block type="data_setvariableto" id="set_not_prime_mod">
                            <field name="VARIABLE" id="aa_is_prime" variabletype="">是質數</field>
                            <value name="VALUE">
                              <shadow type="math_number" id="shd_num_0_mod"><field name="NUM">0</field></shadow>
                            </value>
                          </block>
                        </statement>
                        <next>
                          <block type="data_changevariableby" id="inc_i">
                            <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                            <value name="VALUE">
                              <shadow type="math_number" id="shd_inc_1"><field name="NUM">1</field></shadow>
                            </value>
                          </block>
                        </next>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>
