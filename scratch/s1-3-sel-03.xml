<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="var_a" islocal="false" iscloud="false">a</variable>
    <variable type="" id="var_b" islocal="false" iscloud="false">b</variable>
  </variables>
  <block type="event_whenflagclicked" id="flag" x="50" y="50">
    <next>
      <block type="scratch_ask" id="ask_a">
        <value name="QUESTION">
          <shadow type="text" id="txt_a">
            <field name="TEXT">a</field>
          </shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_a">
            <field name="VARIABLE" id="var_a" variabletype="">a</field>
            <value name="VALUE">
              <block type="scratch_answer" id="ans_a"></block>
            </value>
            <next>
              <block type="scratch_ask" id="ask_b">
                <value name="QUESTION">
                  <shadow type="text" id="txt_b">
                    <field name="TEXT">b</field>
                  </shadow>
                </value>
                <next>
                  <block type="data_setvariableto" id="set_b">
                    <field name="VARIABLE" id="var_b" variabletype="">b</field>
                    <value name="VALUE">
                      <block type="scratch_answer" id="ans_b"></block>
                    </value>
                    <next>
                      <block type="control_if_else" id="if_gt">
                        <value name="CONDITION">
                          <block type="operator_compare" id="cmp_ab">
                            <field name="OPERATOR">&gt;</field>
                            <value name="OPERAND1">
                              <block type="data_variable" id="get_a">
                                <field name="VARIABLE" id="var_a" variabletype="">a</field>
                              </block>
                            </value>
                            <value name="OPERAND2">
                              <block type="data_variable" id="get_b">
                                <field name="VARIABLE" id="var_b" variabletype="">b</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <statement name="SUBSTACK">
                          <block type="scratch_say" id="say_a">
                            <value name="TEXT">
                              <block type="data_variable" id="out_a">
                                <field name="VARIABLE" id="var_a" variabletype="">a</field>
                              </block>
                            </value>
                          </block>
                        </statement>
                        <statement name="SUBSTACK2">
                          <block type="scratch_say" id="say_b">
                            <value name="TEXT">
                              <block type="data_variable" id="out_b">
                                <field name="VARIABLE" id="var_b" variabletype="">b</field>
                              </block>
                            </value>
                          </block>
                        </statement>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>