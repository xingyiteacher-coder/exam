<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="v_n">n</variable>
    <variable type="" id="v_ans">ans</variable>
  </variables>

  <!-- 自訂積木：階乘 (n) -->
  <block type="procedures_definition" id="def_factorial" x="20" y="20">
    <statement name="custom_block">
      <block type="procedures_prototype" id="proto_factorial">
        <mutation proccode="階乘 %n" argumentids="[&quot;arg_n&quot;]" argumentnames="[&quot;n&quot;]" argumentdefaults="[&quot;0&quot;]" warp="true"></mutation>
      </block>
    </statement>
    <next>
      <block type="control_if_else" id="check_base">
        <value name="CONDITION">
          <block type="operator_compare" id="cmp_n_0">
            <field name="OPERATOR">==</field>
            <value name="OPERAND1">
              <block type="argument_reporter_string_number" id="rep_n1"><field name="VALUE">n</field></block>
            </value>
            <value name="OPERAND2">
              <shadow type="math_number" id="n_0"><field name="NUM">0</field></shadow>
            </value>
          </block>
        </value>
        <statement name="SUBSTACK">
          <block type="data_setvariableto" id="set_ans_1">
            <field name="VARIABLE" id="v_ans" variabletype="">ans</field>
            <value name="VALUE">
              <shadow type="math_number" id="n_1"><field name="NUM">1</field></shadow>
            </value>
          </block>
        </statement>
        <statement name="SUBSTACK2">
          <block type="procedures_call" id="call_rec">
            <mutation proccode="階乘 %n" argumentids="[&quot;arg_n&quot;]" warp="true"></mutation>
            <value name="arg_n">
              <block type="operator_arithmetic" id="sub_n_1">
                <field name="OPERATOR">-</field>
                <value name="NUM1">
                  <block type="argument_reporter_string_number" id="rep_n2"><field name="VALUE">n</field></block>
                </value>
                <value name="NUM2">
                  <shadow type="math_number" id="n_sub_1"><field name="NUM">1</field></shadow>
                </value>
              </block>
            </value>
            <next>
              <block type="data_setvariableto" id="set_ans_mult">
                <field name="VARIABLE" id="v_ans" variabletype="">ans</field>
                <value name="VALUE">
                  <block type="operator_arithmetic" id="mult_ans_n">
                    <field name="OPERATOR">*</field>
                    <value name="NUM1">
                      <block type="data_variable" id="var_ans1"><field name="VARIABLE" id="v_ans" variabletype="">ans</field></block>
                    </value>
                    <value name="NUM2">
                      <block type="argument_reporter_string_number" id="rep_n3"><field name="VALUE">n</field></block>
                    </value>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </next>
  </block>

  <!-- 主程式 -->
  <block type="event_whenflagclicked" id="start" x="400" y="20">
    <next>
      <block type="scratch_ask" id="ask_n">
        <value name="QUESTION">
          <shadow type="text" id="q_n"><field name="TEXT">n</field></shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_n">
            <field name="VARIABLE" id="v_n" variabletype="">n</field>
            <value name="VALUE">
              <block type="scratch_answer" id="ans_n"></block>
            </value>
            <next>
              <block type="procedures_call" id="call_main">
                <mutation proccode="階乘 %n" argumentids="[&quot;arg_n&quot;]" warp="true"></mutation>
                <value name="arg_n">
                  <block type="data_variable" id="var_n_in"><field name="VARIABLE" id="v_n" variabletype="">n</field></block>
                </value>
                <next>
                  <block type="scratch_say" id="say_ans">
                    <value name="TEXT">
                      <block type="data_variable" id="var_ans_out"><field name="VARIABLE" id="v_ans" variabletype="">ans</field></block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
