<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="v_n" islocal="false" iscloud="false">n</variable>
    <variable type="" id="v_steps" islocal="false" iscloud="false">步數</variable>
  </variables>
  <block type="event_whenflagclicked" id="flag_w5" x="10" y="10">
    <next>
      <block type="scratch_ask" id="ask_w5">
        <value name="QUESTION">
          <shadow type="text" id="txt_w5"><field name="TEXT">n</field></shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_n_w5">
            <field name="VARIABLE" id="v_n" variabletype="">n</field>
            <value name="VALUE">
              <block type="scratch_answer" id="ans_w5"></block>
            </value>
            <next>
              <block type="data_setvariableto" id="init_steps_w5">
                <field name="VARIABLE" id="v_steps" variabletype="">步數</field>
                <value name="VALUE">
                  <shadow type="text" id="zero_w5"><field name="TEXT">0</field></shadow>
                </value>
                <next>
                  <block type="control_repeat_until" id="rep_w5">
                    <value name="CONDITION">
                      <block type="operator_compare" id="cmp_w5">
                        <field name="OPERATOR">&lt;</field>
                        <value name="OPERAND1">
                          <shadow type="text" id="sh_op1_w5"><field name="TEXT"></field></shadow>
                          <block type="data_variable" id="get_n_w5">
                            <field name="VARIABLE" id="v_n" variabletype="">n</field>
                          </block>
                        </value>
                        <value name="OPERAND2">
                          <shadow type="text" id="two_w5"><field name="TEXT">2</field></shadow>
                        </value>
                      </block>
                    </value>
                    <statement name="SUBSTACK">
                      <block type="control_if_else" id="if_else_w5">
                        <value name="CONDITION">
                          <block type="operator_compare" id="cmp_even_w5">
                            <field name="OPERATOR">==</field>
                            <value name="OPERAND1">
                              <shadow type="text" id="sh_mod_w5"><field name="TEXT"></field></shadow>
                              <block type="operator_mod" id="mod_w5">
                                <value name="NUM1">
                                  <block type="data_variable" id="get_n_mod_w5">
                                    <field name="VARIABLE" id="v_n" variabletype="">n</field>
                                  </block>
                                </value>
                                <value name="NUM2">
                                  <shadow type="math_number" id="two_mod_w5"><field name="NUM">2</field></shadow>
                                </value>
                              </block>
                            </value>
                            <value name="OPERAND2">
                              <shadow type="text" id="zero_mod_w5"><field name="TEXT">0</field></shadow>
                            </value>
                          </block>
                        </value>
                        <statement name="SUBSTACK">
                          <block type="data_setvariableto" id="even_div_w5">
                            <field name="VARIABLE" id="v_n" variabletype="">n</field>
                            <value name="VALUE">
                              <block type="operator_arithmetic" id="div_w5">
                                <field name="OPERATOR">/</field>
                                <value name="NUM1">
                                  <block type="data_variable" id="get_n_even_w5">
                                    <field name="VARIABLE" id="v_n" variabletype="">n</field>
                                  </block>
                                </value>
                                <value name="NUM2">
                                  <shadow type="math_number" id="sh_two_even_w5"><field name="NUM">2</field></shadow>
                                </value>
                              </block>
                            </value>
                          </block>
                        </statement>
                        <statement name="SUBSTACK2">
                          <block type="data_setvariableto" id="odd_calc_w5">
                            <field name="VARIABLE" id="v_n" variabletype="">n</field>
                            <value name="VALUE">
                              <block type="operator_arithmetic" id="plus_odd_w5">
                                <field name="OPERATOR">+</field>
                                <value name="NUM1">
                                  <block type="operator_arithmetic" id="mul_odd_w5">
                                    <field name="OPERATOR">*</field>
                                    <value name="NUM1">
                                      <shadow type="math_number" id="three_w5"><field name="NUM">3</field></shadow>
                                    </value>
                                    <value name="NUM2">
                                      <block type="data_variable" id="get_n_odd_w5">
                                        <field name="VARIABLE" id="v_n" variabletype="">n</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <value name="NUM2">
                                  <shadow type="math_number" id="one_odd_w5"><field name="NUM">1</field></shadow>
                                </value>
                              </block>
                            </value>
                          </block>
                        </statement>
                        <next>
                          <block type="data_changevariableby" id="inc_steps_w5">
                            <field name="VARIABLE" id="v_steps" variabletype="">步數</field>
                            <value name="VALUE">
                              <shadow type="math_number" id="one_step_w5"><field name="NUM">1</field></shadow>
                            </value>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <block type="scratch_say" id="say_w5">
                        <value name="TEXT">
                          <block type="data_variable" id="out_steps_w5">
                            <field name="VARIABLE" id="v_steps" variabletype="">步數</field>
                          </block>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>