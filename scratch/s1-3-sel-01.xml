<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="var_n" islocal="false" iscloud="false">n</variable>
  </variables>
  <block type="event_whenflagclicked" id="flag" x="50" y="50">
    <next>
      <block type="scratch_ask" id="ask_n">
        <value name="QUESTION">
          <shadow type="text" id="text_q">
            <field name="TEXT">n</field>
          </shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_n">
            <field name="VARIABLE" id="var_n" variabletype="">n</field>
            <value name="VALUE">
              <block type="scratch_answer" id="ans_n"></block>
            </value>
            <next>
              <block type="control_if_else" id="if_even">
                <value name="CONDITION">
                  <block type="operator_compare" id="cmp_even">
                    <field name="OPERATOR">==</field>
                    <value name="OPERAND1">
                      <block type="operator_mod" id="mod2">
                        <value name="NUM1">
                          <block type="data_variable" id="get_n">
                            <field name="VARIABLE" id="var_n" variabletype="">n</field>
                          </block>
                        </value>
                        <value name="NUM2">
                          <shadow type="math_number" id="num2">
                            <field name="NUM">2</field>
                          </shadow>
                        </value>
                      </block>
                    </value>
                    <value name="OPERAND2">
                      <shadow type="math_number" id="num0">
                        <field name="NUM">0</field>
                      </shadow>
                    </value>
                  </block>
                </value>
                <statement name="SUBSTACK">
                  <block type="scratch_say" id="say_even">
                    <value name="TEXT">
                      <shadow type="text" id="txt_even">
                        <field name="TEXT">even</field>
                      </shadow>
                    </value>
                  </block>
                </statement>
                <statement name="SUBSTACK2">
                  <block type="scratch_say" id="say_odd">
                    <value name="TEXT">
                      <shadow type="text" id="txt_odd">
                        <field name="TEXT">odd</field>
                      </shadow>
                    </value>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>