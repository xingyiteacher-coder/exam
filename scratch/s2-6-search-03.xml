<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="aa_N" islocal="false" iscloud="false">N</variable>
    <variable type="" id="aa_sum" islocal="false" iscloud="false">總和</variable>
    <variable type="" id="aa_i" islocal="false" iscloud="false">i</variable>
    <variable type="list" id="aa_list" islocal="false" iscloud="false">數列</variable>
  </variables>

  <!-- 主程式 -->
  <block type="event_whenflagclicked" id="start_flag" x="10" y="10">
    <next>
      <block type="scratch_ask" id="ask_N">
        <value name="QUESTION">
          <shadow type="text" id="shd_ask_N"><field name="TEXT">N</field></shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_N">
            <field name="VARIABLE" id="aa_N" variabletype="">N</field>
            <value name="VALUE">
              <shadow type="text" id="shd_N_0"><field name="TEXT">0</field></shadow>
              <block type="scratch_answer" id="get_ans_N"></block>
            </value>
            <next>
              <block type="data_deletealloflist" id="del_all">
                <field name="LIST" id="aa_list" variabletype="list">數列</field>
                <next>
                  <block type="control_repeat" id="loop_input">
                    <value name="TIMES">
                      <block type="data_variable" id="var_N1">
                        <field name="VARIABLE" id="aa_N" variabletype="">N</field>
                      </block>
                    </value>
                    <statement name="SUBSTACK">
                      <block type="scratch_ask" id="ask_elem">
                        <value name="QUESTION">
                          <shadow type="text" id="shd_ask_elem"><field name="TEXT">元素</field></shadow>
                        </value>
                        <next>
                          <block type="data_addtolist" id="add_item">
                            <field name="LIST" id="aa_list" variabletype="list">數列</field>
                            <value name="ITEM">
                              <shadow type="text" id="shd_item_def"><field name="TEXT">thing</field></shadow>
                              <block type="scratch_answer" id="get_ans_elem"></block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <block type="data_setvariableto" id="set_sum_0">
                        <field name="VARIABLE" id="aa_sum" variabletype="">總和</field>
                        <value name="VALUE">
                          <shadow type="text" id="shd_s0"><field name="TEXT">0</field></shadow>
                        </value>
                        <next>
                          <block type="data_setvariableto" id="set_i_1">
                            <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                            <value name="VALUE">
                              <shadow type="text" id="shd_i1"><field name="TEXT">1</field></shadow>
                            </value>
                            <next>
                              <block type="control_repeat" id="loop_sum">
                                <value name="TIMES">
                                  <block type="data_variable" id="var_N2">
                                    <field name="VARIABLE" id="aa_N" variabletype="">N</field>
                                  </block>
                                </value>
                                <statement name="SUBSTACK">
                                  <block type="control_if" id="check_even">
                                    <value name="CONDITION">
                                      <block type="operator_compare" id="cmp_mod_0">
                                        <field name="OPERATOR">==</field>
                                        <value name="OPERAND1">
                                          <block type="operator_mod" id="mod_2">
                                            <value name="NUM1">
                                              <block type="data_itemoflist" id="get_item_i1">
                                                <field name="LIST" id="aa_list" variabletype="list">數列</field>
                                                <value name="INDEX">
                                                  <shadow type="math_number" id="shd_idx1"><field name="NUM">1</field></shadow>
                                                  <block type="data_variable" id="var_i1">
                                                    <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <value name="NUM2">
                                              <shadow type="math_number" id="shd_two"><field name="NUM">2</field></shadow>
                                            </value>
                                          </block>
                                        </value>
                                        <value name="OPERAND2">
                                          <shadow type="text" id="shd_zero"><field name="TEXT">0</field></shadow>
                                        </value>
                                      </block>
                                    </value>
                                    <statement name="SUBSTACK">
                                      <block type="data_changevariableby" id="add_to_sum">
                                        <field name="VARIABLE" id="aa_sum" variabletype="">總和</field>
                                        <value name="VALUE">
                                          <block type="data_itemoflist" id="get_item_i2">
                                            <field name="LIST" id="aa_list" variabletype="list">數列</field>
                                            <value name="INDEX">
                                              <shadow type="math_number" id="shd_idx2"><field name="NUM">1</field></shadow>
                                              <block type="data_variable" id="var_i2">
                                                <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                      </block>
                                    </statement>
                                    <next>
                                      <block type="data_changevariableby" id="inc_i">
                                        <field name="VARIABLE" id="aa_i" variabletype="">i</field>
                                        <value name="VALUE">
                                          <shadow type="math_number" id="shd_inc1"><field name="NUM">1</field></shadow>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </statement>
                                <next>
                                  <block type="scratch_say" id="say_sum">
                                    <value name="TEXT">
                                      <shadow type="text" id="shd_say_def"><field name="TEXT">Hello!</field></shadow>
                                      <block type="data_variable" id="var_sum_out">
                                        <field name="VARIABLE" id="aa_sum" variabletype="">總和</field>
                                      </block>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
