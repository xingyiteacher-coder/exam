<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="v_N" islocal="false" iscloud="false">N</variable>
    <variable type="" id="v_pos" islocal="false" iscloud="false">pos</variable>
    <variable type="" id="v_val" islocal="false" iscloud="false">val</variable>
    <variable type="" id="v_i" islocal="false" iscloud="false">i</variable>
    <variable type="" id="v_res" islocal="false" iscloud="false">結果</variable>
    <variable type="list" id="l_data" islocal="false" iscloud="false">資料</variable>
  </variables>
  <block type="event_whenflagclicked" id="flag1" x="10" y="10">
    <next>
      <block type="data_deletealloflist" id="del1">
        <field name="LIST" id="l_data" variabletype="list">資料</field>
        <next>
          <!-- 1. 讀取 N -->
          <block type="scratch_ask" id="ask_N">
            <value name="QUESTION">
              <shadow type="text" id="txt_N"><field name="TEXT">N</field></shadow>
            </value>
            <next>
              <block type="data_setvariableto" id="set_N">
                <field name="VARIABLE" id="v_N" variabletype="">N</field>
                <value name="VALUE">
                  <block type="scratch_answer" id="ans_N"></block>
                </value>
                <next>
                  <!-- 2. 讀取 N 個整數存入清單 -->
                  <block type="control_repeat" id="rep_read">
                    <value name="TIMES">
                      <block type="data_variable" id="get_N">
                        <field name="VARIABLE" id="v_N" variabletype="">N</field>
                      </block>
                    </value>
                    <statement name="SUBSTACK">
                      <block type="scratch_ask" id="ask_elem">
                        <value name="QUESTION">
                          <shadow type="text" id="txt_elem"><field name="TEXT">x</field></shadow>
                        </value>
                        <next>
                          <block type="data_addtolist" id="add_elem">
                            <field name="LIST" id="l_data" variabletype="list">資料</field>
                            <value name="ITEM">
                              <block type="scratch_answer" id="ans_elem"></block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <!-- 3. 讀取 pos 與 val -->
                      <block type="scratch_ask" id="ask_pos">
                        <value name="QUESTION">
                          <shadow type="text" id="txt_pos"><field name="TEXT">pos</field></shadow>
                        </value>
                        <next>
                          <block type="data_setvariableto" id="set_pos">
                            <field name="VARIABLE" id="v_pos" variabletype="">pos</field>
                            <value name="VALUE">
                              <block type="scratch_answer" id="ans_pos"></block>
                            </value>
                            <next>
                              <block type="scratch_ask" id="ask_val">
                                <value name="QUESTION">
                                  <shadow type="text" id="txt_val"><field name="TEXT">val</field></shadow>
                                </value>
                                <next>
                                  <block type="data_setvariableto" id="set_val">
                                    <field name="VARIABLE" id="v_val" variabletype="">val</field>
                                    <value name="VALUE">
                                      <block type="scratch_answer" id="ans_val"></block>
                                    </value>
                                    <next>
                                      <!-- 4. 將 val 插入至 pos + 1 位置 -->
                                      <block type="data_insertatlist" id="insert_elem">
                                        <field name="LIST" id="l_data" variabletype="list">資料</field>
                                        <value name="ITEM">
                                          <block type="data_variable" id="get_val">
                                            <field name="VARIABLE" id="v_val" variabletype="">val</field>
                                          </block>
                                        </value>
                                        <value name="INDEX">
                                          <block type="operator_arithmetic" id="add_pos">
                                            <field name="OPERATOR">+</field>
                                            <value name="NUM1">
                                              <block type="data_variable" id="get_pos">
                                                <field name="VARIABLE" id="v_pos" variabletype="">pos</field>
                                              </block>
                                            </value>
                                            <value name="NUM2">
                                              <shadow type="math_number" id="num_one_pos"><field name="NUM">1</field></shadow>
                                            </value>
                                          </block>
                                        </value>
                                        <next>
                                          <!-- 5. 組合清單內容為空白分隔字串並輸出 -->
                                          <block type="data_setvariableto" id="init_res">
                                            <field name="VARIABLE" id="v_res" variabletype="">結果</field>
                                            <value name="VALUE">
                                              <block type="data_itemoflist" id="item_first">
                                                <field name="LIST" id="l_data" variabletype="list">資料</field>
                                                <value name="INDEX">
                                                  <shadow type="math_number" id="num_one_res"><field name="NUM">1</field></shadow>
                                                </value>
                                              </block>
                                            </value>
                                            <next>
                                              <block type="data_setvariableto" id="init_i">
                                                <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                                <value name="VALUE">
                                                  <shadow type="math_number" id="num_two_i"><field name="NUM">2</field></shadow>
                                                </value>
                                                <next>
                                                  <block type="control_repeat" id="rep_out_str">
                                                    <value name="TIMES">
                                                      <block type="operator_arithmetic" id="sub_out_str_times">
                                                        <field name="OPERATOR">-</field>
                                                        <value name="NUM1">
                                                          <block type="data_lengthoflist" id="len_data">
                                                            <field name="LIST" id="l_data" variabletype="list">資料</field>
                                                          </block>
                                                        </value>
                                                        <value name="NUM2">
                                                          <shadow type="math_number" id="num_one_str"><field name="NUM">1</field></shadow>
                                                        </value>
                                                      </block>
                                                    </value>
                                                    <statement name="SUBSTACK">
                                                      <block type="data_setvariableto" id="append_res">
                                                        <field name="VARIABLE" id="v_res" variabletype="">結果</field>
                                                        <value name="VALUE">
                                                          <block type="operator_join" id="join_outer">
                                                            <value name="OPERAND1">
                                                              <block type="data_variable" id="get_res_str">
                                                                <field name="VARIABLE" id="v_res" variabletype="">結果</field>
                                                              </block>
                                                            </value>
                                                            <value name="OPERAND2">
                                                              <block type="operator_join" id="join_inner">
                                                                <value name="OPERAND1">
                                                                  <shadow type="text" id="sp_txt"><field name="TEXT"> </field></shadow>
                                                                </value>
                                                                <value name="OPERAND2">
                                                                  <block type="data_itemoflist" id="item_i_str">
                                                                    <field name="LIST" id="l_data" variabletype="list">資料</field>
                                                                    <value name="INDEX">
                                                                      <block type="data_variable" id="get_i_str">
                                                                        <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                                                      </block>
                                                                    </value>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </value>
                                                        <next>
                                                          <block type="data_changevariableby" id="inc_i">
                                                            <field name="VARIABLE" id="v_i" variabletype="">i</field>
                                                            <value name="VALUE">
                                                              <shadow type="math_number" id="num_step_i"><field name="NUM">1</field></shadow>
                                                            </value>
                                                          </block>
                                                        </next>
                                                      </block>
                                                    </statement>
                                                    <next>
                                                      <block type="scratch_say" id="say_out">
                                                        <value name="TEXT">
                                                          <block type="data_variable" id="get_res_out">
                                                            <field name="VARIABLE" id="v_res" variabletype="">結果</field>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>