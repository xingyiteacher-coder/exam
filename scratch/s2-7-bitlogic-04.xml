<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="aa_n" islocal="false" iscloud="false">n</variable>
  </variables>

  <!-- 主程式 -->
  <block type="event_whenflagclicked" id="start_flag" x="10" y="10">
    <next>
      <block type="scratch_ask" id="ask_n">
        <value name="QUESTION">
          <shadow type="text" id="shd_ask_n"><field name="TEXT">n</field></shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_n">
            <field name="VARIABLE" id="aa_n" variabletype="">n</field>
            <value name="VALUE">
              <shadow type="text" id="shd_n_0"><field name="TEXT">0</field></shadow>
              <block type="scratch_answer" id="get_ans_n"></block>
            </value>
            <next>
              <block type="control_repeat_until" id="loop_until_odd">
                <value name="CONDITION">
                  <block type="operator_compare" id="cmp_mod_1">
                    <field name="OPERATOR">==</field>
                    <value name="OPERAND1">
                      <block type="operator_mod" id="mod_n">
                        <value name="NUM1">
                          <block type="data_variable" id="var_n1">
                            <field name="VARIABLE" id="aa_n" variabletype="">n</field>
                          </block>
                        </value>
                        <value name="NUM2">
                          <shadow type="math_number" id="shd_two"><field name="NUM">2</field></shadow>
                        </value>
                      </block>
                    </value>
                    <value name="OPERAND2">
                      <shadow type="text" id="shd_one"><field name="TEXT">1</field></shadow>
                    </value>
                  </block>
                </value>
                <statement name="SUBSTACK">
                  <block type="data_setvariableto" id="set_n_half">
                    <field name="VARIABLE" id="aa_n" variabletype="">n</field>
                    <value name="VALUE">
                      <block type="operator_mathop" id="floor_n">
                        <field name="OPERATOR">floor</field>
                        <value name="NUM">
                          <block type="operator_arithmetic" id="div_n">
                            <field name="OPERATOR">/</field>
                            <value name="NUM1">
                              <block type="data_variable" id="var_n2">
                                <field name="VARIABLE" id="aa_n" variabletype="">n</field>
                              </block>
                            </value>
                            <value name="NUM2">
                              <shadow type="math_number" id="shd_two2"><field name="NUM">2</field></shadow>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </statement>
                <next>
                  <block type="control_if_else" id="check_power">
                    <value name="CONDITION">
                      <block type="operator_compare" id="cmp_n_1">
                        <field name="OPERATOR">==</field>
                        <value name="OPERAND1">
                          <block type="data_variable" id="var_n3">
                            <field name="VARIABLE" id="aa_n" variabletype="">n</field>
                          </block>
                        </value>
                        <value name="OPERAND2">
                          <shadow type="text" id="shd_1"><field name="TEXT">1</field></shadow>
                        </value>
                      </block>
                    </value>
                    <statement name="SUBSTACK">
                      <block type="scratch_say" id="say_yes">
                        <value name="TEXT">
                          <shadow type="text" id="shd_yes"><field name="TEXT">yes</field></shadow>
                        </value>
                      </block>
                    </statement>
                    <statement name="SUBSTACK2">
                      <block type="scratch_say" id="say_no">
                        <value name="TEXT">
                          <shadow type="text" id="shd_no"><field name="TEXT">no</field></shadow>
                        </value>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
