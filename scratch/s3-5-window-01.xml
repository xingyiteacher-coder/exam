
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="v_n">N</variable>
    <variable id="v_lst">list</variable>
    <variable id="v_k">K</variable>
    <variable id="v_sum">sum</variable>
    <variable id="v_max">max_sum</variable>
    <variable id="v_i">i</variable>
  </variables>
  <block type="variables_set" id="init_n" x="20" y="20">
    <field name="VAR" id="v_n">N</field>
    <value name="VALUE"><block type="text_prompt_ext"><mutation type="NUMBER"/><field name="TYPE">NUMBER</field></block></value>
    <next>
      <block type="variables_set" id="init_lst">
        <field name="VAR" id="v_lst">list</field>
        <value name="VALUE"><block type="lists_create_empty"/></value>
        <next>
          <block type="variables_set" id="init_i">
            <field name="VAR" id="v_i">i</field>
            <value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value>
            <next>
              <block type="controls_whileUntil" id="loop_in">
                <field name="MODE">WHILE</field>
                <value name="BOOL">
                  <block type="logic_compare">
                    <field name="OP">LTE</field>
                    <value name="A"><block type="variables_get"><field name="VAR" id="v_i">i</field></block></value>
                    <value name="B"><block type="variables_get"><field name="VAR" id="v_n">N</field></block></value>
                  </block>
                </value>
                <statement name="DO">
                  <block type="lists_setIndex">
                    <mutation at="false" statement="true"/>
                    <field name="MODE">INSERT</field>
                    <field name="WHERE">LAST</field>
                    <value name="LIST"><block type="variables_get"><field name="VAR" id="v_lst">list</field></block></value>
                    <value name="TO"><block type="text_prompt_ext"><mutation type="NUMBER"/><field name="TYPE">NUMBER</field></block></value>
                    <next>
                      <block type="math_change">
                        <field name="VAR" id="v_i">i</field>
                        <value name="DELTA"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
                      </block>
                    </next>
                  </block>
                </statement>
                <next>
                  <block type="variables_set" id="init_k">
                    <field name="VAR" id="v_k">K</field>
                    <value name="VALUE"><block type="text_prompt_ext"><mutation type="NUMBER"/><field name="TYPE">NUMBER</field></block></value>
                    <next>
                      <block type="variables_set" id="init_sum">
                        <field name="VAR" id="v_sum">sum</field>
                        <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
                        <next>
                          <block type="variables_set" id="init_i2">
                            <field name="VAR" id="v_i">i</field>
                            <value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value>
                            <next>
                              <block type="controls_whileUntil" id="loop_first_k">
                                <field name="MODE">WHILE</field>
                                <value name="BOOL">
                                  <block type="logic_compare">
                                    <field name="OP">LTE</field>
                                    <value name="A"><block type="variables_get"><field name="VAR" id="v_i">i</field></block></value>
                                    <value name="B"><block type="variables_get"><field name="VAR" id="v_k">K</field></block></value>
                                  </block>
                                </value>
                                <statement name="DO">
                                  <block type="math_change">
                                    <field name="VAR" id="v_sum">sum</field>
                                    <value name="DELTA">
                                      <block type="lists_getIndex">
                                        <mutation statement="false" at="true"/>
                                        <field name="MODE">GET</field>
                                        <field name="WHERE">FROM_START</field>
                                        <value name="VALUE"><block type="variables_get"><field name="VAR" id="v_lst">list</field></block></value>
                                        <value name="AT"><block type="variables_get"><field name="VAR" id="v_i">i</field></block></value>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="math_change">
                                        <field name="VAR" id="v_i">i</field>
                                        <value name="DELTA"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
                                      </block>
                                    </next>
                                  </block>
                                </statement>
                                <next>
                                  <block type="variables_set" id="init_max">
                                    <field name="VAR" id="v_max">max_sum</field>
                                    <value name="VALUE"><block type="variables_get"><field name="VAR" id="v_sum">sum</field></block></value>
                                    <next>
                                      <block type="variables_set" id="set_i_slide">
                                        <field name="VAR" id="v_i">i</field>
                                        <value name="VALUE">
                                          <block type="math_arithmetic">
                                            <field name="OP">ADD</field>
                                            <value name="A"><block type="variables_get"><field name="VAR" id="v_k">K</field></block></value>
                                            <value name="B"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="controls_whileUntil" id="loop_slide">
                                            <field name="MODE">WHILE</field>
                                            <value name="BOOL">
                                              <block type="logic_compare">
                                                <field name="OP">LTE</field>
                                                <value name="A"><block type="variables_get"><field name="VAR" id="v_i">i</field></block></value>
                                                <value name="B"><block type="variables_get"><field name="VAR" id="v_n">N</field></block></value>
                                              </block>
                                            </value>
                                            <statement name="DO">
                                              <block type="variables_set">
                                                <field name="VAR" id="v_sum">sum</field>
                                                <value name="VALUE">
                                                  <block type="math_arithmetic">
                                                    <field name="OP">MINUS</field>
                                                    <value name="A">
                                                      <block type="math_arithmetic">
                                                        <field name="OP">ADD</field>
                                                        <value name="A"><block type="variables_get"><field name="VAR" id="v_sum">sum</field></block></value>
                                                        <value name="B">
                                                          <block type="lists_getIndex">
                                                            <mutation statement="false" at="true"/>
                                                            <field name="MODE">GET</field>
                                                            <field name="WHERE">FROM_START</field>
                                                            <value name="VALUE"><block type="variables_get"><field name="VAR" id="v_lst">list</field></block></value>
                                                            <value name="AT"><block type="variables_get"><field name="VAR" id="v_i">i</field></block></value>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </value>
                                                    <value name="B">
                                                      <block type="lists_getIndex">
                                                        <mutation statement="false" at="true"/>
                                                        <field name="MODE">GET</field>
                                                        <field name="WHERE">FROM_START</field>
                                                        <value name="VALUE"><block type="variables_get"><field name="VAR" id="v_lst">list</field></block></value>
                                                        <value name="AT">
                                                          <block type="math_arithmetic">
                                                            <field name="OP">MINUS</field>
                                                            <value name="A"><block type="variables_get"><field name="VAR" id="v_i">i</field></block></value>
                                                            <value name="B"><block type="variables_get"><field name="VAR" id="v_k">K</field></block></value>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                                <next>
                                                  <block type="controls_if">
                                                    <value name="IF0">
                                                      <block type="logic_compare">
                                                        <field name="OP">GT</field>
                                                        <value name="A"><block type="variables_get"><field name="VAR" id="v_sum">sum</field></block></value>
                                                        <value name="B"><block type="variables_get"><field name="VAR" id="v_max">max_sum</field></block></value>
                                                      </block>
                                                    </value>
                                                    <statement name="DO0">
                                                      <block type="variables_set">
                                                        <field name="VAR" id="v_max">max_sum</field>
                                                        <value name="VALUE"><block type="variables_get"><field name="VAR" id="v_sum">sum</field></block></value>
                                                      </block>
                                                    </statement>
                                                    <next>
                                                      <block type="math_change">
                                                        <field name="VAR" id="v_i">i</field>
                                                        <value name="DELTA"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </next>
                                              </block>
                                            </statement>
                                            <next>
                                              <block type="text_print">
                                                <value name="TEXT"><block type="variables_get"><field name="VAR" id="v_max">max_sum</field></block></value>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
