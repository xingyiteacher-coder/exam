<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="aa_a" islocal="false" iscloud="false">a</variable>
    <variable type="" id="aa_b" islocal="false" iscloud="false">b</variable>
    <variable type="" id="aa_res" islocal="false" iscloud="false">結果</variable>
    <variable type="" id="aa_w" islocal="false" iscloud="false">權重</variable>
  </variables>

  <!-- 主程式 -->
  <block type="event_whenflagclicked" id="start_flag" x="10" y="10">
    <next>
      <block type="scratch_ask" id="ask_a">
        <value name="QUESTION">
          <shadow type="text" id="shd_ask_a"><field name="TEXT">a</field></shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_a">
            <field name="VARIABLE" id="aa_a" variabletype="">a</field>
            <value name="VALUE">
              <shadow type="text" id="shd_a_0"><field name="TEXT">0</field></shadow>
              <block type="scratch_answer" id="get_ans_a"></block>
            </value>
            <next>
              <block type="scratch_ask" id="ask_b">
                <value name="QUESTION">
                  <shadow type="text" id="shd_ask_b"><field name="TEXT">b</field></shadow>
                </value>
                <next>
                  <block type="data_setvariableto" id="set_b">
                    <field name="VARIABLE" id="aa_b" variabletype="">b</field>
                    <value name="VALUE">
                      <shadow type="text" id="shd_b_0"><field name="TEXT">0</field></shadow>
                      <block type="scratch_answer" id="get_ans_b"></block>
                    </value>
                    <next>
                      <block type="data_setvariableto" id="set_res_0">
                        <field name="VARIABLE" id="aa_res" variabletype="">結果</field>
                        <value name="VALUE">
                          <shadow type="text" id="shd_res_0"><field name="TEXT">0</field></shadow>
                        </value>
                        <next>
                          <block type="data_setvariableto" id="set_w_1">
                            <field name="VARIABLE" id="aa_w" variabletype="">權重</field>
                            <value name="VALUE">
                              <shadow type="text" id="shd_w_1"><field name="TEXT">1</field></shadow>
                            </value>
                            <next>
                              <block type="control_repeat_until" id="loop_until">
                                <value name="CONDITION">
                                  <block type="operator_and" id="and_cond">
                                    <value name="OPERAND1">
                                      <block type="operator_compare" id="cmp_a_0">
                                        <field name="OPERATOR">==</field>
                                        <value name="OPERAND1">
                                          <block type="data_variable" id="var_a1">
                                            <field name="VARIABLE" id="aa_a" variabletype="">a</field>
                                          </block>
                                        </value>
                                        <value name="OPERAND2">
                                          <shadow type="text" id="shd_zero1"><field name="TEXT">0</field></shadow>
                                        </value>
                                      </block>
                                    </value>
                                    <value name="OPERAND2">
                                      <block type="operator_compare" id="cmp_b_0">
                                        <field name="OPERATOR">==</field>
                                        <value name="OPERAND1">
                                          <block type="data_variable" id="var_b1">
                                            <field name="VARIABLE" id="aa_b" variabletype="">b</field>
                                          </block>
                                        </value>
                                        <value name="OPERAND2">
                                          <shadow type="text" id="shd_zero2"><field name="TEXT">0</field></shadow>
                                        </value>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="SUBSTACK">
                                  <block type="control_if" id="check_xor_bit">
                                    <value name="CONDITION">
                                      <block type="operator_not" id="not_eq">
                                        <value name="OPERAND">
                                          <block type="operator_compare" id="cmp_bits">
                                            <field name="OPERATOR">==</field>
                                            <value name="OPERAND1">
                                              <block type="operator_mod" id="mod_a">
                                                <value name="NUM1">
                                                  <block type="data_variable" id="var_a2">
                                                    <field name="VARIABLE" id="aa_a" variabletype="">a</field>
                                                  </block>
                                                </value>
                                                <value name="NUM2">
                                                  <shadow type="math_number" id="shd_two1"><field name="NUM">2</field></shadow>
                                                </value>
                                              </block>
                                            </value>
                                            <value name="OPERAND2">
                                              <block type="operator_mod" id="mod_b">
                                                <value name="NUM1">
                                                  <block type="data_variable" id="var_b2">
                                                    <field name="VARIABLE" id="aa_b" variabletype="">b</field>
                                                  </block>
                                                </value>
                                                <value name="NUM2">
                                                  <shadow type="math_number" id="shd_two2"><field name="NUM">2</field></shadow>
                                                </value>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <statement name="SUBSTACK">
                                      <block type="data_changevariableby" id="inc_res">
                                        <field name="VARIABLE" id="aa_res" variabletype="">結果</field>
                                        <value name="VALUE">
                                          <block type="data_variable" id="var_w1">
                                            <field name="VARIABLE" id="aa_w" variabletype="">權重</field>
                                          </block>
                                        </value>
                                      </block>
                                    </statement>
                                    <next>
                                      <block type="data_setvariableto" id="set_a_half">
                                        <field name="VARIABLE" id="aa_a" variabletype="">a</field>
                                        <value name="VALUE">
                                          <block type="operator_mathop" id="floor_a">
                                            <field name="OPERATOR">floor</field>
                                            <value name="NUM">
                                              <block type="operator_arithmetic" id="div_a">
                                                <field name="OPERATOR">/</field>
                                                <value name="NUM1">
                                                  <block type="data_variable" id="var_a3">
                                                    <field name="VARIABLE" id="aa_a" variabletype="">a</field>
                                                  </block>
                                                </value>
                                                <value name="NUM2">
                                                  <shadow type="math_number" id="shd_two3"><field name="NUM">2</field></shadow>
                                                </value>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="data_setvariableto" id="set_b_half">
                                            <field name="VARIABLE" id="aa_b" variabletype="">b</field>
                                            <value name="VALUE">
                                              <block type="operator_mathop" id="floor_b">
                                                <field name="OPERATOR">floor</field>
                                                <value name="NUM">
                                                  <block type="operator_arithmetic" id="div_b">
                                                    <field name="OPERATOR">/</field>
                                                    <value name="NUM1">
                                                      <block type="data_variable" id="var_b3">
                                                        <field name="VARIABLE" id="aa_b" variabletype="">b</field>
                                                      </block>
                                                    </value>
                                                    <value name="NUM2">
                                                      <shadow type="math_number" id="shd_two4"><field name="NUM">2</field></shadow>
                                                    </value>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <next>
                                              <block type="data_setvariableto" id="set_w_double">
                                                <field name="VARIABLE" id="aa_w" variabletype="">權重</field>
                                                <value name="VALUE">
                                                  <block type="operator_arithmetic" id="mult_w">
                                                    <field name="OPERATOR">*</field>
                                                    <value name="NUM1">
                                                      <block type="data_variable" id="var_w2">
                                                        <field name="VARIABLE" id="aa_w" variabletype="">權重</field>
                                                      </block>
                                                    </value>
                                                    <value name="NUM2">
                                                      <shadow type="math_number" id="shd_two5"><field name="NUM">2</field></shadow>
                                                    </value>
                                                  </block>
                                                </value>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </statement>
                                <next>
                                  <block type="scratch_say" id="say_res">
                                    <value name="TEXT">
                                      <shadow type="text" id="shd_say_def"><field name="TEXT">Hello!</field></shadow>
                                      <block type="data_variable" id="var_res_out">
                                        <field name="VARIABLE" id="aa_res" variabletype="">結果</field>
                                      </block>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
