<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="v_t" islocal="false" iscloud="false">門檻</variable>
    <variable type="" id="v_step" islocal="false" iscloud="false">增加量</variable>
    <variable type="" id="v_sum" islocal="false" iscloud="false">總和</variable>
    <variable type="" id="v_cnt" islocal="false" iscloud="false">次數</variable>
  </variables>
  <block type="event_whenflagclicked" id="flag_w1" x="10" y="10">
    <next>
      <block type="scratch_ask" id="ask_w1_t">
        <value name="QUESTION">
          <shadow type="text" id="txt_w1_t"><field name="TEXT">門檻</field></shadow>
        </value>
        <next>
          <block type="data_setvariableto" id="set_w1_t">
            <field name="VARIABLE" id="v_t" variabletype="">門檻</field>
            <value name="VALUE">
              <block type="scratch_answer" id="ans_w1_t"></block>
            </value>
            <next>
              <block type="scratch_ask" id="ask_w1_step">
                <value name="QUESTION">
                  <shadow type="text" id="txt_w1_step"><field name="TEXT">增加量</field></shadow>
                </value>
                <next>
                  <block type="data_setvariableto" id="set_w1_step">
                    <field name="VARIABLE" id="v_step" variabletype="">增加量</field>
                    <value name="VALUE">
                      <block type="scratch_answer" id="ans_w1_step"></block>
                    </value>
                    <next>
                      <block type="data_setvariableto" id="init_sum_w1">
                        <field name="VARIABLE" id="v_sum" variabletype="">總和</field>
                        <value name="VALUE">
                          <shadow type="text" id="zero_w1_1"><field name="TEXT">0</field></shadow>
                        </value>
                        <next>
                          <block type="data_setvariableto" id="init_cnt_w1">
                            <field name="VARIABLE" id="v_cnt" variabletype="">次數</field>
                            <value name="VALUE">
                              <shadow type="text" id="zero_w1_2"><field name="TEXT">0</field></shadow>
                            </value>
                            <next>
                              <block type="control_repeat_until" id="rep_w1">
                                <value name="CONDITION">
                                  <block type="operator_compare" id="cmp_w1">
                                    <field name="OPERATOR">&gt;</field>
                                    <value name="OPERAND1">
                                      <shadow type="text" id="sh_op1_w1"><field name="TEXT"></field></shadow>
                                      <block type="data_variable" id="get_sum_w1">
                                        <field name="VARIABLE" id="v_sum" variabletype="">總和</field>
                                      </block>
                                    </value>
                                    <value name="OPERAND2">
                                      <shadow type="text" id="sh_op2_w1"><field name="TEXT"></field></shadow>
                                      <block type="data_variable" id="get_t_w1">
                                        <field name="VARIABLE" id="v_t" variabletype="">門檻</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="SUBSTACK">
                                  <block type="data_setvariableto" id="add_sum_w1">
                                    <field name="VARIABLE" id="v_sum" variabletype="">總和</field>
                                    <value name="VALUE">
                                      <block type="operator_arithmetic" id="plus_w1">
                                        <field name="OPERATOR">+</field>
                                        <value name="NUM1">
                                          <block type="data_variable" id="get_sum_add_w1">
                                            <field name="VARIABLE" id="v_sum" variabletype="">總和</field>
                                          </block>
                                        </value>
                                        <value name="NUM2">
                                          <block type="data_variable" id="get_step_w1">
                                            <field name="VARIABLE" id="v_step" variabletype="">增加量</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="data_changevariableby" id="inc_cnt_w1">
                                        <field name="VARIABLE" id="v_cnt" variabletype="">次數</field>
                                        <value name="VALUE">
                                          <shadow type="math_number" id="one_w1"><field name="NUM">1</field></shadow>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </statement>
                                <next>
                                  <block type="scratch_say" id="say_w1">
                                    <value name="TEXT">
                                      <block type="data_variable" id="out_cnt_w1">
                                        <field name="VARIABLE" id="v_cnt" variabletype="">次數</field>
                                      </block>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>