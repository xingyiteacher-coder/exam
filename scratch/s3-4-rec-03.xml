<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="v_result" islocal="false" iscloud="false">傳回值</variable>
  </variables>

  <!-- 當綠旗被點擊 -->
  <block type="event_whenflagclicked" id="start" x="20" y="20">
    <next>
      <block type="sensing_askandwait" id="ask_n">
        <value name="QUESTION">
          <shadow type="text" id="txt_ask"><field name="TEXT"></field></shadow>
        </value>
        <next>
          <!-- 傳回值 = (答案 * (答案 + 1)) / 2 -->
          <block type="data_setvariableto" id="calc_formula">
            <field name="VARIABLE" id="v_result" variabletype="">傳回值</field>
            <value name="VALUE">
              <block type="operator_divide" id="div_2">
                <value name="NUM1">
                  <block type="operator_multiply" id="mult_n">
                    <value name="NUM1">
                      <block type="sensing_answer" id="get_ans1"></block>
                    </value>
                    <value name="NUM2">
                      <block type="operator_add" id="add_n_1">
                        <value name="NUM1">
                          <block type="sensing_answer" id="get_ans2"></block>
                        </value>
                        <value name="NUM2">
                          <shadow type="math_number" id="num_1"><field name="NUM">1</field></shadow>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
                <value name="NUM2">
                  <shadow type="math_number" id="num_2"><field name="NUM">2</field></shadow>
                </value>
              </block>
            </value>
            <next>
              <block type="looks_say" id="say_res">
                <value name="MESSAGE">
                  <block type="data_variable" id="var_res">
                    <field name="VARIABLE" id="v_result" variabletype="">傳回值</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
