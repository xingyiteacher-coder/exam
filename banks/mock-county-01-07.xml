<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_n">n</variable>
    <variable id="var_cand">candidate</variable>
    <variable id="var_isp">isPrime</variable>
    <variable id="var_i">i</variable>
  </variables>
  <block type="variables_set" id="init_n" x="20" y="20">
    <field name="VAR" id="var_n">n</field>
    <value name="VALUE">
      <block type="text_prompt_ext" id="prompt_n">
        <mutation type="NUMBER"></mutation>
        <field name="TYPE">NUMBER</field>
      </block>
    </value>
    <next>
      <block type="variables_set" id="init_cand">
        <field name="VAR" id="var_cand">candidate</field>
        <value name="VALUE">
          <block type="math_arithmetic" id="add1">
            <field name="OP">ADD</field>
            <value name="A"><block type="variables_get" id="gn1"><field name="VAR" id="var_n">n</field></block></value>
            <value name="B"><block type="math_number" id="num1"><field name="NUM">1</field></block></value>
          </block>
        </value>
        <next>
          <block type="variables_set" id="init_isp">
            <field name="VAR" id="var_isp">isPrime</field>
            <value name="VALUE"><block type="logic_boolean" id="f0"><field name="BOOL">FALSE</field></block></value>
            <next>
              <block type="controls_whileUntil" id="outer_while">
                <field name="MODE">UNTIL</field>
                <value name="BOOL"><block type="variables_get" id="gisp1"><field name="VAR" id="var_isp">isPrime</field></block></value>
                <statement name="DO">
                  <block type="variables_set" id="set_isp_true">
                    <field name="VAR" id="var_isp">isPrime</field>
                    <value name="VALUE"><block type="logic_boolean" id="t1"><field name="BOOL">TRUE</field></block></value>
                    <next>
                      <block type="variables_set" id="init_i">
                        <field name="VAR" id="var_i">i</field>
                        <value name="VALUE"><block type="math_number" id="num2"><field name="NUM">2</field></block></value>
                        <next>
                          <block type="controls_whileUntil" id="inner_while">
                            <field name="MODE">WHILE</field>
                            <value name="BOOL">
                              <block type="logic_operation" id="and_op">
                                <field name="OP">AND</field>
                                <value name="A">
                                  <block type="variables_get" id="gisp2"><field name="VAR" id="var_isp">isPrime</field></block>
                                </value>
                                <value name="B">
                                  <block type="logic_compare" id="cmp_i">
                                    <field name="OP">LTE</field>
                                    <value name="A">
                                      <block type="math_arithmetic" id="i_sq">
                                        <field name="OP">MULTIPLY</field>
                                        <value name="A"><block type="variables_get" id="gi1"><field name="VAR" id="var_i">i</field></block></value>
                                        <value name="B"><block type="variables_get" id="gi2"><field name="VAR" id="var_i">i</field></block></value>
                                      </block>
                                    </value>
                                    <value name="B"><block type="variables_get" id="gc1"><field name="VAR" id="var_cand">candidate</field></block></value>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO">
                              <block type="controls_if" id="if_mod">
                                <value name="IF0">
                                  <block type="logic_compare" id="cmp_mod">
                                    <field name="OP">EQ</field>
                                    <value name="A">
                                      <block type="math_modulo" id="mod">
                                        <field name="OP">MOD</field>
                                        <value name="DIVIDEND"><block type="variables_get" id="gc2"><field name="VAR" id="var_cand">candidate</field></block></value>
                                        <value name="DIVISOR"><block type="variables_get" id="gi3"><field name="VAR" id="var_i">i</field></block></value>
                                      </block>
                                    </value>
                                    <value name="B"><block type="math_number" id="num0"><field name="NUM">0</field></block></value>
                                  </block>
                                </value>
                                <statement name="DO0">
                                  <block type="variables_set" id="set_false">
                                    <field name="VAR" id="var_isp">isPrime</field>
                                    <value name="VALUE"><block type="logic_boolean" id="f1"><field name="BOOL">FALSE</field></block></value>
                                  </block>
                                </statement>
                                <next>
                                  <block type="math_change" id="inc_i">
                                    <field name="VAR" id="var_i">i</field>
                                    <value name="DELTA"><block type="math_number" id="num1_2"><field name="NUM">1</field></block></value>
                                  </block>
                                </next>
                              </block>
                            </statement>
                            <next>
                              <block type="controls_if" id="if_not_prime">
                                <value name="IF0">
                                  <block type="logic_negate" id="not_p">
                                    <value name="BOOL"><block type="variables_get" id="gisp3"><field name="VAR" id="var_isp">isPrime</field></block></value>
                                  </block>
                                </value>
                                <statement name="DO0">
                                  <block type="math_change" id="inc_cand">
                                    <field name="VAR" id="var_cand">candidate</field>
                                    <value name="DELTA"><block type="math_number" id="num1_3"><field name="NUM">1</field></block></value>
                                  </block>
                                </statement>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </statement>
                <next>
                  <block type="text_print" id="print_ans">
                    <value name="TEXT"><block type="variables_get" id="gc3"><field name="VAR" id="var_cand">candidate</field></block></value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>