<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_n">n</variable>
    <variable id="var_line">line</variable>
    <variable id="var_str_list">str_list</variable>
    <variable id="var_num_list">num_list</variable>
    <variable id="var_item">item</variable>
    <variable id="var_sorted">sorted_list</variable>
  </variables>
  <block type="variables_set" id="init_n" x="20" y="20">
    <field name="VAR" id="var_n">n</field>
    <value name="VALUE">
      <block type="text_prompt_ext" id="prompt_n">
        <mutation type="NUMBER"></mutation>
        <field name="TYPE">NUMBER</field>
      </block>
    </value>
    <next>
      <block type="variables_set" id="init_line">
        <field name="VAR" id="var_line">line</field>
        <value name="VALUE">
          <block type="text_prompt_ext" id="prompt_line">
            <mutation type="TEXT"></mutation>
            <field name="TYPE">TEXT</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="init_str_list">
            <field name="VAR" id="var_str_list">str_list</field>
            <value name="VALUE">
              <block type="lists_split" id="split_space">
                <mutation mode="SPLIT"></mutation>
                <field name="MODE">SPLIT</field>
                <value name="INPUT">
                  <block type="variables_get" id="gline"><field name="VAR" id="var_line">line</field></block>
                </value>
                <value name="DELIM">
                  <shadow type="text" id="space_delim"><field name="TEXT"> </field></shadow>
                </value>
              </block>
            </value>
            <next>
              <block type="variables_set" id="init_num_list">
                <field name="VAR" id="var_num_list">num_list</field>
                <value name="VALUE">
                  <block type="lists_create_empty" id="empty_list"></block>
                </value>
                <next>
                  <block type="controls_forEach" id="loop_convert">
                    <field name="VAR" id="var_item">item</field>
                    <value name="LIST">
                      <block type="variables_get" id="gstr_list"><field name="VAR" id="var_str_list">str_list</field></block>
                    </value>
                    <statement name="DO">
                      <block type="lists_setIndex" id="push_num">
                        <mutation at="false"></mutation>
                        <field name="MODE">INSERT</field>
                        <field name="WHERE">LAST</field>
                        <value name="LIST">
                          <block type="variables_get" id="gnum_list"><field name="VAR" id="var_num_list">num_list</field></block>
                        </value>
                        <value name="TO">
                          <block type="math_single" id="to_num">
                            <field name="OP">ABS</field>
                            <value name="NUM">
                              <block type="variables_get" id="gitem"><field name="VAR" id="var_item">item</field></block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </statement>
                    <next>
                      <block type="variables_set" id="init_sorted">
                        <field name="VAR" id="var_sorted">sorted_list</field>
                        <value name="VALUE">
                          <block type="lists_sort" id="sort_desc">
                            <field name="TYPE">NUMERIC</field>
                            <field name="DIRECTION">-1</field>
                            <value name="LIST">
                              <block type="variables_get" id="gnum_list2"><field name="VAR" id="var_num_list">num_list</field></block>
                            </value>
                          </block>
                        </value>
                        <next>
                          <block type="text_print" id="print_ans">
                            <value name="TEXT">
                              <block type="lists_split" id="join_space">
                                <mutation mode="JOIN"></mutation>
                                <field name="MODE">JOIN</field>
                                <value name="INPUT">
                                  <block type="variables_get" id="gsorted"><field name="VAR" id="var_sorted">sorted_list</field></block>
                                </value>
                                <value name="DELIM">
                                  <shadow type="text" id="space_delim2"><field name="TEXT"> </field></shadow>
                                </value>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>