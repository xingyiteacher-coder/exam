<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_a">a</variable>
    <variable id="var_b">b</variable>
    <variable id="var_x">x</variable>
    <variable id="var_y">y</variable>
    <variable id="var_temp">temp</variable>
  </variables>
  <block type="variables_set" id="init_a" x="20" y="20">
    <field name="VAR" id="var_a">a</field>
    <value name="VALUE">
      <block type="text_prompt_ext" id="prompt_a">
        <mutation type="NUMBER"></mutation>
        <field name="TYPE">NUMBER</field>
      </block>
    </value>
    <next>
      <block type="variables_set" id="init_b">
        <field name="VAR" id="var_b">b</field>
        <value name="VALUE">
          <block type="text_prompt_ext" id="prompt_b">
            <mutation type="NUMBER"></mutation>
            <field name="TYPE">NUMBER</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="set_x">
            <field name="VAR" id="var_x">x</field>
            <value name="VALUE">
              <block type="variables_get" id="get_a"><field name="VAR" id="var_a">a</field></block>
            </value>
            <next>
              <block type="variables_set" id="set_y">
                <field name="VAR" id="var_y">y</field>
                <value name="VALUE">
                  <block type="variables_get" id="get_b"><field name="VAR" id="var_b">b</field></block>
                </value>
                <next>
                  <block type="controls_whileUntil" id="while_gcd">
                    <field name="MODE">WHILE</field>
                    <value name="BOOL">
                      <block type="logic_compare" id="cmp_y">
                        <field name="OP">NEQ</field>
                        <value name="A">
                          <block type="variables_get" id="get_y2"><field name="VAR" id="var_y">y</field></block>
                        </value>
                        <value name="B">
                          <block type="math_number" id="num0"><field name="NUM">0</field></block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO">
                      <block type="variables_set" id="set_temp">
                        <field name="VAR" id="var_temp">temp</field>
                        <value name="VALUE">
                          <block type="math_modulo" id="mod_xy">
                            <field name="OP">MOD</field>
                            <value name="DIVIDEND">
                              <block type="variables_get" id="get_x2"><field name="VAR" id="var_x">x</field></block>
                            </value>
                            <value name="DIVISOR">
                              <block type="variables_get" id="get_y3"><field name="VAR" id="var_y">y</field></block>
                            </value>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="set_x_y">
                            <field name="VAR" id="var_x">x</field>
                            <value name="VALUE">
                              <block type="variables_get" id="get_y4"><field name="VAR" id="var_y">y</field></block>
                            </value>
                            <next>
                              <block type="variables_set" id="set_y_temp">
                                <field name="VAR" id="var_y">y</field>
                                <value name="VALUE">
                                  <block type="variables_get" id="get_temp"><field name="VAR" id="var_temp">temp</field></block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <block type="text_print" id="print">
                        <value name="TEXT">
                          <block type="variables_get" id="get_x_res"><field name="VAR" id="var_x">x</field></block>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>